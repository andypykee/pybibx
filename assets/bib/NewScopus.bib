@CONFERENCE{Liu20245957,
	author = {Liu, Jiapeng and Li, Weijie and Fan, Xiaochao and Deng, Wenjun and Yang, Liang and Li, Yong and Diao, Yufeng},
	title = {Giving Control Back to Models: Enabling Offensive Language Detection Models to Autonomously Identify and Mitigate Biases},
	year = {2024},
	journal = {EMNLP 2024 - 2024 Conference on Empirical Methods in Natural Language Processing, Findings of EMNLP 2024},
	pages = {5957 - 5966},
	doi = {10.18653/v1/2024.findings-emnlp.344},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217622174&doi=10.18653%2Fv1%2F2024.findings-emnlp.344&partnerID=40&md5=fea932d665a40232d8980d719c6bb5eb},
	affiliations = {Xinjiang Normal University, College of Computer Science and Technology, Urumqi, Xinjiang, China; Xinjiang University, School of Software, Urumqi, Xinjiang, China; Dalian University of Technology, School of Computer Science and Technology, Dalian, Liaoning, China; Inner Mongolia Minzu University, College of Computer Science and Technology, Inner Mongolia, China},
	abstract = {The rapid development of social media has led to an increase in online harassment and offensive speech, posing significant challenges for effective content moderation. Existing automated detection models often exhibit a bias towards predicting offensive speech based on specific vocabulary, which not only compromises model fairness but also potentially exacerbates biases against vulnerable and minority groups. Addressing these issues, we propose a bias self-awareness and data self-iteration framework for mitigating model biases. This framework aims to “giving control back to models: enabling offensive language detection models to autonomously identify and mitigate biases” through bias self-awareness algorithms and self-iterative data augmentation method. Experimental results demonstrate that the proposed framework effectively reduces the false positive rate of models in both in-distribution and out-of-distribution tests, enhances model accuracy and fairness, and shows promising performance improvements in detecting offensive speech on larger-scale datasets. © 2024 Association for Computational Linguistics.},
	keywords = {Social networking (online); Automated detection; Data augmentation; Detection models; Language detection; Minority groups; Model bias; Offensive languages; Self awareness; Social media; Vulnerable groups; Computational linguistics},
	correspondence_address = {X. Fan; College of Computer Science and Technology, Xinjiang Normal University, China; email: fxc1982@xjnu.edu.cn},
