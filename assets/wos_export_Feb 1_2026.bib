   and Fonseca, Antonio and Moro, Sergio and Guerra, Rita and Carvalho,
   Paula and Marques, Catarina and Silva, Claudia},
Editor = {Lesot, MJ and Vieira, S and Reformat, MZ and Carvalho, JP and Batista, F and Bouchon-Meunier, B and Yager, RR},
Title = {Counter Hate Speech Detection in Youtube Conversations},
