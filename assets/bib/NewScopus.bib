@ARTICLE{Fat’hAlalim2025796,
	author = {Fat’hAlalim, Ahmed and Liu, Yongjian and Xie, Qing and Alsayed, Alhag and Eldow, Musa},
	title = {Detecting Hate Speech Targeting Protected Groups in Arabic Using Hypothesis Engineering and Zero-Shot Learning with Ground Validation via ChatGPT},
	year = {2025},
	journal = {International Journal of Advanced Computer Science and Applications},
	volume = {16},
	number = {5},
	pages = {796 - 808},
	doi = {10.14569/IJACSA.2025.0160579},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105008438900&doi=10.14569%2FIJACSA.2025.0160579&partnerID=40&md5=9f87209b9a5bd025e91b38c95453da4a},
	affiliations = {Wuhan University of Technology, School of Computer Science and Artificial Intelligence, Wuhan, Hubei, China},
	abstract = {Automatic detection of hate speech in low-resource languages presents a persistent challenge in natural language processing, particularly with the rise of toxic discourse on social media platforms. Arabic, characterized by its rich morphology, dialectal variation, and limited annotated datasets, is underrepresented in hate speech research, especially regarding content targeting marginalized and protected groups. This study proposes a zero-shot learning approach that leverages Natural Language Inference (NLI) models guided by carefully engineered hypotheses in native Arabic to detect hate speech against protected groups, such as women, immigrants, Jews, Black people, transgender individuals, gay people, and people with disabilities. We formulated nine different Arabic hypothesis groups and employed a zero-shot XNLI model with a baseline embedding-based model, incorporating preprocessing techniques on the HateEval Arabic dataset. The results indicate that the XNLI model achieves up to 80% accuracy in detecting targeted hate speech, significantly outperforming baseline models. Furthermore, a real-world validation using GPT-3 via the ChatGPT interface achieved 54% accuracy in zero-shot conversational settings. These findings highlight the importance of hypothesis design and linguistic preprocessing in zero-shot hate speech detection, particularly in low-resource and culturally nuanced languages offering a scalable and culturally aware solution for moderating harmful content in Arabic online spaces. © (2025), (Science and Information Organization). All rights reserved.},
	author_keywords = {ChatGPT; Hate speech detection; low resource Arabic language, zero-shot learning; natural language processing; online safety; transfer learning},
	keywords = {E-learning; Human computer interaction; Information systems; Learning algorithms; Learning systems; Linguistics; Social networking (online); Speech analysis; Speech communication; Transfer learning; Zero-shot learning; Arabic languages; ChatGPT; Hate speech detection; Language processing; Low resource arabic language, zero-shot learning; Natural language processing; Natural languages; Online safety; Speech detection; Natural language processing systems},
	publisher = {Science and Information Organization},
	issn = {2158107X},
	language = {English},
	abbrev_source_title = {Intl. J. Adv. Comput. Sci. Appl.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
