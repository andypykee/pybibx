Title = {Text Classification for Italian Proficiency Evaluation},
Booktitle = {COMPUTATIONAL SCIENCE AND ITS APPLICATIONS - ICCSA 2019, PT I: 19TH
   INTERNATIONAL CONFERENCE, SAINT PETERSBURG, RUSSIA, JULY 1-4, 2019,
   PROCEEDINGS, PT I},
Series = {Lecture Notes in Computer Science},
