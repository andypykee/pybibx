Title = {Performance Comparison of Machine Learning and Deep Learning Algorithms
   in Detecting Online Hate Speech},
Booktitle = {INTERNATIONAL CONFERENCE ON INNOVATIVE COMPUTING AND COMMUNICATIONS,
   ICICC 2022, VOL 1},
