@CONFERENCE{Huertas-Tato2024,
	author = {Huertas-Tato, Javier and Koutlis, Christos and Papadopoulos, Symeon and Camacho, David and Kompatsiaris, Ioannis (Yiannis)},
	title = {A CLIP-based Siamese Approach for Meme Classification},
	year = {2024},
	journal = {Proceedings of the International Joint Conference on Neural Networks},
	pages = {},
	doi = {10.1109/IJCNN60899.2024.10650898},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204969362&doi=10.1109%2FIJCNN60899.2024.10650898&partnerID=40&md5=fb755e86494b0f1b2fab96b937b3ae7a},
	affiliations = {Universidad Politécnica de Madrid, Departamento de Sistemas Informáticos, Madrid, Madrid, Spain; Centre for Research and Technology-Hellas, Thessaloniki, Macedonia, Greece},
	abstract = {Memes are an increasingly prevalent element of online discourse in social networks, especially among young audiences. They carry ideas and messages that range from humorous to hateful, and are widely consumed. Their potentially high impact requires adequate means of control to moderate their use in large scale. In this work, we propose SimCLIP a deep learning-based architecture for cross-modal understanding of memes, leveraging a pre-trained CLIP encoder to produce context-aware embeddings and a Siamese fusion technique to capture the interactions between text and image. We perform an extensive experimentation on seven meme classification tasks across six datasets. We establish a new state of the art in Memotion7k with a 7.25% relative F1-score improvement, and achieve super-human performance on Harm-P with 13.73% F1-Score improvement. Our approach demonstrates the potential for compact meme classification models, enabling accurate and efficient meme monitoring. We share our code at https://github.com/jahuerta92/meme-classification-simclip. © 2024 IEEE.},
	author_keywords = {Cross-modal fusion; Hate-speech detection; Meme classification},
	keywords = {Classification (of information); Economic and social effects; Image classification; Image coding; Signal encoding; Speech recognition; Context-Aware; Cross-modal; Cross-modal fusion; Embeddings; F1 scores; Hate-speech detection; High impact; Large-scales; Meme classification; Speech detection; Deep learning},
