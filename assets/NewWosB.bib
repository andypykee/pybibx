@inproceedings{ WOS:000517789600040,
Author = {Alorainy, Wafa and Burnap, Pete and Liu, Han and Javedi, Amir and
   Williams, Matthew L.},
Book-Group-Author = {IEEE},
Title = {SUSPENDED ACCOUNTS: A SOURCE OF TWEETS WITH DISGUST AND ANGER EMOTIONS
   FOR AUGMENTING HATE SPEECH DATA SAMPLE},
Booktitle = {PROCEEDINGS OF 2018 INTERNATIONAL CONFERENCE ON MACHINE LEARNING AND
   CYBERNETICS (ICMLC), VOL 2},
Series = {International Conference on Machine Learning and Cybernetics},
Year = {2018},
