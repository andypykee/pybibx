Author = {Maity, Krishanu and Poornash, A. S. and Saha, Sriparna and Pasupa,
   Kitsuchart},
Book-Group-Author = {ACM},
Title = {ToxVI: a Multimodal LLM-based Framework for Generating Intervention in
   Toxic Code-Mixed Videos},
Booktitle = {PROCEEDINGS OF THE 33RD ACM INTERNATIONAL CONFERENCE ON INFORMATION AND
   KNOWLEDGE MANAGEMENT, CIKM 2024},
