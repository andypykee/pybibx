@ARTICLE{Xu2017341,
	author = {Xu, Xun and Gong, Shaogang and Hospedales, Timothy M.},
	title = {Zero-Shot Crowd Behavior Recognition},
	year = {2017},
	journal = {Group and Crowd Behavior for Computer Vision},
	pages = {341 - 369},
	doi = {10.1016/B978-0-12-809276-7.00018-7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85032691657&doi=10.1016%2FB978-0-12-809276-7.00018-7&partnerID=40&md5=6a2eccca6c45e9846661cdadb7f29a37},
	affiliations = {Queen Mary University of London, London, United Kingdom},
	abstract = {Understanding crowd behavior in video is challenging for computer vision. There have been increasing attempts on modeling crowded scenes by introducing ever larger property ontologies (attributes) and annotating ever larger training datasets. However, in contrast to still images, manually annotating video attributes needs to consider spatiotemporal evolution which is inherently much harder and more costly. Critically, the most interesting crowd behaviors captured in surveillance videos (e.g., street fighting, flash mobs) are either rare, thus have few examples for model training, or unseen previously. Existing crowd analysis techniques are not readily scalable to recognize novel (unseen) crowd behaviors. To address this problem, we investigate and develop methods for recognizing visual crowd behavioral attributes without any training samples, i.e., zero-shot learning crowd behavior recognition. To that end, we relax the common assumption that each individual crowd video instance is only associated with a single crowd attribute. Instead, our model learns to jointly recognize multiple crowd behavioral attributes in each video instance by exploring multiattribute cooccurrence as contextual knowledge for optimizing individual crowd attribute recognition. Joint multilabel attribute prediction in zero-shot learning is inherently nontrivial because cooccurrence statistics does not exist for unseen attributes. To solve this problem, we learn to predict cross-attribute cooccurrence from both online text corpus and multilabel annotation of videos with known attributes. Our experiments show that this approach to modeling multiattribute context not only improves zero-shot crowd behavior recognition on the WWW crowd video dataset, but also generalizes to novel behavior (violence) detection cross-domain in the Violence Flow video dataset. © 2017 Elsevier Inc. All rights reserved.},
	author_keywords = {Crowd behavior; Multilabel learning; Transfer learning; Zero-shot learning},
	keywords = {Security systems; Co-occurrence statistics; Crowd behavior; Crowd behavior recognition; Multi-label annotation; Multi-label learning; Spatiotemporal evolution; Transfer learning; Zero-shot learning; Behavioral research},
	publisher = {Elsevier Inc.},
	isbn = {9780128092767; 9780128092804},
	language = {English},
	abbrev_source_title = {Group and Crowd Behav. for Comput. Vis.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Green Accepted Open Access; Green Open Access}
}

