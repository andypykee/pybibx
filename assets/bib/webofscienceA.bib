   Rafael},
Editor = {Valencia-Garcia, R and Alcaraz-Marmol, G and DelCioppo-Morstadt, J and Vera-Lucio, N and Bucaram-Leverone, M},
Title = {Automatic Misogyny Detection with Linguistic and Morphological Features
   in Spanish},
Booktitle = {TECHNOLOGIES AND INNOVATION, CITI 2020},
