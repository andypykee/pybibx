@ARTICLE{Hossain2025,
	author = {Hossain, Md Mithun and Hossain, Md Shakil and Chaki, Sudipto and Mridha, M. F.},
	title = {Co-AttenDWG: Co-Attentive Dimension-Wise Gating and Expert Fusion for Multi-Modal Offensive Content Detection},
	year = {2025},
	journal = {IEEE Transactions on Artificial Intelligence},
	pages = {},
	doi = {10.1109/TAI.2025.3623093},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105019939017&doi=10.1109%2FTAI.2025.3623093&partnerID=40&md5=6bda20b3721308db0db6a06b0c43d94f},
	affiliations = {Bangladesh University of Business and Technology, Department of Computer Science and Engineering, Dhaka, Dhaka, Bangladesh; American International University - Bangladesh, Department of Computer Science, Dhaka, Bangladesh},
	abstract = {Multi-modal learning has emerged as a crucial research direction, as integrating textual and visual information can substantially enhance performance in tasks such as classification, retrieval, and scene understanding. Despite advances with large pre-trained models, existing approaches often suffer from insufficient cross-modal interactions and rigid fusion strategies, failing to fully harness the complementary strengths of different modalities. To address these limitations, we propose Co-AttenDWG, co-attention with dimension-wise gating, and expert fusion. Our approach first projects textual and visual features into a shared embedding space, where a dedicated co-attention mechanism enables simultaneous, fine-grained interactions between modalities. This is further strengthened by a dimension-wise gating network, which adaptively modulates feature contributions at the channel level to emphasize salient information. In parallel, dual-path encoders independently refine modality-specific representations, while an additional cross-attention layer aligns the modalities further. The resulting features are aggregated via an expert fusion module that integrates learned gating and self-attention, yielding a robust unified representation. Experimental results on the MIMIC and SemEval Memotion 1.0 datasets show that Co-AttenDWG achieves state-of-the-art performance and superior cross-modal alignment, highlighting its effectiveness for diverse multi-modal applications. © 2020 IEEE.},
	author_keywords = {Co-AttenDWG; Cross-Attention; Mixture-of-Experts; Multi-modal Learning; Offensive Content Detection},
	correspondence_address = {S. Chaki; Bangladesh University of Business and Technology, Department of Computer Science and Engineering, Dhaka, 1216, Bangladesh; email: sudiptochakibd@gmail.com; M.F. Mridha; American International University-Bangladesh, Department of Computer Science, Dhaka, 1229, Bangladesh; email: firoz.mridha@aiub.edu},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	language = {English},
	abbrev_source_title = {IEEE. Trans. Artif. Intell.},
	type = {Article},
	publication_stage = {aip},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Likha2025186633,
	author = {Likha, O. V. and Sachin Kumar, S. and Mohan, Neethu and Sikha, O. K.},
	title = {Fake News and Offensive Content Detection in Malayalam Using Machine Learning, Deep Learning, and Transformer Based Methods With XAI},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {186633 - 186664},
	doi = {10.1109/ACCESS.2025.3623172},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105019712279&doi=10.1109%2FACCESS.2025.3623172&partnerID=40&md5=ad1f5e20db518ac73937687969501790},
	affiliations = {Amrita Vishwa Vidyapeetham, Coimbatore, TN, India; Universitat Pompeu Fabra Barcelona, Department of Information and Communication Technologies, Barcelona, Barcelona, Spain},
	abstract = {Digital platforms have become one of the most powerful sources for spreading news and other information with much ease compared to traditional methods. However, this also made it easier to spread fake news and offensive content. A necessary strategy is required to detect fake news and offensive content to maintain the integrity of information and foster a safer online environment. The present study focuses on advancing the fake news and offensive content detection in Malayalam language, integrating transformer models with explainability techniques to render transparency and ensure high accuracy. We used multilingual transformer models such as mBERT, IndicBERT, XLM-RoBERTa, and MuRIL for classification tasks. Furthermore, comprehensive experiments with hyperparameter tuning are conducted on deep learning methods (CNN, LSTM, BiLSTM, GRU, BiGRU, CNN-LSTM, CNN-GRU) and traditional ML methods (SVM, LR, RF, DT, XGBoost, CATBoost, AdaBoost). The approach integrates TF-IDF and FastText embeddings for the representations, which is compared to BERT, IndicBERT, XLNet, mBERT, XLM-RoBERTa, and MuRIL. All models were evaluated using 10-fold cross-validation to ensure robustness and generalization of results. It is observed from the experiments that the XLM-RoBERTa model gave a better result with an F1 Score of 99.17% for the Fake news dataset and the mBERT model gave a better result with an F1 score of 95.95% for the offensive dataset. Furthermore, the present work utilizes explainable AI (XAI) approaches using LIME, Anchor, and Occlusion, to gain insights into the model decision making process. For the first time, an occlusion-based XAI method is proposed for fake news and offensive detection tasks. Also, the present work is the first in its kind to use Anchor and Occlusion based XAI for fake news and offensive content detection in Malayalam. The results showed that all three explainability methods occlusion, LIME and Anchor effectively captured the key words relevant for detecting both fake news and offensive content, with a high degree of overlap in the terms identified across models. This consistency demonstrates their strong adaptability and suitability for handling the complex linguistic and code-mixed characteristics of the Malayalam text. © 2013 IEEE.},
	author_keywords = {Anchor; deep learning; explainable AI; fake news detection; IndicBERT; LIME; machine learning; mBERT; MuRIL; occlusion; offensive language detection; transformer models; XLM-RoBERTa},
	keywords = {Behavioral research; Classification (of information); Computer hardware description languages; Decision making; Learning systems; Tellurium compounds; Deep learning; Explainable AI; Fake news detection; IndicBERT; Language detection; Machine-learning; MBERT; MuRIL; Occlusion; Offensive language detection; Offensive languages; Transformer modeling; XLM-RoBERTa; Anchors},
	correspondence_address = {S.S. Kumar; Amrita School of Artificial Intelligence, Amrita Vishwa Vidyapeetham, Coimbatore, 641112, India; email: s_sachinkumar@cb.amrita.edu},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	language = {English},
	abbrev_source_title = {IEEE Access},
	type = {Article},
