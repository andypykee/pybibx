@CONFERENCE{Gupta2025295,
	author = {Gupta, Siddhant and Singhal, Siddh and Wasi, Azmine Toushik},
	title = {IITR-CIOL@NLU of Devanagari Script Languages 2025: Multilingual Hate Speech Detection and Target Identification in Devanagari-Scripted Languages},
	year = {2025},
	journal = {Proceedings - International Conference on Computational Linguistics, COLING},
	pages = {295 - 300},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217754626&partnerID=40&md5=5e0b82149c54f44e35aa87c040406c3f},
	affiliations = {Indian Institute of Technology Roorkee, Roorkee, UK, India; Shahjalal University of Science and Technology, Sylhet, Bangladesh},
	abstract = {This work focuses on two subtasks related to hate speech detection and target identification in Devanagari-scripted languages, specifically Hindi, Marathi, Nepali, Bhojpuri, and Sanskrit. Subtask B involves detecting hate speech in online text, while Subtask C requires identifying the specific targets of hate speech, such as individuals, organizations, or communities. We propose the MultilingualRobertaClass model, a deep neural network built on the pretrained multilingual transformer model ia-multilingual-transliterated-roberta, optimized for classification tasks in multilingual and transliterated contexts. The model leverages contextualized embeddings to handle linguistic diversity, with a classifier head for binary classification. We received 88.40% accuracy in Subtask B and 66.11% accuracy in Subtask C, in the test set. © 2025 International Committee on Computational Linguistics.},
	keywords = {C (programming language); Computational linguistics; Speech recognition; Translation (languages); Classification tasks; Detection/identification; Embeddings; Neural-networks; Script Languages; Speech detection; Speech targets; Subtask; Target's identifications; Transformer modeling; Deep neural networks},
	editor = {Sarveswaran, K. and Thapa, S. and Shams, S. and Vaidya, A. and Bal, B.K.},
	publisher = {Association for Computational Linguistics (ACL)},
