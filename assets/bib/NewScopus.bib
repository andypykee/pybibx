	doi = {10.1007/978-3-031-58495-4_13},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85192355529&doi=10.1007%2F978-3-031-58495-4_13&partnerID=40&md5=eb4b0342adee33debfc35f5dab93db24},
	affiliations = {University of Galway, Galway, Connacht, Ireland; University of Galway, College of Science and Engineering, Galway, Connacht, Ireland; Thiagarajar College of Engineering, Madurai, TN, India; University of Kerala, Thiruvananthapuram, KL, India; The Gandhigram Rural Institute, Gandhigram, TN, India; Eastern University, Chenkalady, Sri Lanka},
	abstract = {Multilingualism has added a new dimension to the issue of abusive language detection despite the increasing number of efforts to prevent abusive content from being shared on social media. When it comes to low-resource languages such as Tamil and Telugu, the difficulty is further increased by the lack of available resources. YouTube functions as both a video-sharing platform and a social media network. YouTube allows users to establish profiles and upload videos for their followers to view, like, and comment on. Users may find it offensive and detrimental to their mental health when other users post abusive comments on videos or in response to the comments of other users. It has been observed that the language used in these comments is frequently informal and multilingual, does not always correspond to the language’s formal syntactic and lexical structure, and involves code-switching. To deal with the above issues we propose to use the multilingual pre-trained embeddings and to be more specific, our strategy can be divided into selecting suitable pre-trained models and post which adapting the models using various fine-tuning techniques to the abusive comments detection task. We use the Bidirectional Encoder Representation from Transformers (BERT) as an Encoder to generate phrase representations so that we can accurately capture the precise contextual characteristics of posts. We conduct experiments on the YouTube comments data set using various multilingual models and several fine-tuning techniques. We compared and analyzed results across the above models along with multiple classical machine learning models and found that IndicBERT and MuRIL large-cased models perform well in Tamil-English and Telugu comments data sets respectively. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2024.},
