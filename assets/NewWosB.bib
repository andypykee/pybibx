@inproceedings{ WOS:001587447700068,
Author = {Hashmi, Ehtesham and Yayilgan, Sule Yildirim and Abomhara, Mohamed and
   Akerkar, Rajendra},
Editor = {Kahraman, C and Oztaysi, B and Tolga, C and Otay, I and Cebi, S and Onar, SC and Sari, IU},
Title = {Transparent Hate Speech Detection in Norwegian Using Explainable AI},
Booktitle = {INTELLIGENT AND FUZZY SYSTEMS, INFUS 2025, VOL 2},
Series = {Lecture Notes in Networks and Systems},
Year = {2025},
Volume = {1529},
Pages = {615-623},
Note = {2025 International Conference on Intelligent and Fuzzy
   Systems-INFUS-Annual, Istanbul, TURKIYE, JUL 29-31, 2025},
Abstract = {Social networks are central to communication in the contemporary world.
   However, the anonymity afforded to users has emboldened the spread of
   online hate speech (HS) and poses a significant challenge. Online hate
   speech detection remains a formidable challenge in the digital age,
   particularly for languages with fewer computational resources like
   Norwegian. This paper presents a comprehensive study on HS detection
   utilizing transformer-based models designed for the Norwegian language,
   enhanced by hyperparameter tuning and regularization. Our investigation
   not only benchmarks the effectiveness of various models, with
   NorBERT\_base emerging as notably superior for smaller datasets but also
   integrates explainable AI techniques to unveil the model's decisions
   using LIME. This approach enhances the transparency of AI-driven content
   moderation and paves the way for future enhancements involving
   multi-lingual capabilities and advanced interpretative models.},
