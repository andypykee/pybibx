@CONFERENCE{Paavola2017734,
	author = {Paavola, Jarkko and Helo, Tuomo and Jalonen, Harri and Sartonen, Miika and Huhtinen, Aki Mauri},
	title = {May i introduce you a troll? Defining and categorizing internet behaviour commonly referred to as trolling},
	year = {2017},
	journal = {European Conference on Information Warfare and Security, ECCWS},
	volume = {0},
	pages = {734 - 740},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85027971664&partnerID=40&md5=b93f69d7794e650cd52c6d51c265f077},
	affiliations = {Turun ammattikorkeakoulu, Turku, Finland; Finnish National Defence University, Helsinki, FIN, Finland},
	abstract = {Due to the huge amount of available information, people are not always able to determine whether information is valid, and consequently tend to make hasty presumptions. This tendency is utilized by trolling, the phenomenon that has come to be equated by the media in recent years with online harassment. Because of trolling, it is becoming increasingly difficult to pinpoint where information originates and where it leads (Malgin 2015). This paper continues the work by Paavola and Jalonen (2015), and Paavola et al. (2016) which examined whether trolling behaviour could be detected with automated tools. It was concluded that automated troll detection is feasible. However, more research is required to understand trolling mechanisms in order to train algorithms accordingly. In Paavola et al. (2016), the authors found that the definitions used for trolling were not specific enough. Human communication is so diverse and contextual that in order to create automatic classification systems for trolling, a clear definition is needed. Trolling, as a means of either distracting a conversation or simply provoking an emotional answer, can utilize multiple context-based ways of influence. A positive word or sentence can, in the right context, actually be an insult. There is a lot of material available on trolling but their definitions and classifications are not comprehensive. For example, definitions based on Russian systematic trolling represent only a single phenomenon. On the other hand, definitions relying on only emotional response are not sufficient - they lack the presence of motivation to spread false information. The paper will provide a description on classifying trolls with several different criteria. They can be classified by their motivation, which can be some kind of psychological pleasure or money. Trolls can also be characterized by the technical and non-technical means that they are using in communications. The classification can be also performed by their targets and the produced impact. With clear definitions, classifications and categorizations the paper will provide means to perform accurate automated detection of trolling behaviour. This information could be further utilized to predict the future behaviour of the troll.},
	author_keywords = {Automated detection; Information warfare; Social media; Trolling},
	keywords = {Automation; Social networking (online); Automated detection; Automated tools; Automatic classification systems; Context-based; Human communications; Information warfare; Internet behaviors; Multiple contexts; Social media; Trolling; Motivation},
	editor = {Scanlon, M. and Le-Khac, N.-A.},
	publisher = {Curran Associates Inc.},
	issn = {20488602},
	isbn = {9781912764617; 9781914587405; 9781627489089; 9781910810286; 9781912764280; 9781914587702; 9781910309247; 9781911218852; 9781910810934; 9781911218432},
	language = {English},
	abbrev_source_title = {European Conf. Inf. Warfare Security, ECCWS},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Davidson2017512,
	author = {Davidson, Thomas R. and Warmsley, Dana and Macy, Michael W. and Weber, Ingmar G.},
	title = {Automated hate speech detection and the problem of offensive language},
	year = {2017},
	journal = {Proceedings of the 11th International Conference on Web and Social Media, ICWSM 2017},
	pages = {512 - 515},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85026777430&partnerID=40&md5=ad994c163581a2305060fd1c8e79b1c9},
	affiliations = {Cornell University, Department of Sociology, Ithaca, NY, United States; Cornell University, Department of Applied Mathematics, Ithaca, NY, United States; Department of Information Science, Ithaca, NY, United States; Qatar Computing Research Institute, Doha, Ad-Dawhah, Qatar},
	abstract = {A key challenge for automatic hate-speech detection on social media is the separation of hate speech from other instances of offensive language. Lexical detection methods tend to have low precision because they classify all messages containing particular terms as hate speech and previous work using supervised learning has failed to distinguish between the two categories.We used a crowd-sourced hate speech lexicon to collect tweets containing hate speech keywords. We use crowd-sourcing to label a sample of these tweets into three categories: those containing hate speech, only offensive language, and those with neither. We train a multi-class classifier to distinguish between these different categories. Close analysis of the predictions and the errors shows when we can reliably separate hate speech from other offensive language and when this differentiation is more difficult. We find that racist and homophobic tweets are more likely to be classified as hate speech but that sexist tweets are generally classified as offensive. Tweets without explicit hate keywords are also more difficult to classify. © Copyright 2017, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
	keywords = {Social networking (online); Speech; Detection methods; Multi-class classifier; Offensive languages; Social media; Speech detection; Three categories; Speech recognition},
	publisher = {AAAI Press},
	isbn = {9781577357889},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Web Soc. Media, ICWSM},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2079}
}

