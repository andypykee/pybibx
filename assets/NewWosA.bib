@inproceedings{ WOS:000719253600055,
Author = {Awal, Md Rabiul and Cao, Rui and Lee, Roy Ka-Wei and Mitrovic, Sandra},
Editor = {Karlapalem, K and Cheng, H and Ramakrishnan, N and Agrawal, RK and Reddy, PK and Srivastava, J and Chakraborty, T},
Title = {AngryBERT: Joint Learning Target and Emotion for Hate Speech Detection},
Booktitle = {ADVANCES IN KNOWLEDGE DISCOVERY AND DATA MINING, PAKDD 2021, PT I},
