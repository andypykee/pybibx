	doi = {10.1109/IMSA65733.2025.11166959},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105018451399&doi=10.1109%2FIMSA65733.2025.11166959&partnerID=40&md5=db95990c37a505c3c6fb83a600c1f7d5},
	affiliations = {Faculty of Computer Science, 6th October, Giza, Egypt; Faculty of Computer and Information, Beni Suef, Beni Suef, Egypt},
	abstract = {Social media hate speech poses significant challenges to online communities and platform governance, necessitating efficient automated detection methods. This paper presents a comprehensive comparative study of two alternative models for hate speech classification - a recurrent neural network based on LSTM and a transformer-based RoBERTa model - trained and tested on the publicly available HateXplain dataset. The LSTM model attained a macro-averaged F<inf>1</inf> score of 0.85 (weighted F<inf>1</inf> of 0.89), demonstrating competitive performance with reduced computational overhead. The RoBERTa model achieved a macro-averaged F<inf>1</inf> score of 0.9211, indicating superior classification capacity. Both approaches are evaluated using accuracy, precision, recall, and F<inf>1</inf> metrics, and compared in terms of training time and parameter efficiency. These findings illuminate the trade-offs between model complexity and performance, providing practical guidance for selecting appropriate architectures in large-scale hate speech detection systems. © 2025 IEEE.},
	author_keywords = {Comparative Study; Hate Speech Detection; LSTM; Natural Language Processing; RoBERTa},
	keywords = {Cost effectiveness; Efficiency; Natural language processing systems; Online systems; Social networking (online); Speech analysis; Speech communication; Comparative analyzes; Comparatives studies; Hate speech detection; Language processing; LSTM; Natural language processing; Natural languages; RoBERTa; Social media; Speech detection; Economic and social effects},
