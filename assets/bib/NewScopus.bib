	title = {Hate speech recognition in multilingual text: hinglish documents},
	year = {2023},
	journal = {International Journal of Information Technology (Singapore)},
	volume = {15},
	number = {3},
	pages = {1319 - 1331},
	doi = {10.1007/s41870-023-01211-z},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85149826214&doi=10.1007%2Fs41870-023-01211-z&partnerID=40&md5=233382e54f44f215707382ddd8ce288a},
	affiliations = {National Institute of Technology Hamirpur, Department of Computer Science and Engineering, Hamirpur, HP, India; Indira Gandhi National Open University, School of Information and Computer Science, New Delhi, India},
	abstract = {The Internet is a boon for mankind but its misuse has been increasing drastically. Social networking platforms such as Facebook, Twitter and Instagram play a predominant role in expressing views by the users. Sometimes users wield abusive or inflammatory language, that may provoke readers. This paper aims to evaluate various machine learning and deep learning techniques to detect hate speech on various social media platforms in the Hinglish (English-Hindi code-mix) language. In this paper, we apply and evaluate several machine learning and deep learning methods, along with various feature extraction and word-embedding techniques, on a consolidated dataset of 20600 instances, for hate speech detection from tweets and comments in Hinglish. The experimental results reveal that deep learning models perform better than machine learning models in general. Among the deep learning models, the CNN-BiLSTM model with word2vec word embedding provides the best results. The model yields 0.876 accuracy, 0.830 precision, 0.840 recall and 0.835 F1-score. These results surpass the recent state-of-art approaches. © 2023, The Author(s), under exclusive licence to Bharati Vidyapeeth's Institute of Computer Applications and Management.},
	author_keywords = {BiLSTM; CNN; Deep learning; Hate speech; Machine learning; Word2Vec},
	correspondence_address = {D. Yadav; School of Computer and Information Sciences, Indira Gandhi National Open University, Delhi, India; email: dsy99@rediffmail.com},
