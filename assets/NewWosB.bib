@inproceedings{ WOS:001180194400039,
Author = {Zhang, Peng and Lei, Weimin and Zhao, Xinlei and Dong, Lijia and Lin,
   Zhaonan},
Book-Group-Author = {Assoc Computing Machinery},
Title = {RTVD-Net: An real-time violence detection method based on pre-training
   of human skeleton images},
Booktitle = {PROCEEDINGS OF 2023 THE 12TH INTERNATIONAL CONFERENCE ON NETWORKS,
   COMMUNICATION AND COMPUTING, ICNCC 2023},
Year = {2023},
Pages = {260-266},
Note = {12th International Conference on Networks, Communication and Computing
   (ICNCC), Osaka, JAPAN, DEC 15-17, 2023},
Abstract = {Video violence detection has received increasing attention in recent
   years. Identifying violent behavior can effectively combat criminal
   behavior and prevent public safety in monitoring places. In this paper,
   we propose a real-time violence detection network, called RTVD-Net.
   Firstly, we introduce the lightweight pose estimator YOLO-Pose into
   violence detection tasks and proposes a pre-training method based on
   YOLO-Pose to extract human skeleton features. Secondly, The 2DCNN
   model(ACTION-Net) was used to classify violent behavior in videos. We
   propose a Weight selection module that takes the parameters generated
   from bone data as a weight coefficient, and a Keyframe Weight Assignment
   that connects bone information with RGB features to generate the final
   detection results. The method proposed in this article was
   comprehensively experimented and ablated on the Hockey Fights dataset
   and RWF2000 dataset. The experimental results showed that the accuracy
   of RTVD-Net was superior to the most advanced methods before, and the
   speed could reach 33 fps, enabling real-time detection of violent
   behavior. In addition, RTVD-Net can also perform well in violent
   behavior in multi person scenarios.},
Publisher = {ASSOC COMPUTING MACHINERY},
Address = {1601 Broadway, 10th Floor, NEW YORK, NY, UNITED STATES},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Lei, WM (Corresponding Author), Northeastern Univ, Shenyang, Liaoning, Peoples R China.
   Zhang, Peng; Lei, Weimin; Lin, Zhaonan, Northeastern Univ, Shenyang, Liaoning, Peoples R China.
   Zhao, Xinlei; Dong, Lijia, Shenyang Er Yi San Elect Technol Co Ltd, Shenyang, Liaoning, Peoples R China.},
DOI = {10.1145/3638837.3638878},
ISBN = {979-8-4007-0926-5},
Keywords = {Video violence detection; deep learning; Violence recognition; Video
