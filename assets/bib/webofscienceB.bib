   Villasenor-Pineda, Luis},
Editor = {Mora, KMF and Marin, JA and Cerda, J and Carrasco-Ochoa, JA and Martinez-Trinidad, JF and Olvera-Lopez, JA},
Title = {Not All Swear Words Are Used Equal: Attention over Word n-grams for
   Abusive Language Identification},
Booktitle = {PATTERN RECOGNITION (MCPR 2020)},
Series = {Lecture Notes in Computer Science},
Year = {2020},
Volume = {12088},
