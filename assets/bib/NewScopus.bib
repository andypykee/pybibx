@CONFERENCE{Lin2022115,
	author = {Lin, Weicheng and Emmanouilidou, DImitra},
	title = {Toxic Speech and Speech Emotions: Investigations of Audio-based Modeling and Intercorrelations},
	year = {2022},
	journal = {European Signal Processing Conference},
	volume = {2022-August},
	pages = {115 - 119},
	doi = {10.23919/eusipco55093.2022.9909856},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85141011265&doi=10.23919%2Feusipco55093.2022.9909856&partnerID=40&md5=624577ee224ed81ba97964c101543ed0},
	affiliations = {Erik Jonsson School of Engineering and Computer Science, Richardson, TX, United States; Microsoft Research, Audio and Acoustics Research Group, Redmond, WA, United States},
	abstract = {Content moderation (CM) systems have become essential following the monumental increase in multimodal and online social platforms; and while increasingly published work focuses on text-based solutions, there is still limited work on audio-based methods. In this study we aim to explore relationships between speech emotions and toxic speech, as part of a CM scenario. We first investigate an appropriate framework for combining speech emotion recognition (SER) and audio-based CM models. We then investigate which emotional aspects (i.e., attribute, sentiment, or attitude) could contribute the most in facilitating audio-based CM recognition platforms. Our experimental results indicate that conventional shared feature encoder approaches may fail to capture additional discriminative features for boosting audio-based CM tasks while utilizing SER learning. We further investigate performance trade-offs of late-fusion frameworks for combining SER and CM information. We argue that these observations could be attributed to an emotionally-biased distribution in the CM scenario, concluding that SER could in deed play a role in content moderation frameworks, given added application-specific emotional information. © 2022 European Signal Processing Conference, EUSIPCO. All rights reserved.},
	author_keywords = {audio-based content moderation; sentiment detection; speech emotion recognition; toxic language detection},
	keywords = {Audio systems; Emotion Recognition; Modeling languages; Online systems; Signal processing; Speech recognition; Audio-based; Audio-based content moderation; Based modelling; Intercorrelation; Language detection; Multi-modal; Sentiment detection; Speech emotion recognition; Speech emotions; Toxic language detection; Economic and social effects},
