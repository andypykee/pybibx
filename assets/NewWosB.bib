@inproceedings{ WOS:000995489700026,
Author = {Bourgeade, Tom and Chiril, Patricia and Benamara, Farah and Moriceau,
   Veronique},
Editor = {Kamps, J and Goeuriot, L and Crestani, F and Maistro, M and Joho, H and Davis, B and Gurrin, C and Kruschwitz, U and Caputo, A},
Title = {Topic Refinement in Multi-level Hate Speech Detection},
Booktitle = {ADVANCES IN INFORMATION RETRIEVAL, ECIR 2023, PT II},
