	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105018075859&doi=10.1109%2FASSIC64892.2025.11158561&partnerID=40&md5=55a8e16922d883bbe15551442181fef3},
	affiliations = {MIT Art, Design and Technology University, Department of CSE, Pune, MH, India; Kakatiya Institute of Technology & Science, Hanamkonda, TS, India; Siksha O Anusandhan (Deemed to be University), Department of CSE, Bhubaneswar, OR, India; Applied Science Private University, Applied Science Research Center, Amman, Jordan},
	abstract = {People exchanging text, photographs, videos, and hyperlinks on microblogging sites like Twitter, Instagram, Facebook, etc., has become a new normal in today's internet-enabled modern society. The data generated in posts, reviews, tweets, comments, etc., is instrumental in knowing public perception towards a wide range of subjects like products, services, marketing, films, events, etc. It is also helpful in studying public views, opinions, and concerns in different fields like economics, business, politics, and education. With the fast-growing following of social media, it is evident that expressions of hate speech in public on social media platforms can diversely affect the social environment by triggering anger, violence, and crime in society. Lynchings are an obvious indication of the recent dramatic increase in hate speech-related crimes in India. Hence, all social media websites need to control the propagation of hate speech online. In this paper, a new hybrid deep learning architecture combines Convolutional Neural Networks (CNN), Long-Short-Term Memory (LSTM), and an attention mechanism to improve both classification accuracy and context understanding. The model addresses cross-lingual sentiment and semantic variation through the utilization of multilingual Word2Vec and BERT embeddings. The results validate the effectiveness of the proposed architecture in detecting nuanced and implicit hate speech content in multilingual settings. © 2025 IEEE.},
