Title = {Anomalous Speech Detection: Unleashing the Adaptive Power of
   VarietyDetect for Enhanced Short-Text Anomaly Detection through
   Transfer Learning and Self-Training},
Booktitle = {2024 IEEE/WIC INTERNATIONAL CONFERENCE ON WEB INTELLIGENCE AND
   INTELLIGENT AGENT TECHNOLOGY, WI-IAT},
Year = {2024},
