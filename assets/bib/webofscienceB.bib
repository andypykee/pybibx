   Dhuri, Kanchan Ganesh, K J Somaiya Inst Technol, Dept Informat Technol, Mumbai 400022, Maharashtra, India.
   Dhuri, Kanchan Ganesh, VIT, Dept Informat Technol, Mumbai 400037, Maharashtra, India.
   Patil, Sunita, NMIMS Deemed Be Univ, Shirpur Campus, Dhule 425405, Maharashtra, India.},
DOI = {10.1016/j.compeleceng.2025.110651},
