@CONFERENCE{Sookarah2022,
	author = {Sookarah, Doorgesh and Ramwodin, Loovesh S.},
	title = {Combatting online harassment by using transformer language models for the detection of emotions, hate speech and offensive language on social media},
	year = {2022},
	journal = {ELECOM 2022 - Proceedings of the 2022 4th IEEE International Conference on Emerging Trends in Electrical, Electronic and Communications Engineering},
	pages = {},
	doi = {10.1109/ELECOM54934.2022.9965237},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85143991334&doi=10.1109%2FELECOM54934.2022.9965237&partnerID=40&md5=475a5f79483d9e22ef7fee7abf9543f2},
	affiliations = {University of Technology, Mauritius, School of Innovative Technologies and Engineering, Port Louis, Port Louis, Mauritius},
	abstract = {In these contemporary times, social media is omnipresent and most people adhere to at least one of these digital platforms. Social entertainment generates an enormous amount of data and this is an unparalleled opportunity for data scientists and linguistic experts. These factors have renewed the interest in Natural Language Processing techniques and as such, there is a continuous increase in the number of publications that deal with the topic of Tweet classification using machine learning models. In this paper, experiments performed by the TweetEval team from the University of Cardiff have been studied and expanded upon. These tasks include emotion detection, offensive language identification and hate speech detection. The decision was made to focus on these specific classification tasks as they directly relate to unsought behaviours such as online harassment. This research endeavour involved building and testing a transformer-based language model which is capable of matching the performance of TweetEval. The aim of this study is therefore to identify common limitations to such models and how these can be circumvented to effectively combat phenomenon such as cyberbullying and online abuse using machine learning. From the results that were obtained, the developed BERT model performed comparatively well to other similar algorithms for all tasks as the obtained results were an F1-Score of 0.51, 0.76 and 0.80 for hate speech, emotion detection and offensive language respectively. © 2022 IEEE.},
	author_keywords = {BERT; emotion detection; hate speech; Natural language processing; offensive language; transformers; tweet classification},
	keywords = {Computational linguistics; Electric transformer testing; Emotion Recognition; Learning algorithms; Machine learning; Social networking (online); Speech recognition; BERT; Emotion detection; Hate speech; Language model; Language processing; Natural language processing; Natural languages; Offensive languages; Transformer; Tweet classification; Classification (of information)},
