	journal = {2024 IEEE International Conference on Metrology for eXtended Reality, Artificial Intelligence and Neural Engineering, MetroXRAINE 2024 - Proceedings},
	pages = {493 - 498},
	doi = {10.1109/MetroXRAINE62247.2024.10797071},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216092205&doi=10.1109%2FMetroXRAINE62247.2024.10797071&partnerID=40&md5=777cdfef3284ed65cb65e9391afa7199},
	affiliations = {Università degli Studi del Molise, Department of Medicine and Health Sciences, Campobasso, CB, Italy; Università degli Studi del Sannio, Department of Engineering, Benevento, BN, Italy},
	abstract = {Cyberbullying has emerged as a pervasive and detrimental phenomenon and refers to the use of digital communication tools, such as social media, to harass, intimidate, or harm others. This phenomenon, coupled with the anonymity afforded by online platforms, can induces negative psychological impacts, such as heightened levels of stress, anxiety, depression, and feelings of loneliness and isolation. Therefore, the development of targeted interventions to detect offensive contents is imperative for mitigation of the harmful effects of cyberbullying and for understanding the interplay between cyberbullying and mental health. This study aimed to develop an automatic methodology capable to discriminate offensive tweets. The contents are divided in two groups: 'non-offensive' and 'offensive'. Two different Feature Extraction techniques, six Machine Learning (ML) classifiers and two validation strategies were employed in this study. Great results in terms of Accuracy and Area under the Receiver operating curve (AUCROC) were obtained. The best ML algorithm was Gradient Boosting Tree, reaching an Accuracy and AUCROC equal to 0.968 and 0.986, respectively, when TF-IDF (Unigram) feature extraction is applied with Ten-Fold cross validation. However, the simple binary classification limited the study. Future investigation, including examination of new scenarios like multi-class classification, could confirm the potential of the proposed methodology. © 2024 IEEE.},
	author_keywords = {Cyberbullying; Machine Learning; mental health; offensive contents; Twitter},
	keywords = {Adversarial machine learning; Anonymity; Contrastive Learning; Federated learning; Communication tools; Cyber bullying; Digital communications; Learning-based approach; Machine-learning; Mental health; Offensive content; Online platforms; Receiver operating curves; Social media; Tweets},
