@article{ WOS:001617982400001,
Author = {Huang, Qingbao and Li, Pijian and Wang, Wenzhi and Zhang, Xingmao and
   Chen, Shizhen and Cheng, Haonan and Liu, Zhiyue},
Title = {Knowledge-enhanced Chinese multimodal hate speech detection},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2026},
Volume = {299},
Number = {D},
Month = {MAR 1},
Abstract = {Hate speech has become one of the malignant tumors threatening social
   media platforms. Multimodal hate speech detection aims to ascertain
   whether a given image with the corresponding text conveys hate, which
   has emerged as a focal point of research within the scholarly community.
   Although multimodal hate speech detection has made significant progress
   in English, the hate detection models cannot perform well in Chinese
   scenarios due to the difference of culture and linguistic structures
   between Chinese and English. To fill these gaps, we propose the task of
   Chinese multimodal hate speech detection, which requires models to
   deeply understand hate expression forms in the context of Chinese and
   the interplay between texts and images. To support the research on
   Chinese multimodal hate speech detection, we construct a Chinese
   multimodal hate speech dataset called CMMHS, which contains 8122 images
   and Weibo texts. We propose a knowledge-enhanced multimodal model named
   KMTCH as a baseline, which leverages Large Language Models (LLMs) to
   extract background information for hate detection in text and utilizes
   CLIP to bridge the gap between visual and text modality. Additionally,
   for enhancing the capability that model recognizes Chinese hate terms,
   we incorporate a Chinese hate lexicon as external knowledge to embed
   text features. Experimental results on multiple evaluation metrics
   demonstrate the superiority of our model.},
