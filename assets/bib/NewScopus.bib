@CONFERENCE{Almohaimeed20254677,
	author = {Almohaimeed, Saad and Almohaimeed, Saleh and Turgut, Damla and Bölöni, Ladislau L.},
	title = {Closest Positive Cluster Loss: Improving the Generalization of Implicit Hate Speech Classifiers Across Social Media Datasets},
	year = {2025},
	journal = {IEEE International Conference on Communications},
	pages = {4677 - 4682},
	doi = {10.1109/ICC52391.2025.11161273},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105018472933&doi=10.1109%2FICC52391.2025.11161273&partnerID=40&md5=27ffd7dbeeb599267adab0e8f158bad3},
	affiliations = {College of Engineering and Computer Science, Orlando, FL, United States},
	abstract = {Flagging hate speech on social media messages has important societal benefits. While large language models have become increasingly able to identify hate speech with high accuracy, they come with a significant computational cost. Thus, there is a need for simpler models that detect hateful or abusive content by classifying an embedding of the text. Such models perform very well for explicitly abusive content, but struggle with the classification of implicit hate. Furthermore, it has been found that the performance decreases significantly in cross-dataset experiments. In this paper, we propose Closest Positive Cluster (CPC) an auxiliary loss that increases the generalizability of embedding-based explicit and implicit hate classifiers in crossdataset scenarios. Through experiments spanning ten different hate speech datasets, we found that the CPC loss increased the model performance by 0.17 - 7.4% when added to the binary crossentropy loss during training. The experiments also investigated whether models trained on specific hate speech datasets generalize better to other datasets. © 2025 IEEE.},
	keywords = {Classification (of information); Signal processing; Social networking (online); Speech communication; Computational costs; Embeddings; Generalisation; High-accuracy; Language model; Modeling performance; Performance; Simple modeling; Social media; Societal benefits},
	editor = {Valenti, M. and Reed, D. and Torres, M.},
