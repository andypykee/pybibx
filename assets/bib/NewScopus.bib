}

@CONFERENCE{Lee2024266,
	author = {Lee, Dong-ho and Cho, Hyundong J. and Jin, Woojeong and Moon, Jihyung and Park, Sungjoon and Röttger, Paul and Pujara, Jay and Lee, Roy Ka Wei},
	title = {Improving Covert Toxicity Detection by Retrieving and Generating References},
	year = {2024},
	journal = {NAACL 2024 - 8th Workshop on Online Abuse and Harms, WOAH 2024, Proceedings of the Workshop},
	pages = {266 - 274},
	doi = {10.18653/v1/2024.woah-1.21},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001848851&doi=10.18653%2Fv1%2F2024.woah-1.21&partnerID=40&md5=a6955017d6a1a80e63ec7b951e80b3cf},
	affiliations = {VinAI Research, Seoul, Seoul, South Korea; University of Southern California, Los Angeles, CA, United States; Università Bocconi, Milan, Italy; Singapore University of Technology and Design, Singapore City, Singapore},
	abstract = {Models for detecting toxic content play an important role in keeping people safe online. There has been much progress in detecting overt toxicity. Covert toxicity, however, remains a challenge because its detection requires an understanding of implicit meaning and subtle connotations. In this paper, we explore the potential of leveraging references, such as external knowledge and textual interpretations, to enhance the detection of covert toxicity. We run experiments on two covert toxicity datasets with two types of references: 1) information retrieved from a search API, and 2) interpretations generated by large language models. We find that both types of references improve detection, with the latter being more useful than the former. We also find that generating interpretations grounded on properties of covert toxicity, such as humor and irony, lead to the largest improvements<sup>1</sup>. © 2024 Association for Computational Linguistics.},
	keywords = {Modeling languages; External knowledge; Language model; Property; Search API; Toxicity detection; Computational linguistics},
	editor = {Chung, Y.-L. and Talat, Z. and Nozza, D. and Plaza-del-Arco, F.M. and Rottger, P. and Davani, A.M. and Calabrese, A.},
	publisher = {Association for Computational Linguistics (ACL)},
	isbn = {9798891761056},
	language = {English},
	abbrev_source_title = {NAACL - Workshop Online Abuse Harms, WOAH , Proc. Workshop},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5; All Open Access; Gold Open Access}
}

