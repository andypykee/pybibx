@inproceedings{ WOS:000694721300001,
Author = {Singh, Sumer and Li, Sheng},
Book-Group-Author = {Assoc Computat Linguist},
Title = {Exploiting Auxiliary Data for Offensive Language Detection with
   Bidirectional Transformers},
Booktitle = {WOAH 2021: THE 5TH WORKSHOP ON ONLINE ABUSE AND HARMS},
Year = {2021},
Pages = {1-5},
Note = {5th Workshop on Structured Prediction for NLP (SPNLP) / 5th Workshop on
   Online Abuse and Harms (WOAH), ELECTR NETWORK, AUG 06, 2021},
Organization = {Assoc Computat Linguist},
Abstract = {Offensive language detection (OLD) has received increasing attention due
   to its societal impact. Recent work shows that bidirectional transformer
   based methods obtain impressive performance on OLD. However, such
   methods usually rely on large-scale well-labeled OLD datasets for model
   training. To address the issue of data/label scarcity in OLD, in this
   paper, we propose a simple yet effective domain adaptation approach to
   train bidirectional transformers. Our approach introduces domain
   adaptation (DA) training procedures to ALBERT, such that it can
   effectively exploit auxiliary data from source domains to improve the
   OLD performance in a target domain. Experimental results on benchmark
   datasets show that our approach, ALBERT (DA), obtains the
   state-of-the-art performance in most cases. Particularly, our approach
   significantly benefits underrepresented and under-performing classes,
   with a significant improvement over ALBERT.},
Publisher = {ASSOC COMPUTATIONAL LINGUISTICS-ACL},
Address = {209 N EIGHTH STREET, STROUDSBURG, PA 18360 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Singh, S (Corresponding Author), Univ Georgia, Athens, GA 30602 USA.
   Singh, Sumer; Li, Sheng, Univ Georgia, Athens, GA 30602 USA.},
