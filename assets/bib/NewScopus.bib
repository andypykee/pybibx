	affiliations = {Rayalaseema University, Department of Electronics and Communication Engineering, Kurnool, AP, India; Gandhi Institute of Technology and Management (GITAM), Department of Electronics and Communication Engineering, Visakhapatnam, AP, India; Jawaharlal Nehru Technological University Hyderabad, Department of Electronics and Communication Engineering, Hyderabad, TS, India},
