}

@CONFERENCE{Ranasinghe20233910,
	author = {Ranasinghe, Tharindu and Zampieri, Marcos},
	title = {Teacher and Student Models of Offensive Language in Social Media},
	year = {2023},
	journal = {Proceedings of the Annual Meeting of the Association for Computational Linguistics},
	pages = {3910 - 3922},
	doi = {10.18653/v1/2023.findings-acl.241},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85175485949&doi=10.18653%2Fv1%2F2023.findings-acl.241&partnerID=40&md5=d9df45800890e1e70bc5a74fc715235a},
	affiliations = {Aston University, Birmingham, West Midlands, United Kingdom; George Mason University, Fairfax, VA, United States},
	abstract = {State-of-the-art approaches to identifying offensive language online make use of large pre-trained transformer models. However, the inference time, disk, and memory requirements of these transformer models present challenges for their wide usage in the real world. Even the distilled transformer models remain prohibitively large for many usage scenarios. To cope with these challenges, in this paper, we propose transferring knowledge from transformer models to much smaller neural models to make predictions at the token- and at the post-level. We show that this approach leads to lightweight offensive language identification models that perform on par with large transformers but with 100 times fewer parameters and much less memory usage. © 2023 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Memory requirements; Offensive languages; Real-world; Social media; State-of-the-art approach; Student Modeling; Teacher models; Time requirements; Transformer modeling; Usage scenarios; Social networking (online)},
