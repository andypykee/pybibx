	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105009894321&doi=10.1109%2FICCT-Pacific63901.2025.11012788&partnerID=40&md5=04e0056e5809c4a9b9699ea60d3a855d},
	affiliations = {National Formosa University Taiwan, Program in Smart Industry Technology Research and Development, Yunlin, Taiwan; National Yunlin University of Science and Technology, Department of Electronics Engineering, Douliou, Yunlin, Taiwan; National Formosa University Taiwan, Department of Electrical Engineering, Yunlin, Taiwan; National Formosa University Taiwan, Department of Electrical Engineering, Yunlin, Taiwan; National Formosa University Taiwan, Dept. Automation Engineering & Smart, Yunlin, Taiwan},
	abstract = {As bullying rapidly spreads in schools, many parents are becoming increasingly concerned about their children being subjected to bullying by peers, which could negatively impact their physical and mental health. This paper proposes an abusive language detection system that combines Mel-frequency Cepstrum Coefficients (MFCC) speech features with a Convolutional Neural Network (CNN). Audio files which contain daily abusive phrases in the Minnan dialect are initially preprocesses to eliminate non-speech interference. Subsequently, the MFCC algorithm is applied to extract speech features that closely capture auditory characteristics. The CNN classification model is trained to learn the MFCC features and classify the phrases into their respective categories. Experimental results indicate that the CNN model achieves an average recognition accuracy of 91.9%. Finally, the CNN model was deployed on an embedded platform, where it achieves an average recognition time of 0.54 seconds per phrase and an average recognition accuracy of 86.25%. © 2025 IEEE.},
