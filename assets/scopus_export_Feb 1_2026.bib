	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016308374&doi=10.1109%2FACCESS65134.2025.11135879&partnerID=40&md5=b76f25670641e2ff17a13fc96a232dc3},
	affiliations = {East West University, Dept. of Cse, Dhaka, Bangladesh; City University, Department of Cse, Dhaka, Bangladesh; Jahangirnagar University, Department of Statistics and Data Science, Dhaka, Bangladesh; Mamun University, Department of General Professional Subjects, Khiva, Xorazm, Uzbekistan; Urgench State University, Department of Methodology of Primary Education, Urganch, Khorezm, Uzbekistan},
	abstract = {In languages like Bengali, where automatic moderation systems are still in their infancy, the rise of hate speech has become an increasingly pressing matter as social media continues to influence digital communication. The process of detecting hate speech is difficult due to the intricacy of the Bengali script and the lack of high-quality annotated datasets. In this work, we provide a deep learning-based method that uses the Bangla BERT model to precisely detect and categorize hate speech in Bengali literature. To increase model robustness, we employ a comprehensive text preparation approach that includes tokenization, normalization, and management of informal linguistic variations. We explore the effects of important hyperparameters, such as batch size, number of epochs, and learning rate, on model performance by optimizing BanglaBERT on a carefully selected dataset. According to experimental data, our transformer-based model achieves a higher accuracy of 93.21%, recall of 92.11%, precision of 92.82% and F1-score of 92.46%, outperforming conventional machine learning classifiers by a wide margin. Additionally, we thoroughly examine the model's generalizability across various hate speech types, emphasizing the significance of contextual awareness in Bengali natural language processing (NLP). The knowledge gathered from this study aids in the continuous creation of efficient hate speech detection systems that can support real-time content moderation and provide a more secure and welcoming online space for Bengali-speaking groups. © 2025 IEEE.},
