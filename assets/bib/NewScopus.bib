	author = {Bertaglia, Thales Felipe Costa and Grigoriu, Andreea and Dumontier, Michel and van Dijck, Gijs},
	title = {Abusive Language on Social Media Through the Legal Looking Glass},
	year = {2021},
	journal = {WOAH 2021 - 5th Workshop on Online Abuse and Harms, Proceedings of the Workshop},
