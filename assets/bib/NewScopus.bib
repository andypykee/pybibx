	author = {Aljohani, Ebtesam Jaber and Yafooz, Wael M.S.},
	title = {Enhanced Arabic-language cyberbullying detection: deep embedding and transformer (BERT) approaches},
	year = {2025},
	journal = {IAES International Journal of Artificial Intelligence},
