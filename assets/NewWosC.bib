Title = {Time Series Based Trend Analysis for Hate Speech in Twitter During COVID
   19 Pandemic},
Booktitle = {2020 20TH INTERNATIONAL CONFERENCE ON ADVANCES IN ICT FOR EMERGING
   REGIONS (ICTER-2020)},
