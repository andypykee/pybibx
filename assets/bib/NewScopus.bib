@CONFERENCE{Juyal2024,
	author = {Juyal, Prachi},
	title = {Deep Learning Approaches for Effective Hate Speech Classification},
	year = {2024},
	journal = {2024 International Conference on Electrical, Electronics and Computing Technologies, ICEECT 2024},
	pages = {},
	doi = {10.1109/ICEECT61758.2024.10739035},
