	keywords = {Computer crime; Deep learning; Extraction; Learning algorithms; Learning systems; Natural language processing systems; Social networking (online); Speech communication; Speech recognition; Bi-LSTM; Count vectorizer; Embeddings; Fasttext embedding; Hate speech; Language processing; Natural language processing; Natural languages; Tokenization; Vectorizer; Semantics},
