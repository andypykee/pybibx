@inproceedings{ WOS:001155257400001,
Author = {Alfarano, Andrea and De Magistris, Giorgio and Mongelli, Leonardo and
   Russo, Samuele and Starczewski, Janusz and Napoli, Christian},
Editor = {Rutkowski, L and Scherer, R and Korytkowski, M and Pedrycz, W and Tadeusiewicz, R and Zurada, JM},
Title = {A Novel ConvMixer Transformer Based Architecture for Violent Behavior
   Detection},
Booktitle = {ARTIFICIAL INTELLIGENCE AND SOFT COMPUTING, ICAISC 2023, PT II},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2023},
Volume = {14126},
