@CONFERENCE{Chang20194743,
	author = {Chang, Jonathan P. and Danescu-Niculescu-Mizil, Cristian},
	title = {Trouble on the horizon: Forecasting the derailment of online conversations as they develop},
	year = {2019},
	journal = {EMNLP-IJCNLP 2019 - 2019 Conference on Empirical Methods in Natural Language Processing and 9th International Joint Conference on Natural Language Processing, Proceedings of the Conference},
	pages = {4743 - 4754},
	doi = {10.18653/v1/D19-1481},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084321030&doi=10.18653%2Fv1%2FD19-1481&partnerID=40&md5=d451dfbf38332dbeb6d0435488683a82},
	affiliations = {Cornell University, Ithaca, NY, United States},
	abstract = {Online discussions often derail into toxic exchanges between participants. Recent efforts mostly focused on detecting antisocial behavior after the fact, by analyzing single comments in isolation. To provide more timely notice to human moderators, a system needs to preemptively detect that a conversation is heading towards derailment before it actually turns toxic. This means modeling derailment as an emerging property of a conversation rather than as an isolated utterance-level event. Forecasting emerging conversational properties, however, poses several inherent modeling challenges. First, since conversations are dynamic, a forecasting model needs to capture the flow of the discussion, rather than properties of individual comments. Second, real conversations have an unknown horizon: they can end or derail at any time; thus a practical forecasting model needs to assess the risk in an online fashion, as the conversation develops. In this work we introduce a conversational forecasting model that learns an unsupervised representation of conversational dynamics and exploits it to predict future derailment as the conversation develops. By applying this model to two new diverse datasets of online conversations with labels for antisocial events, we show that it outperforms state-of-the-art systems at forecasting derailment. © 2019 Association for Computational Linguistics},
	keywords = {Computational linguistics; Online systems; Risk assessment; Social networking (online); After-the-fact; Antisocial behavior; Forecasting models; Learn+; On-line fashion; Online discussions; Property; State-of-the-art system; Forecasting},
	publisher = {Association for Computational Linguistics},
	isbn = {9781950737901},
	language = {English},
	abbrev_source_title = {EMNLP-IJCNLP - Conf. Empir. Methods Nat. Lang. Process. Int. Jt. Conf. Nat. Lang. Process., Proc. Conf.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 43; All Open Access; Gold Open Access}
}

