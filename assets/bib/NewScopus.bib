	language = {English},
	abbrev_source_title = {SIGDIAL - Annu. Meet. Spec. Interest Group Discourse Dialogue, Proc. Conf.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

