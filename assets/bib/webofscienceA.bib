Title = {Multilingual Twitter Corpus and Baselines for Evaluating Demographic
   Bias in Hate Speech Recognition},
Booktitle = {PROCEEDINGS OF THE 12TH INTERNATIONAL CONFERENCE ON LANGUAGE RESOURCES
   AND EVALUATION (LREC 2020)},
Year = {2020},
Pages = {1440-1448},
Note = {12th International Conference on Language Resources and Evaluation
   (LREC), Marseille, FRANCE, MAY 11-16, 2020},
Abstract = {Existing research on fairness evaluation of document classification
   models mainly uses synthetic monolingual data without ground truth for
   author demographic attributes. In this work, we assemble and publish a
   multilingual Twitter corpus for the task of hate speech detection with
   inferred four author demographic factors: age, country, gender and
   race/ethnicity. The corpus covers five languages: English, Italian,
   Polish, Portuguese and Spanish. We evaluate the inferred demographic
   labels with a crowdsourcing platform, Figure Eight. To examine factors
   that can cause biases, we take an empirical analysis of demographic
   predictability on the English corpus. We measure the performance of four
   popular document classifiers and evaluate the fairness and bias of the
   baseline classifiers on the author-level demographic attributes.},
