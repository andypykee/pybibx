@inproceedings{ WOS:000867070906060,
Author = {Sabry, Sana Sabah and Adewumi, Tosin and Abid, Nosheen and Kovacs,
   Gyorgy and Liwicki, Foteini and Liwicki, Marcus},
Book-Group-Author = {IEEE},
Title = {HaT5: Hate Language Identification using Text-to-Text Transfer
   Transformer},
Booktitle = {2022 INTERNATIONAL JOINT CONFERENCE ON NEURAL NETWORKS (IJCNN)},
Series = {IEEE International Joint Conference on Neural Networks (IJCNN)},
Year = {2022},
Note = {IEEE International Conference on Fuzzy Systems (FUZZ-IEEE) / IEEE World
   Congress on Computational Intelligence (IEEE WCCI) / International Joint
   Conference on Neural Networks (IJCNN) / IEEE Congress on Evolutionary
   Computation (IEEE CEC), Padua, ITALY, JUL 18-23, 2022},
Organization = {IEEE; Int Neural Network Soc; IEEE Computat Intelligence Soc;
   Evolutionary Programming Soc; IET; Univ Padova, Dept Math Tullio Levi
   Civita; European Space Agcy; expert.ai; Elsevier; Springer Nature;
   Google; Baker \& Hughes; NVIDIA},
Abstract = {We investigate the performance of a state-of-the-art (SoTA) architecture
   T5 (available on the SuperGLUE) and compare it with 3 other previous
   SoTA architectures across 5 different tasks from 2 relatively diverse
   datasets. The datasets are diverse in terms of the number and types of
   tasks they have To improve performance, we augment the training data by
   using a new autoregressive conversational AI model checkpoint. We
   achieve near-SoTA results on a couple of the tasks - macro F1 scores of
   81.66\% for task A of the OLID 2019 dataset and 82.54\% for task A of
   the hate speech and offensive content (HASOC) 2021 dataset, where SoTA
   are 82.9\% and 83.05\%, respectively. We perform error analysis and
   explain why one of the models (Bi-LSTM) makes the predictions it does by
   using a publicly available algorithm: Integrated Gradient (IG). This is
   because explainable artificial intelligence (XAI) is essential for
   earning the trust of users. The main contributions of this work are the
   implementation method of T5, which is discussed; the data augmentation,
   which brought performance improvements; and the revelation on the
   shortcomings of the HASOC 2021 dataset. The revelation shows the
   difficulties of poor data annotation by using a small set of examples
   where the T5 model made the correct predictions, even when the ground
   truth of the test set were incorrect (in our opinion). We also provide
   our model checkpoints on the HuggingFace hub(1).},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
Type = {Proceedings Paper},
