@article{ WOS:001552902600001,
Author = {Onyango, Nelson Odhiambo and Wanzare, Lilian and Obuhuma, James},
Title = {Swahili and Code-Switched English-Swahili Political Hate Speech
   Detection Textual Dataset},
Journal = {DATA INTELLIGENCE},
Year = {2025},
Volume = {7},
Number = {3},
Pages = {819-850},
Abstract = {The growth of online platforms coupled with users' ability to post and
   comment anonymously has resulted in an alarming spread of offensive and
   hateful content especially during election period. Efforts to monitor
   and detect hate speech, including computer based automated hate speech
   detection models remain unsatisfactory. This is primarily due to the
   fact that most annotated hate speech datasets focus on English, despite
   the growing use of low-resourced languages like Swahili and
   code-switched English-Swahili on Kenyan social media platforms such as
   Twitter (now X). Currently, there is only one annotated publicly
   available hate speech dataset having Swahili and code-switched
   English-Swahili texts. However, the dataset lacks language annotation
   distinguishing Swahili from English-Swahili. This poses a challenge, as
   the dataset also contains pure English tweets, making it difficult for
   researchers who require tweets in a specific language. Moreover, the
   dataset lacks hate target annotations, such as politics, disability,
   religion, ethnicity, social-status, nationality, gender, and others.
   This is a challenge since hate target labels help in comprehensive
   analysis of the hate stereotypes. This study therefore fills this gap by
   curating Swahili and code-switched English-Swahili hate speech dataset
   and annotating with hate class, target and language. Data preparation
   involved combining the Politikweli, AfriSenti, and Hate\_Speech\_Kenya
   datasets, resulting in a collection of 101,014 tweets. Hate target
   labels include nationality, social status, politics, disability,
   ethnicity, gender, religion and other. Multilingual index of 0.72 was
   achieved for code switching. Randolph's free marginal kappa score of
   0.435 and 0.552 was achieved for the first and second pilot dataset
   respectively with a significant difference of 0.117. The overall inter
   annotator score using Randolph's multirater kappa was 0.70 showing
   substantial agreement. As a result, this study provides hate speech
   textual dataset having a total of 19369 tweets labeled as hate,
   offensive and neither. To assess the dataset's suitability, experiments
   were conducted using a non-linear SVM and a Bi-directional Long
   Short-Term Memory (Bi-LSTM) model. SwahBERT model, a variant of BERT
   pre-trained on Swahili texts was fine-tuned on the code-switched data
   and achieved an F1-score of 0.89. Bi-LSTM model with fastText embeddings
   achieved an f1-score, accuracy, recall and precision of 0.8 on the test
   set showing the ability of fastText embeddings in capturing the nuances
   in code-switched texts. The recall for the hate speech class improved
   from 0.57 to 0.76 when the Synthetic Minority Oversampling Technique
   (SMOTE) was applied, demonstrating the dataset's practical
   applicability. Results for SVM trained on code-switched part of the
   dataset shows that traditional models performs better on a relatively
   smaller dataset. These results suggest that the dataset could be reused
   to develop machine learning models for moderation of bias and hate
   speech contents from social media especially in low-resource languages.
   This can help in promoting good mental health among social media users.
   The dataset can also serve as a benchmark for evaluating NLP techniques
   in low-resource settings.},
Publisher = {Chinese Acad Sciences, National Science Library},
Address = {5D, Haidian District, Beijing, PEOPLES R CHINA},
Type = {Article},
Language = {English},
Affiliation = {Onyango, NO (Corresponding Author), Maseno Univ, Sch Comp Informat, Dept Comp Sci, Maseno 40100, Kenya.
   Onyango, Nelson Odhiambo; Wanzare, Lilian; Obuhuma, James, Maseno Univ, Sch Comp Informat, Dept Comp Sci, Maseno 40100, Kenya.},
DOI = {10.3724/2096-7004.di.2025.0053},
EISSN = {2641-435X},
Keywords = {High resourced; Offensive; Labels; Dataset size; Data preprocessing},
Research-Areas = {Computer Science},
