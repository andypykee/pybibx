@ARTICLE{Kabakuş20212243,
	author = {Kabakuş, Abdullah Talha},
	title = {Towards the Importance of the Type of Deep Neural Network and Employment of Pre-trained Word Vectors for Toxicity Detection: An Experimental Study},
	year = {2021},
	journal = {Journal of Web Engineering},
	volume = {20},
