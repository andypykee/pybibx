@article{ WOS:001620231800004,
Author = {Park, Jaeil and Cho, Sung-Bae},
Title = {Improving fairness of abusive language detection with multi-attribute
   adversarial latent discriminator},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2026},
Volume = {299},
Number = {D},
Month = {MAR 1},
Abstract = {Social biases embedded in natural language can disproportionately affect
   marginalized groups such as women and African American communities,
   thereby raising ethical and fairness concerns in real-world
   applications. This paper investigates linguistic bias arising from
   multiple sensitive attributes such as gender and race transformer-based
   abusive language detection models. To address this, this paper proposes
   an unbiased detection model that performs dual regularization using a
   multi-attribute adversarial latent discriminator. It fine-tunes
   transformer to generate contextual sentence embeddings optimized for
   abuse detection, which are passed through an autoencoder to produce
   latent representations that are regularized using an attribute
   discriminator adversarially trained to remove bias in multiple features,
   as well as information-theoretic constraints that minimize mutual
   interference between disjoint attributes. The regularization process
   includes an abuse classifier to preserve abuse-related signals, a
   decoder to reconstruct the original semantic content, and a selective
   training mechanism prevents distortion of neutral sentences. Extensive
   experiments on four Twitter-based abusive language datasets against nine
   state-of-the-art bias mitigation methods demonstrate that the proposed
   model reduces false-positive equality difference by 20\% and
   false-negative equality difference by 7\%, with only a decrease 0.3\%
   point in AUC. Furthermore, subspace correlation and embedding analyses
   confirm that the model effectively orthogonalizes bias-aligned feature
   directions, thereby neutralizing socially sensitive signals. Warning:
   This paper contains abusive samples that may cause discomfort to
   readers.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
