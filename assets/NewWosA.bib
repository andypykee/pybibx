@inproceedings{ WOS:000614822800031,
Author = {Ombui, Edward and Muchemi, Lawrence and Wagacha, Peter and Gichamba,
   Amos and Karani, Mose},
Book-Group-Author = {IEEE},
Title = {Leveraging Hierarchical Features for HateSpeech Identification in Short
   Message Texts},
Booktitle = {2019 IEEE AFRICON},
Series = {Africon},
Year = {2019},
Note = {IEEE AFRICON Conference - Powering Africa s Sustainable Energy for AD
   Agenda - The Role ofICT and Engineering., Accra, GHANA, SEP 25-27, 2019},
Organization = {IEEE; IEEE Ghana Sect},
Abstract = {This study espouses that quick gains in hate speech identification can
   be achieved by using a simple hierarchical structure of high-level
   features that map into low level features e.g. hate lexical terms mapped
   to term frequency-inverse document frequency features. The study
   implements this approach and uses supervised machine learning to train a
   classifier on 48k human annotated tweets to automatically identify hate
   speech generated during the 2012 and 2017 presidential elections in
   Kenya. Preliminary results indicate an accuracy of 0.74, which is higher
   than the baseline for the same data set labeled by human annotators.},
