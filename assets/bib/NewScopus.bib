@CONFERENCE{Sandri20232420,
	author = {Sandri, Marta and Tonelli, Sara and Leonardelli, Elisa and Ježek, Elisabetta},
	title = {Why Don't You Do It Right? Analysing Annotators' Disagreement in Subjective Tasks},
	year = {2023},
	journal = {EACL 2023 - 17th Conference of the European Chapter of the Association for Computational Linguistics, Proceedings of the Conference},
	pages = {2420 - 2433},
	doi = {10.18653/v1/2023.eacl-main.178},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85159858877&doi=10.18653%2Fv1%2F2023.eacl-main.178&partnerID=40&md5=5cdefb17b7d50ab442c6cec936f60fc4},
	affiliations = {Università degli Studi di Pavia, Department of Humanities, Pavia, PV, Italy; Bruno Kessler Foundation, Trento, TN, Italy},
	abstract = {Annotators' disagreement in linguistic data has been recently the focus of multiple initiatives aimed at raising awareness on issues related to 'majority voting' when aggregating diverging annotations. Disagreement can indeed reflect different aspects of linguistic annotation, from annotators' subjectivity to sloppiness or lack of enough context to interpret a text. In this work we first propose a taxonomy of possible reasons leading to annotators' disagreement in subjective tasks. Then, we manually label part of a Twitter dataset for offensive language detection in English following this taxonomy, identifying how the different categories are distributed. Finally we run a set of experiments aimed at assessing the impact of the different types of disagreement on classification performance. In particular, we investigate how accurately tweets belonging to different categories of disagreement can be classified as offensive or not, and how injecting data with different types of disagreement in the training set affects performance. We also perform offensive language detection as a multi-task framework, using disagreement classification as an auxiliary task. © 2023 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Classification performance; Classifieds; Language detection; Linguistic annotations; Linguistic data; Multi tasks; Offensive languages; Performance; Training sets; Taxonomies},
