@CONFERENCE{Wang2024136,
	author = {Wang, Linya and Mou, Shiyu and Liu, Peize},
	title = {RBA: A Detection Method for Offensive Language in Chinese},
	year = {2024},
	journal = {ACM International Conference Proceeding Series},
	pages = {136 - 141},
	doi = {10.1145/3696687.3696711},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000686684&doi=10.1145%2F3696687.3696711&partnerID=40&md5=43747e4ada1861e50530658c606d1ef4},
	affiliations = {Southwest Minzu University, School of Computer Science and Engineering, Chengdu, Sichuan, China; Universiti Malaya, Department of Biomedical Engineering, Kuala Lumpur, Malaysia},
	abstract = {As social media continues to gain popularity, offensive language on the Internet is on the rise, and how to effectively detect it has become a hot spot in the academic community. Due to the strong context-dependence of Chinese offensive text, the feature information is challenging to extract, and the training is susceptible to noise interference. Therefore, we propose a Chinese offensive language detection model integrating RoBERTa-base-cold, BiLSTM and adversarial training. The model generates dynamic word vectors containing offensive features by segmenting the text with RoBERTa-base-cold, then adds noise perturbations to these output vectors to generate adversarial samples and sends these adversarial samples to BiLSTM to enhance model robustness through adversarial training in the face of noise interference. Experiments are conducted on the COLDataset dataset, and the results show that this method is more effective than other modelling methods in detecting Chinese offensive speech. © 2024 ACM.},
	author_keywords = {adversarial training; BiLSTM; offensive speech detection; offensive speech on Chinese web; pre-trained model},
	keywords = {BiLSTM; Chinese web; Detection methods; Noise interference; Offensive languages; Offensive speech detection; Offensive speech on chinese web; Pre-trained model; Social media; Speech detection; Speech recognition},
