@inproceedings{ WOS:001481311000157,
Author = {Kaware, Pravin D. and Raut, Anjali B.},
Book-Group-Author = {IEEE},
Title = {Comparative Analysis on Prediction Model of Hate Speech Detection Based
   on Social Media Data Using Artificial Intelligence},
Booktitle = {2025 FOURTH INTERNATIONAL CONFERENCE ON POWER, CONTROL AND COMPUTING
   TECHNOLOGIES, ICPC2T},
Year = {2025},
Pages = {938-943},
Note = {4th International Conference on Power, Control and Computing
   Technologies-ICPC2T, Raipur, INDIA, JAN 20-22, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc; Institute of
   Electrical and Electronics Engineers Industry Applications Society},
Abstract = {The exponential expansion of social media networking platforms has
   magnified the dissemination of hate speech, thereby requiring strong
   recognition systems to minimize its influence. The present work offers a
   comparative examination of many prediction models for the recognition of
   hate speech using social media data, employing Artificial Intelligence
   (AI) methodologies. The paper intends to assess the efficiency of
   several Machine Learning (ML) and Deep Learning (DL) algorithms for
   accurately detecting hate speech. The various strategies are evaluated
   using known datasets and measures including accuracy, recall, precision,
   and F1-score. In addition, useful insights on the most effective methods
   for identifying hate speech are presented. The findings suggest that
   deep learning approaches are exceptionally effective at catching the
   contextual nuances of hate speech. AI-based hate speech detection apps
   improve accuracy and efficiency. Such systems are critical for creating
   a safer and more inclusive online.},
