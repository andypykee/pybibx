@inproceedings{ WOS:001588601200033,
Author = {Dalai, Asish Kumar and Shankar, Yadavalli Uday and Sahoo, Somya Ranjan
   and Kondamudi, Medeswara Rao and Bulasara, Phani Krishna},
Book-Group-Author = {IEEE},
Title = {Transformer-Based Hybrid Model for Robust Abusive Content Detection in
   Online Social Networks (OSNs)},
Booktitle = {2025 IEEE INTERNATIONAL CONFERENCE ON ADVANCED VISUAL AND SIGNAL-BASED
   SYSTEMS, AVSS},
Series = {IEEE Conference on Advanced Video and Signal Based Surveillance-AVSS},
Year = {2025},
Note = {2025 International Conference on Advanced Visual and Signal-Based
   Systems-AVSS, TAIWAN, AUG 11-13, 2025},
Organization = {National Yang Ming Chiao Tung University; Signal Processing Society},
Abstract = {Identifying abusive content in online social networks (OSNs) continues
   to be a considerable issue due to linguistic complexity, code-mixing,
   and the existence of implicit abuse. This article presents a
   transformer-based hybrid model that combines contextual embeddings from
   transformer models with convolutional neural networks (CNNs) for pattern
   recognition and subsequently employs an attention mechanism to improve
   contextual interpretation. The model proficiently captures both
   word-level and characterlevel features, overcoming the drawbacks of
   current techniques that frequently break with implicit and multilingual
   abuse. An F1-score of 96.7\%, an accuracy of 95.73\%, a precision of
   94.5\%, a recall of 96.8\%, and detailed tests on benchmark datasets
   show that the proposed model works very well. A comparison with
   cutting-edge methodologies further proves the model's efficacy in
   minimizing false positives and false negatives. The findings underscore
   the effectiveness of the suggested method in detecting abusive content
   across diverse contexts. This article enhances the safety of digital
   platforms by offering a dependable and scalable approach for the
   real-time detection of abusive content.},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Dalai, AK (Corresponding Author), VIT AP Univ, Amaravati, India.
   Dalai, Asish Kumar; Shankar, Yadavalli Uday; Sahoo, Somya Ranjan; Kondamudi, Medeswara Rao; Bulasara, Phani Krishna, VIT AP Univ, Amaravati, India.},
DOI = {10.1109/AVSS65446.2025.11149887},
ISSN = {2643-6205},
