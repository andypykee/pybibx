@inproceedings{ WOS:001119000303025,
Author = {Lees, Alyssa and Tran, Vinh Q. and Tay, Yi and Sorensen, Jeffrey and
   Gupta, Jai and Metzler, Donald and Vasserman, Lucy},
Book-Group-Author = {ACM},
Title = {A New Generation of Perspective API: Efficient Multilingual
   Character-level Transformers},
