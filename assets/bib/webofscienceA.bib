@inproceedings{ WOS:001456575700383,
Author = {Rottger, Paul and Nozza, Debora and Bianchi, Federico and Hovy, Dirk},
Editor = {Goldberg, Y and Kozareva, Z and Zhang, Y},
Title = {Data-Efficient Strategies for Expanding Hate Speech Detection into
   Under-Resourced Languages},
