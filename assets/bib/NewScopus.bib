	year = {2025},
	journal = {IET Conference Proceedings},
	volume = {2024},
	number = {34},
	pages = {185 - 190},
	doi = {10.1049/icp.2025.0081},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105027936488&doi=10.1049%2Ficp.2025.0081&partnerID=40&md5=2f5ee1e8d9ee76f11604846decf2f4d5},
	affiliations = {Al-Esraa University, Medical Instrumentation Engineering Department, Baghdad, Baghdad, Iraq; Al-Farahidi University, Department of Medical Instrumentation Technical Engineering, Baghdad, Baghdad, Iraq; Uruk University, Medical Instrumentation Engineering Department, Baghdad, Iraq; Al-Kunooze University College, Technical Computer Engineering Department, Basra, Iraq; Al-Kitab University, Cybersecurity Technology Engineering Department, Kirkuk, Kirkuk, Iraq},
	abstract = {Over the last several years, there has been a conspicuous surge in derogatory and inflammatory remarks on Twitter, often entwined with racial and religious attitudes. This phenomenon is especially noticeable in Iraq, where Arabic is the main language spoken on the site. Social media posts from Iraq provide distinct difficulties because of the convergence of hate speech, foul language, and freedom of expression. Hence, customized techniques and a domain-specific Arabic corpus are crucial for precisely detecting hate speech and inflammatory tweets. While machine learning has shown its effectiveness in other Arabic settings, our work especially aims to assess several machine learning approaches tailored to this particular goal. We compiled an Arabic dataset consisting of tweets from Iraq and used sophisticated techniques to extract and evaluate character n-grams, word n-grams, negative emotion, and syntactic-based characteristics. The aforementioned techniques were integrated with hyper-parameter optimization, ensemble, and multi-tier meta-learning models, including support vector machine, logistic regression, random forest, and gradient boosting approaches. This study primarily focuses on well-known machine learning models for text categorization, including CNN, ELMo, and BERT. We used these methodologies on our datasets and, thereafter, merged the classifiers to improve the accuracy of categorization. The findings indicate substantial improvements in both the accuracy of classification and the F1-score. © The Institution of Engineering & Technology 2024.},
	author_keywords = {DEEP LEARNING; F1 SCORE; HATE SPEECH; MACHINE LEARNING; TWITTER},
	keywords = {Adaptive boosting; Data mining; Learning systems; Logistic regression; Random forests; Speech recognition; Support vector regression; Syntactics; Text processing; Tweets; DEEP LEARNING; Domain specific; F1 scores; HATE SPEECH; Machine learning approaches; Machine learning techniques; Machine-learning; N-grams; Social media; Word n-grams; Deep learning; Social networking (online)},
