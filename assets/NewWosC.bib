@inproceedings{ WOS:000651584500044,
Author = {Simons, B. and Skillicorn, D. B.},
Book-Group-Author = {IEEE},
Title = {A Bootstrapped Model to Detect Abuse and Intent in White Supremacist
   Corpora},
Booktitle = {2020 IEEE INTERNATIONAL CONFERENCE ON INTELLIGENCE AND SECURITY
   INFORMATICS (ISI)},
Year = {2020},
Pages = {242-247},
Note = {18th IEEE International Conference on Intelligence and Security
   Informatics (IEEE ISI), ELECTR NETWORK, NOV 09-10, 2020},
Organization = {IEEE; Univ Virginia, McIntire Sch Commerce, Ctr Business Analyt; Univ
   Virginia, McIntire Sch Commerce, Ctr Management Informat Technol; Amer
   Univ, Kogod Sch Business, Robust Analyt Lab; Amer Univ, Kogod Sch
   Business, Kogod Cybersecur Ctr; Intelligent Transportat Syst Soc},
Abstract = {Intelligence analysts face a difficult problem: distinguishing extremist
   rhetoric from potential extremist violence. Many are content to express
   abuse against some target group, but only a few indicate a willingness
   to engage in violence. We address this problem by building a predictive
   model for intent, bootstrapping from a seed set of intent words, and
   language templates expressing intent. We design both an n-gram and
   attention-based deep learner for intent and use them as colearners to
   improve both the basis for prediction and the predictions themselves.
   They converge to stable predictions in a few rounds. We merge
   predictions of intent with predictions of abusive language to detect
   posts that indicate a desire for violent action. We validate the
   predictions by comparing them to crowd-sourced labelling. The
   methodology can be applied to other linguistic properties for which a
   plausible starting point can be defined.},
