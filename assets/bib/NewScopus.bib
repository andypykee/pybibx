@ARTICLE{Awal20241086,
	author = {Awal, Md Rabiul and Lee, Roy Ka Wei and Tanwar, Eshaan and Garg, Tanmay and Chakraborty, Tanmoy},
	title = {Model-Agnostic Meta-Learning for Multilingual Hate Speech Detection},
