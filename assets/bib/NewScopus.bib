@CONFERENCE{Park202420963,
	author = {Park, Someen and Kim, Jaehoon and Jin, Seungwan and Park, Sohyun and Han, Kyungsik},
	title = {PREDICT: Multi-Agent-based Debate Simulation for Generalized Hate Speech Detection},
	year = {2024},
	journal = {EMNLP 2024 - 2024 Conference on Empirical Methods in Natural Language Processing, Proceedings of the Conference},
	pages = {20963 - 20987},
	doi = {10.18653/v1/2024.emnlp-main.1166},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217792624&doi=10.18653%2Fv1%2F2024.emnlp-main.1166&partnerID=40&md5=29457a34b364de81c46e0ffabe594dbd},
	affiliations = {Hanyang University, Department of Artificial Intelligence, Seoul, South Korea; Hanyang University, Department of Data Science, Seoul, South Korea},
	abstract = {While a few public benchmarks have been proposed for training hate speech detection models, the differences in labeling criteria between these benchmarks pose challenges for generalized learning, limiting the applicability of the models. Previous research has presented methods to generalize models through data integration or augmentation, but overcoming the differences in labeling criteria between datasets remains a limitation. To address these challenges, we propose PREDICT, a novel framework that uses the notion of multi-agent for hate speech detection. PREDICT consists of two phases: (1) PRE (Perspective-based REasoning): Multiple agents are created based on the induced labeling criteria of given datasets, and each agent generates stances and reasons; (2) DICT (Debate using InCongruenT references): Agents representing hate and non-hate stances conduct the debate, and a judge agent classifies hate or non-hate and provides a balanced reason. Experiments on five representative public benchmarks show that PREDICT achieves superior cross-evaluation performance compared to methods that focus on specific labeling criteria or majority voting methods. Furthermore, we validate that PREDICT effectively mediates differences between agents' opinions and appropriately incorporates minority opinions to reach a consensus. Our code is available at https://github.com/Hanyang-HCCLab/PREDICT. © 2024 Association for Computational Linguistics.},
	keywords = {Benchmarking; Labeled data; Prediction models; Speech recognition; Agent based; Based reasonings; Detection models; Generalized learning; Labelings; Multi agent; Multiple agents; Phase 1; Speech detection; Two phase; Computational linguistics},
	correspondence_address = {K. Han; Department of Artificial Intelligence, Hanyang University, Seoul, South Korea; email: kyungsikhan@hanyang.ac.kr},
	editor = {Al-Onaizan, Y. and Bansal, M. and Chen, Y.-N.},
	publisher = {Association for Computational Linguistics (ACL)},
	isbn = {9798891761643},
	language = {English},
	abbrev_source_title = {EMNLP - Conf. Empir. Methods Nat. Lang. Process., Proc. Conf.},
	type = {Conference paper},
