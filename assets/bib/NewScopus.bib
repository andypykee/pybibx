@CONFERENCE{Wang2024,
	author = {Wang, Yifei and Liao, Yong},
	title = {SCNet: Hate Speech Detection Leveraging Syntactic Information and Conversational Contexts},
	year = {2024},
	journal = {MLNLP 2024 - 2024 International Conference on Machine Learning and Natural Language Processing},
	pages = {},
	doi = {10.1109/MLNLP63328.2024.10800103},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215596071&doi=10.1109%2FMLNLP63328.2024.10800103&partnerID=40&md5=eed3ec833e80ad823353dd531d2ae99b},
	affiliations = {University of Science and Technology of China, CCCD Key Lab of Ministry of Culture and Tourism, Hefei, Anhui, China},
	abstract = {The rapid growth of social networks has facilitated the spread of hate speech. In recent years, hate speech has become more covert, often disguising its discriminatory intent through euphemisms, sarcasm, and code language. Most existing studies rely on pre-trained language models to generate text embeddings but often overlook syntactic structures and long-distance dependencies. Furthermore, analyzing individual utterances often fails to reveal implicit hate speech tendencies. To address these challenges, we propose SCNet, a novel method that integrates both internal Syntactic information and external Conversational contexts for hate speech detection. First, we represent the syntactic structure within each utterance by Parse Tree Modeling, capturing non-consecutive and long-distance dependencies between words. Then, by constructing a Comment-Repost Graph and a Temporal Comment Sequence, we model the conversation structure on social platforms, capturing cross-level dependencies and long-distance external semantics between utterances. Experimental results demonstrate that SCNet significantly improves hate speech detection performance across two datasets. This study offers a novel approach and valuable insights for advancing hate speech detection. © 2024 IEEE.},
	author_keywords = {graph attention networks; graph transformer; hate speech detection; social media},
	keywords = {Social networking (online); Speech coding; Speech communication; Speech recognition; Syntactics; Trees (mathematics); Code languages; Graph attention network; Graph transformer; Hate speech detection; Long-distance dependencies; Rapid growth; Social media; Speech detection; Syntactic information; Syntactic structure; Semantics},
	correspondence_address = {Y. Liao; University of Science and Technology of China, CCCD Key Lab, Ministry of Culture and Tourism, Hefei, China; email: yliao@ustc.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798350354973},
	language = {English},
	abbrev_source_title = {MLNLP - Int. Conf. Mach. Learn. Nat. Lang. Process.},
	type = {Conference paper},
	publication_stage = {Final},
