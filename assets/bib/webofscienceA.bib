@inproceedings{ WOS:001361895500266,
Author = {Uzanl, Moshe and HaCohen-Kerner, Yaakov},
Editor = {Herbelot, A and Zhu, X and Palmer, A and Schneider, N and May, J and Shutova, E},
Title = {JCT at SemEval-2020 Task 12: Offensive Language Detection in Tweets
   using Preprocessing Methods, Character andWord N-grams},
Booktitle = {PROCEEDINGS OF THE FOURTEENTH WORKSHOP ON SEMANTIC EVALUATION},
Year = {2020},
Pages = {2017-2022},
Note = {14th International Workshops on Semantic Evaluation (SemEval), ELECTR
   NETWORK, DEC 12-13, 2020},
Organization = {ACL Special Interest Grp Lexicon},
Abstract = {In this paper, we describe our submissions to SemEval-2020 contest. We
   tackled subtask 12 - ``Multilingual Offensive Language Identification in
   Social Media{''}. We developed different models for four languages:
   Arabic, Danish, Greek, and Turkish. We applied three supervised machine
   learning methods using various combinations of character and word n-gram
   features. In addition, we applied various combinations of basic
   preprocessing methods. Our best submission was a model we built for
   offensive language identification in Danish using Random Forest. This
   model was ranked at the 6th position out of 39 submissions. Our result
   is lower by only 0.0025 than the result of the team that won the 4th
   place using entirely non-neural methods. Our experiments indicate that
   char ngram features are more helpful than word ngram features. This
   phenomenon probably occurs because tweets are more characterized by
   characters than by words, tweets are short, and contain various special
