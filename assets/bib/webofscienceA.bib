Title = {MDSBots@NLU of Devanagari Script Languages 2025: Detection of Language,
   Hate Speech, and Targets using MURTweet},
Booktitle = {PROCEEDINGS OF THE FIRST WORKSHOP ON CHALLENGES IN PROCESSING SOUTH
   ASIAN LANGUAGES, CHIPSAL 2025},
Year = {2025},
