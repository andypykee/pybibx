@inproceedings{ WOS:001447818200033,
Author = {Zeng, Haoyuan and Qiao, Bo and Wang, Ye and Bin Zhou},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Hate Speech Detection in Network Perception Constrained Scenarios<bold>
   </bold>},
