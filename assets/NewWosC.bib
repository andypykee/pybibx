Title = {Multi-Label Classification of Hate Speech Severity on Social Media using
   BERT Model},
Booktitle = {2022 IEEE NIGERIA 4TH INTERNATIONAL CONFERENCE ON DISRUPTIVE
   TECHNOLOGIES FOR SUSTAINABLE DEVELOPMENT (IEEE NIGERCON)},
Year = {2022},
Pages = {267-271},
