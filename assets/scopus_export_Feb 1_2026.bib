@ARTICLE{Iftikhar2025,
	author = {Iftikhar, Uzair and Ali, Syed Farooq and Mustafa, Ghulam and Bahar, Nurhidayah N.B. and Ishaq, Kashif},
	title = {Beyond words: a hybrid transformer-ensemble approach for detecting hate speech and offensive language on social media},
	year = {2025},
	journal = {PeerJ Computer Science},
