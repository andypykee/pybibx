@inproceedings{ WOS:001308354700006,
Author = {Rajput, Gaurav and Punn, Narinder Singh and Sonbhadra, Sanjay Kumar and
   Agarwal, Sonali},
Editor = {Srirama, SN and Lin, JCW and Bhatnagar, R and Agarwal, S and Reddy, PK},
Title = {Hate Speech Detection Using Static BERT Embeddings},
Booktitle = {9TH INTERNATIONAL CONFERENCE ON BIG DATA ANALYTICS, BDA 2021},
Series = {Lecture Notes in Computer Science},
Year = {2021},
