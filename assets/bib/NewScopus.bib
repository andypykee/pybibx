@CONFERENCE{Huang2024283,
	author = {Huang, Qinxue and Zhang, Chaolong and Xu, Yuanping and Wang, Weiye and Xu, Zhijie and Guo, Benjun and Jin, Jin and Kong, Chao},
	title = {An Improved SlowFast Model for Violence Detection},
	year = {2024},
	journal = {2024 4th International Symposium on Artificial Intelligence and Intelligent Manufacturing, AIIM 2024},
	pages = {283 - 287},
	doi = {10.1109/AIIM64537.2024.10934254},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002213483&doi=10.1109%2FAIIM64537.2024.10934254&partnerID=40&md5=1ee1afbcc17dceafae779b139937fb18},
	affiliations = {Chengdu University of Information Technology, School of Software Engineering, Chengdu, Sichuan, China; Xi'an Jiaotong-Liverpool University, School of Advanced Technology, Suzhou, Jiangsu, China},
	abstract = {As social safety concerns become increasingly prominent, the importance of violence detection has become increasingly significant. Accurately identifying violent behavior helps facilitate timely interventions, reducing harm and losses, thereby enhancing public safety. To minimize the interference from irrelevant actions (e.g., those from spectators and uninvolved individuals) during violence detection, this study proposes an improved SlowFast method that enhances the robustness of the model by modifying the network structure of the Slow Pathway and lateral connections. In the Slow Pathway, the original residual block is replaced with an SE-Res residual block, which strengthens the weighting of channel importance, making the model more stable in complex scenarios. The lateral connections are improved by integrating a 3D-Convolutional Block Attention Module(3DCBAM), enhancing feature fusion and increasing the model's sensitivity to key features across different temporal scales. Furthermore, to address the class imbalance issue within the dataset, the Focal Loss function has been modified, effectively improving the performance of each class. The improved model demonstrates excellent performance in violence detection tasks, achieving an accuracy of 96.67%, which is a 1.12% improvement over the classical model. © 2024 IEEE.},
	author_keywords = {Action Recognition; Feature Fusion; ResNet; SlowFast; Violence Detection},
	keywords = {Action recognition; Features fusions; Lateral connections; Performance; Public safety; Safety concerns; Slow pathways; Slowfast; Violence detections; Violent behavior; Feature extraction},
	correspondence_address = {C. Zhang; School of Software Engineering, Chengdu University of Information Technology, Chengdu, China; email: czhang@cuit.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798331541729},
	language = {English},
	abbrev_source_title = {Int. Symp. Artif. Intell. Intell. Manuf., AIIM},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Vargas202452,
