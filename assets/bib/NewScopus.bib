	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105026666989&doi=10.14569%2FIJACSA.2025.0161144&partnerID=40&md5=1cf20c040b474edbe15547c74c83b253},
	affiliations = {Universiti Poly-Tech Malaysia (UPTM), Faculty of Computing and Multimedia, Kuala Lumpur, Malaysia; Universiti Sultan Zainal Abidin, Faculty of Informatics and Computing, Kuala Terengganu, Terengganu, Malaysia; Universiti Sultan Zainal Abidin, Kuala Terengganu, Terengganu, Malaysia},
	abstract = {Cross-lingual sentiment analysis (CLSA) has become increasingly important in natural language processing and machine learning, enabling the understanding of opinions across diverse linguistic communities, particularly in low-resource languages (LRLs). Despite growing attention, persistent challenges such as limited annotated data, semantic misalignment, and cultural variation in sentiment expression continue to hinder progress. This systematic literature review (SLR) examines recent developments by analyzing the tasks, methods, and challenges reported in CLSA studies focused on LRLs. Following the PRISMA 2020 framework, a comprehensive search was conducted across major databases, including Scopus, IEEE Xplore, SpringerLink, Elsevier, and Google Scholar, covering studies published between 2021 and 2025. After applying inclusion and exclusion criteria, 27 studies were selected for analysis. The findings reveal that while polarity detection remains the dominant sentiment analysis task, emerging directions such as aspect-based sentiment analysis (ABSA), emotion detection, and hate speech recognition are gaining traction. Methodologically, most studies rely on multilingual pre-trained language models (PLMs), supplemented by machine translation, transfer learning, few-shot learning, and hybrid approaches. However, key challenges remain, including the scarcity of high-quality datasets, instability of few-shot performance, difficulties in handling dialectal variation, bias in PLMs, and the lack of standardized evaluation benchmarks. This review concludes by emphasizing the need for more culturally grounded tasks, adaptive hybrid frameworks, and fairness-aware evaluation practices to build robust cross-lingual frameworks and richer linguistic resources for underrepresented languages. © (2025), (Science and Information Organization). All Rights Reserved.},
	author_keywords = {Cross-lingual sentiment analysis; few-shot learning; low-resource language; natural language processing; pre-trained language models; transfer learning},
	keywords = {Benchmarking; Computational linguistics; Data mining; Emotion Recognition; Learning systems; Speech recognition; Transfer learning; Cross-lingual; Cross-lingual sentiment analyze; Few-shot learning; Language model; Language processing; Low resource languages; Natural language processing; Natural languages; Pre-trained language model; Sentiment analysis; Semantics},
