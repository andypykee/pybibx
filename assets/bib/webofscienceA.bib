Title = {Hate Speech Detection Using Brazilian Imageboards},
Booktitle = {WEBMEDIA 2019: PROCEEDINGS OF THE 25TH BRAZILLIAN SYMPOSIUM ON
   MULTIMEDIA AND THE WEB},
Year = {2019},
Pages = {325-328},
Note = {25th Brazillian Symposium on Multimedia and the Web (WebMedia), Rio de
   Janeiro, BRAZIL, OCT 29-NOV 01, 2019},
Organization = {Nucleo Informacao Coordenacao Ponto BR; Comite Gestor Internet Brasil;
   CAPES; Conselho Nacl Desenvolvimento Ccientifico Tecnologico; Fundacao
   Carlos Chagas Filho Amparo Pesquisa Estado Rio Janeiro; IBM; Google; ACM
   Special Interest Grp Multi Media; ACM Special Interest Grp Hypertext \&
   Web; Brazilian Comp Soc; IBM Res; CEFET RJ; Univ Fed Fluminense;
   Programa Pos Graduacao Ciencia Computacao; Grp Pesquisa Multi Media;
   Inst Computacao; Midiacom Lab},
Abstract = {With the changes in human interaction prompted by the development of
   communications platforms over the internet, hate speech and offensive
   language emerged as a contemporary problem. Social networks allow users
   with different opinions and backgrounds to interact without direct
   eye-to-eye contact. It brings a sense of safety to promote hate speech,
   which is even more significant in anonymous environments. There are
   sites called imageboards, composed of different boards aggregating
   different topics. On some boards, anonymous users widely promote hate
   speech. However, only a few works in literature have focused on hate
   speech in imageboards content. This work aims to classify Brazilian
   Portuguese texts to detect hate speech, using data from the Brazilian
   55chan imageboard to build a dataset with hate speech content. Three
   classifiers were trained to hate speech binary classification. The
   Linear Support Vector Classifier achieved the best result with 0.955 of
   F1-score.},
