@article{ WOS:001582685700002,
Author = {Diaz-Garcia, J. Angel and Carvalho, Joao Paulo},
Title = {A Literature Review of Textual Cyber Abuse Detection Using Cutting-Edge
   Natural Language Processing Techniques: Language Models and Large
   Language Models},
Journal = {WILEY INTERDISCIPLINARY REVIEWS-DATA MINING AND KNOWLEDGE DISCOVERY},
Year = {2025},
