Editor = {Barhamgi, M and Wang, H and Wang, X},
Title = {The Influence of Social Networking Usage Experience and Activity on
   Preferences of Explainable Artificial Intelligence (XAI) Representation
   Methods in a Hate Speech Detection System},
Booktitle = {WEB INFORMATION SYSTEMS ENGINEERING-WISE 2024, PT II},
