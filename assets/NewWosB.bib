Title = {Power of Explanations: Towards automatic debiasing in hate speech
   detection},
Booktitle = {2022 IEEE 9TH INTERNATIONAL CONFERENCE ON DATA SCIENCE AND ADVANCED
   ANALYTICS (DSAA)},
Series = {Proceedings of the International Conference on Data Science and Advanced
