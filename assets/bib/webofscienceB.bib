@inproceedings{ WOS:001457406600071,
Author = {Nassir, Hameem Abdul and Shivadas, Shrithika and Anaswar, V. S. and
   Ashique, T. P. and Jayakrishnan, A.},
Book-Group-Author = {IEEE},
Title = {HATE SPEECH RECOGNITION USING BERT AND CNN},
Booktitle = {2024 INTERNATIONAL CONFERENCE ON ADVANCEMENT IN RENEWABLE ENERGY AND
   INTELLIGENT SYSTEMS, AREIS},
Year = {2024},
Note = {2024 International Conference on Advancement in Renewable Energy and
   Intelligent Systems, Thrissur, INDIA, DEC 05-06, 2024},
Abstract = {Hate speech detection is a pivotal task in maintaining a safe and
   inclusive online environment. This project employs a combination of
   Word2Vec and BERT-CNN architectures to effectively identify and classify
   offensive language and normal language from social media comments and
   texts. The project encompasses several key steps, including data
   preprocessing, feature extraction using Word2Vec embeddings, and model
   training using the BERT-CNN architecture. The BERT-CNN framework
   consists of six layers: BERT embedding layer, convolutional layer(s),
   pooling layer, dense layer, dropout layer, and output layer. Training
   involves optimizing the model parameters through backpropagation to
   minimize classification errors. Evaluation metrics are used to assess
   the model's performance. The trained model can be deployed to
   automatically detect and mitigate hate speech in real-time, thus leading
   to a safer and more inclusive online community. This project contributes
   to combating online hate speech and fostering a positive digital
   environment.},
