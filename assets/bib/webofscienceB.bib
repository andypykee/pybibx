@inproceedings{ WOS:001361895500285,
Author = {Kumari, Sonal},
Editor = {Herbelot, A and Zhu, X and Palmer, A and Schneider, N and May, J and Shutova, E},
Title = {Sonal.kumari at SemEval-2020 Task 12: Social Media Multilingual
   Offensive Text Identification and Categorization using Neural Network
   Models},
Booktitle = {PROCEEDINGS OF THE FOURTEENTH WORKSHOP ON SEMANTIC EVALUATION},
Year = {2020},
Pages = {2146-2154},
Note = {14th International Workshops on Semantic Evaluation (SemEval), ELECTR
   NETWORK, DEC 12-13, 2020},
Organization = {ACL Special Interest Grp Lexicon},
Abstract = {In this paper, we present our approaches and results for SemEval-2020
   Task 12, Multilingual Offensive Language Identification in Social Media
   (OffensEval 2020). The OffensEval 2020 had three subtasks: A)
   Identifying the tweets to be offensive (OFF) or non-offensive (NOT) for
   Arabic, Danish, English, Greek, and Turkish languages, B) Detecting if
   the offensive tweet is targeted (TIN) or untargeted (UNT) for the
   English language, and C) Categorizing the offensive targeted tweets into
   three classes, namely: individual ( IND), Group (GRP), or Other (OTH)
   for the English language. We participate in all the subtasks A, B, and
   C. In our solution, first we use the pre-trained BERT model for all
   subtasks, A, B, and C and then we apply the BiLSTM model with attention
   mechanism (Attn-BiLSTM) for the same. Our result demonstrates that the
   pre-trained model is not giving good results for all types of languages
   and is compute and memory intensive whereas the Attn-BiLSTM model is
   fast and gives good accuracy with fewer resources. The Attn-BiLSTM model
   is giving better accuracy for Arabic and Greek where the pretrained
   model is not able to capture the complete context of these languages due
   to lower vocabsize.},
