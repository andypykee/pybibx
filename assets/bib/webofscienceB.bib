Title = {Hate Speech Detection in Thai Social Media with Ordinal-Imbalanced Text
   Classification},
Booktitle = {2022 19TH INTERNATIONAL JOINT CONFERENCE ON COMPUTER SCIENCE AND
   SOFTWARE ENGINEERING (JCSSE 2022)},
