@CONFERENCE{Ul-Mustafa2024,
	author = {Ul-Mustafa, Raza and Ashraf, Noman and Japkowicz, Nathalie},
	title = {Can GPT-4 detect subcategories of hatred?},
	year = {2024},
	journal = {2024 IEEE Digital Platforms and Societal Harms, DPSH 2024},
	pages = {},
	doi = {10.1109/DPSH60098.2024.10775211},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215132586&doi=10.1109%2FDPSH60098.2024.10775211&partnerID=40&md5=3a3dac04cea19ee9dcaee933d8d127f6},
	affiliations = {Loyola University New Orleans, New Orleans, LA, United States; Instituto Politécnico Nacional, Mexico, DF, Mexico; American University, New York, NY, United States},
	abstract = {Automatic hate speech detection is an important topic of investigation, though simply identifying a social media post as hate-laden may not be sufficient. To properly catalog the kind of hatred and, eventually, generate appropriate interventions, it is important to understand what the hatred relates to. Tropes are defined as significant recurring themes in discourse. Hate speech often revolves around tropes specific to the kind of hatred expressed in the post. Common tropes within Islamophobia and antisemitism, for example, include 'Oppression to women' and 'Domination and Control', respectively. The purpose of this paper is to investigate how well the powerful GPT-4 Large Language Model (LLM) can identify the trope expressed in a hateful social media post. In particular, we investigate the performance of GPT-4 on the problem of trope classification in Islamophobia and antisemitism. The results suggest that GPT-4 still presents significant gaps in understanding human text in the context of hate speech, opening the door to future research in that area. Warning: some of the Islamophobic and antisemitic examples and terms shown in this article are of a disturbing nature, but must be included to fully illustrate the purpose of our study. © 2024 IEEE.},
	author_keywords = {antisemitism; hate speech; Islamophobia},
	keywords = {Antisemitism; Hate speech; Islamophobia; Language model; Performance; Social media; Speech detection},
	correspondence_address = {R.U. Mustafa; Loyola University New Orleans, United States; email: rulmust@loyno.edu},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798350351309},
	language = {English},
	abbrev_source_title = {IEEE Digit. Platforms Soc. Harms, DPSH},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Hamami202436,
	author = {Hamami, Faqih and Dahlan, Iqbal Ahmad},
	title = {Enhancing Cyberbullying Detection with Stacked Model for Limited Data},
	year = {2024},
	journal = {Proceedings - ICE3IS 2024: 4th International Conference on Electronic and Electrical Engineering and Intelligent System: Leading-Edge Technologies for Sustainable Societies},
	pages = {36 - 41},
	doi = {10.1109/ICE3IS62977.2024.10775746},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215131468&doi=10.1109%2FICE3IS62977.2024.10775746&partnerID=40&md5=1a19bac5f7d7c52ec4d84abc271addad},
	affiliations = {Telkom University, School of Industrial and System Engineering, Bandung, West Java, Indonesia; Indonesia Defense University, Military Engineering Faculty, Bogor, West Java, Indonesia},
	abstract = {The rapid growth of internet users in Indonesia has significantly influenced various aspects of communication, economy, and culture. However, this increase in internet access has also led to a rise in cyberbullying cases due to the ease of access and anonymity provided by online media platforms. Instagram is one of the online platforms commonly used by students, where bullying activities often occur within the school-age range. This study explores cyberbullying detection, utilizing sentiment analysis, a machine learning technique, to distinguish cyberbullying patterns. By leveraging limited datasets from Instagram, this research aims to develop a classification model using stacking techniques to maintain high model accuracy. The research aims to contribute to the architecture of limited data model. Based on experimental results with three scenarios, it was found that the stacking model had better accuracy compared to a single model, with an accuracy rate reaching 96.25%. The model's accuracy was also superior compared to ensemble learning such as boosting and bagging algorithms e.g. Random Forest and Gradient Boosting. Compared to previous studies with the same data volume, there was a margin of accuracy improvement of up to 6.25%. © 2024 IEEE.},
	author_keywords = {cyberbullying; ensemble learning; machine learning; stacking},
	keywords = {Anonymity; Contrastive Learning; Federated learning; Phishing; Cyber bullying; Ensemble learning; Indonesia; Internet access; Internet users; Limited data; Machine-learning; Modeling accuracy; Rapid growth; Stackings; Adversarial machine learning},
