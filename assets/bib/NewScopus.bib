@ARTICLE{Fortuna2021,
	author = {Fortuna, Paula and Soler-Company, Juan and Wanner, Leo},
	title = {How well do hate speech, toxicity, abusive and offensive language classification models generalize across datasets?},
	year = {2021},
	journal = {Information Processing and Management},
	volume = {58},
	number = {3},
	pages = {},
	doi = {10.1016/j.ipm.2021.102524},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100516282&doi=10.1016%2Fj.ipm.2021.102524&partnerID=40&md5=1cc4750074661cdc822a58b805f5c89e},
	affiliations = {Universitat Pompeu Fabra Barcelona, Natural Language Processing Group, Barcelona, Barcelona, Spain; Institució Catalana de Recerca i Estudis Avançats, Barcelona, Barcelona, Spain},
	abstract = {A considerable body of research deals with the automatic identification of hate speech and related phenomena. However, cross-dataset model generalization remains a challenge. In this context, we address two still open central questions: (i) to what extent does the generalization depend on the model and the composition and annotation of the training data in terms of different categories?, and (ii) do specific features of the datasets or models influence the generalization potential? To answer (i), we experiment with BERT, ALBERT, fastText, and SVM models trained on nine common public English datasets, whose class (or category) labels are standardized (and thus made comparable), in intra- and cross-dataset setups. The experiments show that indeed the generalization varies from model to model and that some of the categories (e.g., ‘toxic’, ‘abusive’, or ‘offensive’) serve better as cross-dataset training categories than others (e.g., ‘hate speech’). To answer (ii), we use a Random Forest model for assessing the relevance of different model and dataset features during the prediction of the performance of 450 BERT, 450 ALBERT, 450 fastText, and 348 SVM binary abusive language classifiers (1698 in total). We find that in order to generalize well, a model already needs to perform well in an intra-dataset scenario. Furthermore, we find that some other parameters are equally decisive for the success of the generalization, including, e.g., the training and target categories and the percentage of the out-of-domain vocabulary. © 2021 Elsevier Ltd},
	author_keywords = {Classification; Generalization; Hate speech; Offensive language},
	keywords = {Automation; Decision trees; Support vector machines; Classification models; Model generalization; Offensive languages; Random forest modeling; SVM model; Training data; Classification (of information)},
	correspondence_address = {P. Fortuna; Natural Language Processing Group, Department of Communication and Information Technologies, Pompeu Fabra University, Spain; email: paula.fortuna@upf.edu},
	publisher = {Elsevier Ltd},
