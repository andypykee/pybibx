@CONFERENCE{Li2025,
	author = {Li, Yuanyong and Guo, Sanchuan and Zhang, Xi},
	title = {Hear ALL Parties: Detecting Implicit Hate Speech using Contrastive In-context Learning},
	year = {2025},
	pages = {},
	doi = {10.1109/IJCNN64981.2025.11228739},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105023984152&doi=10.1109%2FIJCNN64981.2025.11228739&partnerID=40&md5=ef64102e01edf721169253a20eda21ee},
	affiliations = {Beijing University of Posts and Telecommunications, Beijing, Beijing, China},
	abstract = {The spread of hate speech on social media has caused serious consequences. Despite massive research efforts to enhance the detection performance to mitigate the negative impacts, it is still challenging to identify implicit hate speech due to its complex and veiled nature. In this paper, we focus on detecting implicit hate speech with large language models (LLMs), leveraging LLMs' vast knowledge base and advanced contextual understanding. We adopt the in-context learning (ICL) paradigm with few-shot examples to avoid the large cost of training or fine-tuning the models. While existing ICL frameworks generally select semantic-similarity examples, the importance of the example diversity issue is ignored. We claim that LLMs should be provided semantic-relevant but diverse examples from the training set as demonstrations, and thus propose a novel contrastive in-context learning framework to make LLMs learn from all parties to make better classification decisions. Moreover, our framework can dynamically generate prompts for each input sample and thus lead to adaptive classification criteria, naturally adapting to complex and subtle nature of the implicit hate speech. Extensive evaluations on two datasets demonstrate that our framework achieves state-of-the-art performance, significantly surpassing existing LLM-based approaches and baselines. © 2025 IEEE.},
	correspondence_address = {S. Guo; Key Laboratory of Trustworthy Distributed Computing and Service, Beijing University of Posts and Telecommunications, Beijing, China; email: guosc@bupt.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
