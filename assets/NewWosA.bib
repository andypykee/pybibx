@inproceedings{ WOS:001545317500016,
Author = {Mishra, Ritwik and Yadav, Ajeet and Shah, Rajiv Ratn and Kumaraguru,
   Ponnurangam},
Editor = {Goyal, V and Kumar, N and Bhowmick, SS and Goyal, P and Goyal, N and Kumar, D},
Title = {Explaining Finetuned Transformers on Hate Speech Predictions Using
   Layerwise Relevance Propagation},
Booktitle = {BIG DATA AND ARTIFICIAL INTELLIGENCE, BDA 2023},
Series = {Lecture Notes in Computer Science},
Year = {2023},
