@CONFERENCE{Jiang2021469,
	author = {Jiang, Aiqi and Zubiaga, Arkaitz},
	title = {Qmul-sds at exist: Leveraging pre-trained semantics and lexical features for multilingual sexism detection in social networks},
	year = {2021},
	journal = {CEUR Workshop Proceedings},
	volume = {2943},
	pages = {469 - 483},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85115314206&partnerID=40&md5=ccc564b0dc3f40bef06954ba8d8aba2e},
	affiliations = {Queen Mary University of London, London, United Kingdom},
	abstract = {Online sexism is an increasing concern for those who experi- ence gender-based abuse in social media platforms as it has affected the healthy development of the Internet with negative impacts in society. The EXIST shared task proposes the first task on sEXism Identifica- tion in Social neTworks (EXIST) at IberLEF 2021 [30]. It provides a benchmark sexism dataset with Twitter and Gab posts in both English and Spanish, along with a task articulated in two subtasks consisting in sexism detection at different levels of granularity: Subtask 1 Sexism Iden- tification is a classical binary classification task to determine whether a given text is sexist or not, while Subtask 2 Sexism Categorisation is a finer-grained classification task focused on distinguishing different types of sexism. In this paper, we describe the participation of the QMUL-SDS team in EXIST. We propose an architecture made of the last 4 hidden states of XLM-RoBERTa and a TextCNN with 3 kernels. Our model also exploits lexical features relying on the use of new and existing lexicons of abusive words, with a special focus on sexist slurs and abusive words targeting women. Our team ranked 11th in Subtask 1 and 4th in Sub- task 2 among all the teams on the leaderboard, clearly outperforming the baselines offered by EXIST. © 2021 CEUR-WS. All rights reserved.},
	author_keywords = {Abusive Language Detection; Hate Speech Detection; Multilingual Text Classification; Sexism Identification; Social Network},
	keywords = {Classification (of information); Natural language processing systems; Semantic Web; Semantics; Speech recognition; Text processing; Abusive language detection; Hate speech detection; Language detection; Multilingual text classification; Multilingual texts; Sexism identification; Social network; Speech detection; Subtask; Text classification; Social networking (online)},
