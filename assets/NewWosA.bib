@inproceedings{ WOS:000684216300029,
Author = {Hadj Ameur, Mohamed Seghir and Aliane, Hassina},
Editor = {Shaalan, K and ElBeltagy, SR},
Title = {AraCOVID19-MFH: Arabic COVID-19 Multi-label Fake News \& Hate Speech
   Detection Dataset},
