@inproceedings{ WOS:001431695500011,
Author = {Alacam, Oezge and Hoeken, Sanne and Zarriess, Sina},
Editor = {Al-Onaizan, Y and Bansal, M and Chen, YN},
Title = {Eyes Don't Lie: Subjective Hate Annotation and Detection with Gaze},
Booktitle = {2024 CONFERENCE ON EMPIRICAL METHODS IN NATURAL LANGUAGE PROCESSING,
   EMNLP 2024},
Year = {2024},
Pages = {187-205},
Note = {29th Conference on Empirical Methods in Natural Language Processing,
   Miami, FL, NOV 12-16, 2024},
Organization = {ByteDance Inc; Intuit Inc; Adobe Inc; Florida International University;
   Figma Inc},
Abstract = {Hate speech is a complex and subjective phenomenon. In this paper, we
   present a dataset (GAZE4HATE) that provides gaze data collected in a
   hate speech annotation experiment. We study whether the gaze of an
   annotator provides predictors of their subjective hatefulness rating,
   and how gaze features can improve Hate Speech Detection (HSD). We
   conduct experiments on statistical modeling of subjective hate ratings
   and gaze and analyze to what extent rationales derived from hate speech
   models correspond to human gaze and explanations in our data. Finally,
   we introduce MEANION, a first gaze-integrated HSD model. Our experiments
   show that particular gaze features like dwell time or fixation counts
   systematically correlate with annotators' subjective hate rating, and
   improve predictions of text-only hate speech models.},
