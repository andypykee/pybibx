	doi = {10.18653/v1/2025.naacl-short.37},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105027102604&doi=10.18653%2Fv1%2F2025.naacl-short.37&partnerID=40&md5=eeb75017a9043cd14be2bd0dbfcaca27},
	affiliations = {Macquarie University, Sydney, NSW, Australia; Virginia Polytechnic Institute and State University, Blacksburg, VA, United States; Northeastern University, Shenyang, Liaoning, China; Tongji University, Shanghai, China},
	abstract = {The prevalence of toxic behavior in online gaming communities necessitates robust detection methods to ensure user safety. We introduce GameTox, a novel dataset comprising 53K game chat utterances annotated for toxicity detection through intent classification and slot filling. This dataset captures the complex relationship between user intent and specific linguistic features that contribute to toxic interactions. We extensively analyze the dataset to uncover key insights into the nature of toxic speech in gaming environments. Furthermore, we establish baseline performance metrics using state-of-the-art natural language processing and large language models, demonstrating the dataset’s contribution towards enhancing the detection of toxic behavior and revealing the limitations of contemporary models. Our results indicate that leveraging both intent detection and slot filling provides a significantly more granular and context-aware understanding of harmful messages. This dataset serves as a valuable resource to train advanced models that can effectively mitigate toxicity in online gaming and foster healthier digital spaces. Our dataset is publicly available at: https://github.com/shucoll/GameTox. © 2025 Association for Computational Linguistics},
	keywords = {Arts computing; Behavioral research; Computational linguistics; Large datasets; Natural language processing systems; Speech communication; Speech recognition; Base-line performance; Complex relationships; Detection methods; Linguistic features; On-line gaming; Performance metrices; Robust detection; State of the art; Toxic interactions; Toxicity detection; Toxicity},
