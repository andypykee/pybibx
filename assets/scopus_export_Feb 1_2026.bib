@CONFERENCE{Thapa202571,
	author = {Thapa, Surendrabikram and Rauniyar, Kritesh and Jafri, Farhan Ahmad and Adhikari, Surabhi and Sarveswaran, K. and Bal, Bal Krishna and Veeramani, Hariram and Naseem, Usman},
	title = {Natural Language Understanding of Devanagari Script Languages: Language Identification, Hate Speech and its Target Detection},
	year = {2025},
	journal = {Proceedings - International Conference on Computational Linguistics, COLING},
	pages = {71 - 82},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217767646&partnerID=40&md5=9d20485e2235d74d2290da78fa0e45a9},
	affiliations = {Virginia Polytechnic Institute and State University, Blacksburg, VA, United States; Delhi Technological University, New Delhi, India; Jamia Millia Islamia, New Delhi, India; Columbia University, New York, NY, United States; University of Jaffna, Jaffna, Sri Lanka; Kathmandu University, Dhulikhel, Nepal; University of California, Los Angeles, Los Angeles, CA, United States; Macquarie University, Sydney, NSW, Australia},
	abstract = {The growing use of Devanagari-script languages such as Hindi, Nepali, Marathi, Sanskrit, and Bhojpuri in digital form including social media presents unique challenges for natural language understanding (NLU), particularly in language identification, hate speech detection, and target classification. To address these challenges, we organized a shared task with three subtasks: (i) identifying the language of Devanagari-script text, (ii) detecting hate speech, and (iii) classifying hate speech targets into individual, community, or organization. A curated dataset combining multiple corpora was provided, with splits for training, evaluation, and testing. The task attracted 113 participants, with 32 teams submitting models evaluated on accuracy, precision, recall, and macro F1-score. Participants applied innovative methods, including large language models, transformer models, and multilingual embeddings, to tackle the linguistic complexities of Devanagari-script languages. This paper summarizes the shared task, datasets, and results, and aims to contribute to advancing NLU for low-resource languages and fostering inclusive, culturally aware natural language processing (NLP) solutions. © 2025 International Committee on Computational Linguistics.},
	keywords = {Electric transformer testing; Large datasets; Natural language processing systems; Speech recognition; Translation (languages); Digital forms; Language identification; Natural language understanding; Script Languages; Social media; Speech detection; Speech targets; Subtask; Target Classification; Targets detection; Computational linguistics},
	editor = {Sarveswaran, K. and Thapa, S. and Shams, S. and Vaidya, A. and Bal, B.K.},
	publisher = {Association for Computational Linguistics (ACL)},
	issn = {29512093},
