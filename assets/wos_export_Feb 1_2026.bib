@article{ WOS:001638682600001,
Author = {Lamin, Nor Zakiah and Aziz, Azwa Abdul},
Title = {Cross-Lingual Sentiment Analysis in Low-Resource Languages: A Recent
   Review on Tasks, Methods and Challenges},
Journal = {INTERNATIONAL JOURNAL OF ADVANCED COMPUTER SCIENCE AND APPLICATIONS},
