	title = {“Is Hate Lost in Translation?”: Evaluation of Multilingual LGBTQIA+ Hate Speech Detection},
	year = {2024},
	journal = {ALTA 2024 - Proceedings of the 22nd Annual Workshop of the Australasian Language Technology Association},
