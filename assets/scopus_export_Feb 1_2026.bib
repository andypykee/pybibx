	author = {Singhal, Mayank and Komal, null and Zeeshan, Mohammad and Saini, Ishika and Nagrath, Preeti},
	title = {Hate Speech Detection Using Glove and BERT},
	year = {2025},
	journal = {Communications in Computer and Information Science},
