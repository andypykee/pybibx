Title = {UPB at SemEval-2022 Task 5: Enhancing UNITER with Image Sentiment and
   Graph Convolutional Networks for Multimedia Automatic Misogyny
   Identification},
Booktitle = {PROCEEDINGS OF THE 16TH INTERNATIONAL WORKSHOP ON SEMANTIC EVALUATION,
   SEMEVAL-2022},
