	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105027932531&doi=10.1049%2Ficp.2025.0160&partnerID=40&md5=04def7cd71900821509377d2b76b380c},
	affiliations = {Al-Esraa University, Medical Instrumentation Engineering Department, Baghdad, Baghdad, Iraq; Al-Farahidi University, Department of Medical Instrumentation Technical Engineering, Baghdad, Baghdad, Iraq; Uruk University, Medical Instrumentation Engineering Department, Baghdad, Iraq; Al-Kunooze University College, Technical Computer Engineering Department, Basra, Iraq; Al-Kitab University, Cybersecurity Technology Engineering Department, Kirkuk, Kirkuk, Iraq},
	abstract = {Hate speech on social media has become a worldwide concern in recent years. In addition to scientific interest, several governments and organizations have invested much in hate speech detection techniques. Text categorization, a key job in Natural Language Processing (NLP), has been successfully done using classical and deep learning models. Traditional approaches like Naïve Bayes, Logistic Regression, and Support Vector Machine (SVM) need human feature extraction, whereas CNN, RNN, and transformers automatically learn features from raw data. Even though there is a lot of research on this issue, it is difficult to assess each offered technique since each has pros and cons. Combining the outputs of numerous classifiers to enhance classification results is a noteworthy effort. This paper suggests fusing machine learning classifiers with deep learning models to aggregate predictions to solve this problem. This methodology is tested using accuracy and F1-score, comparing ELMo, BERT, CNN, and fusion-based models. Model fusion considerably enhances classification performance, suggesting it might be used in hate speech detection studies. © The Institution of Engineering & Technology 2024.},
	author_keywords = {HATE SPEECH; NLP; RNN; SVM; TWITTER},
