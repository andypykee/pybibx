@CONFERENCE{Li202482,
	author = {Li, Chenhao and Long, Jun},
	title = {TPC: One Investigation Reveals the Exploration of Offensive Language},
	year = {2024},
	journal = {Proceedings - 2024 International Conference on Virtual Reality and Visualization, ICVRV 2024},
	pages = {82 - 87},
	doi = {10.1109/ICVRV62410.2024.00024},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105009240387&doi=10.1109%2FICVRV62410.2024.00024&partnerID=40&md5=e671d0b300e3dcea27a1178687092ede},
	affiliations = {Xinjiang University, Urumqi, Xinjiang, China; Central South University, Changsha, Hunan, China},
	abstract = {The Twin-Problem-Channel (TPC) method leverages few-shot learning to identify offensive language within a multi-turn dialogue QA framework. By integrating natural language instructions with corresponding sentences, it aids models in annotating and comprehending text. Instruction fine-tuning is applied to the T5 model, allowing it to extract more information from the sentence, enhancing its ability to detect offensive content. Trained on large datasets such as Hasoc, OLID, and social media data from Facebook and Twitter, T5 outperforms BERT and GPT-3 in aggressive language recognition. The instruction fine-tuning approach improves model efficiency and enables task adaptation without retraining, demonstrating strong generalization to unseen tasks. Experimental results show that the TPC method outperforms several baseline models, achieving new state-of-the-art performance on the OLID, TRAC, and Hasoc datasets. © 2024 IEEE.},
	author_keywords = {instruction tuning; large language model; offensive language; question answer},
