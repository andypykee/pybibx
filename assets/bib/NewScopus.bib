	title = {Exploring the Emotional Dimension of French Online Toxic Content},
	year = {2024},
	journal = {2024 Joint International Conference on Computational Linguistics, Language Resources and Evaluation, LREC-COLING 2024 - Main Conference Proceedings},
	pages = {6945 - 6954},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195896047&partnerID=40&md5=f24a6f6a0ad4e77ef96b303b366f1780},
	affiliations = {ONERA Office National d'Etudes et Recherches Aerospatiales, Palaiseau, Ile-de-France, France},
	abstract = {One of the biggest hurdles for the effective analysis of data collected on social platforms is the need for deeper insights on the content of this data. Emotion annotation can bring new perspectives on this issue and can enable the identification of content-specific features. This study aims at investigating the ways in which variation in online toxic content can be explored through emotions detection. The paper describes the emotion annotation of three different corpora in French which all belong to toxic content (extremist content, sexist content and hateful content respectively). To this end, first a fine-grained annotation parser of emotions was used to automatically annotate the data sets. Then, several empirical studies were carried out to characterize the content in the light of obtained emotional categories. Results suggest that emotion annotations can provide new insights for online content analysis and stronger empirical background for automatic toxic content detection. © 2024 ELRA Language Resource Association: CC BY-NC 4.0.},
