@CONFERENCE{Pujari20226703,
	author = {Pujari, Rajkumar and Oveson, Erik and Kulkari, Priyanka and Nouri, Elnaz},
	title = {Reinforcement Guided Multi-Task Learning Framework for Low-Resource Stereotype Detection},
	year = {2022},
	journal = {Proceedings of the Annual Meeting of the Association for Computational Linguistics},
	volume = {1},
	pages = {6703 - 6712},
	doi = {10.18653/v1/2022.acl-long.462},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85136928129&doi=10.18653%2Fv1%2F2022.acl-long.462&partnerID=40&md5=000b37e3abc934698e3cab21bb113482},
	affiliations = {Purdue University, West Lafayette, IN, United States; Microsoft Corporation, Redmond, WA, United States; Microsoft Research, Redmond, WA, United States},
	abstract = {As large Pre-trained Language Models (PLMs) trained on large amounts of data in an unsupervised manner become more ubiquitous, identifying various types of bias in the text has come into sharp focus. Existing 'Stereotype Detection' datasets mainly adopt a diagnostic approach toward large PLMs. Blodgett et al. (2021a) show that there are significant reliability issues with the existing benchmark datasets. Annotating a reliable dataset requires a precise understanding of the subtle nuances of how stereotypes manifest in text. In this paper, we annotate a focused evaluation set for 'Stereotype Detection' that addresses those pitfalls by de-constructing various ways in which stereotypes manifest in text. Further, we present a multi-task model that leverages the abundance of data-rich neighboring tasks such as hate speech detection, offensive language detection, misogyny detection, etc., to improve the empirical performance on 'Stereotype Detection'. We then propose a reinforcement-learning agent that guides the multi-task learning model by learning to identify the training examples from the neighboring tasks that help the target task the most. We show that the proposed models achieve significant empirical gains over existing baselines on all the tasks. © 2022 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Large dataset; Learning systems; Speech recognition; Benchmark datasets; Diagnostic approach; Language model; Large amounts of data; Learning frameworks; Multi-task model; Multitask learning; Offensive languages; Sharp focus; Speech detection; Reinforcement learning},
	editor = {Muresan, S. and Nakov, P. and Villavicencio, A.},
