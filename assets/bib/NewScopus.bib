@ARTICLE{Maity2025415,
	author = {Maity, Krishanu and Ghosh, Nilabja and Jain, Raghav and Saha, Sriparna and Bhattacharyya, Pushpak},
	title = {StereoHate: Toward identifying stereotypical bias and target group in hate speech detection},
	year = {2025},
	journal = {Natural Language Processing},
	volume = {31},
	number = {2},
	pages = {415 - 434},
	doi = {10.1017/nlp.2024.29},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105023364081&doi=10.1017%2Fnlp.2024.29&partnerID=40&md5=7eb20b932041401cc17049f1c4595dc4},
	affiliations = {Indian Institute of Technology Patna, Department of CSE, Patna, BR, India; Ramakrishna Mission Vivekananda Educational and Research Institute, Department of Computer Science, Howrah, WB, India; Indian Institute of Technology Bombay, Department of CSE, Mumbai, MH, India},
	abstract = {Though social media helps spread knowledge more effectively, it also stimulates the propagation of online abuse and harassment, including hate speech. It is crucial to prevent hate speech since it may have serious adverse effects on both society and individuals. Therefore, it is not only important for models to detect these speeches but to also output explanations of why a given text is toxic. While plenty of research is going on to detect online hate speech in English, there is very little research on low-resource languages like Hindi and the explainability aspect of hate speech. Recent laws like the “right to explanations” of the General Data Protection Regulation have spurred research in developing interpretable models rather than only focusing on performance. Motivated by this, we create the first interpretable benchmark hate speech corpus hate speech explanation (HHES) in the Hindi language, where each hate post has its stereotypical bias and target group category. Providing descriptions of internal stereotypical bias as an explanation of hate posts makes a hate speech detection model more trustworthy. Current work proposes a commonsense-aware unified generative framework, CGenEx, by reframing the multitask problem as a text-to-text generation task. The novelty of this framework is it can solve two different categories of tasks (generation and classification) simultaneously. We establish the efficacy of our proposed model (CGenEx-fuse) on various evaluation metrics over other baselines when applied to the Hindi HHES dataset. ©C The Author(s), 2024.},
	author_keywords = {explainability; hate speech; multitask; stereotypical bias},
	keywords = {Social networking (online); Speech analysis; Speech communication; Speech processing; Text processing; Adverse effect; Explainability; General data protection regulations; Hate speech; Low resource languages; Multitask; Social media; Speech detection; Stereotypical bias; Target group; Multitasking},
	correspondence_address = {K. Maity; Department of CSE, Indian Institute of Technology Patna, Patna, India; email: krishanumaity@gmail.com},
	publisher = {Cambridge University Press},
	language = {English},
