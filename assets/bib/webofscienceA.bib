   Bishesh},
Editor = {Sarveswaran, K and Vaidya, A and Bal, BK and Shams, S and Thapa, S},
Title = {NLPineers@ NLU of Devanagari Script Languages 2025: Hate Speech
   Detection using Ensembling of BERT-based models},
