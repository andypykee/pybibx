@ARTICLE{Kharrat202563,
	author = {Kharrat, Ons and Mohamed, Fatma Alzahra and Mtimet, Ikram and Benamor, Nour and Fourati, Chayma},
	title = {HateTune: Tunisian Dialect Hate Speech Detection Dataset},
	year = {2025},
	journal = {Communications in Computer and Information Science},
	volume = {2339 CCIS},
	pages = {63 - 73},
	doi = {10.1007/978-3-031-79164-2_6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85219193058&doi=10.1007%2F978-3-031-79164-2_6&partnerID=40&md5=67391c2cfc68905315f19b9a5b7dd733},
	affiliations = {South Mediterranean University, Software Engineering Department, Tunis, Tunis, Tunisia},
	abstract = {In Tunisia, citizens use social media platforms as a space to exercise freedom of speech. However, unchecked and complete freedom of expression can fuel the spread of hateful speech, which is devastating not only for those targeted but also for our society. This alarming situation evokes the need for limiting the spread of hateful content by working on hate speech detection in “Derja”, which is the tunisian dialect. Used as a means of communication in daily life and on social media platforms, this dialect is a mixture of many languages, including Arabic, French, and Amazighi, and it can be written using Arabic letters. Due to the complexity of this language, a significant lack of publicly available, large, and annotated datasets for hate speech detection in Tunisian dialect written in Arabic letters is noticeable, making “Tunisian Derja” an underrepresented dialect. In this paper, we introduce the largest publicly available dataset, which consists of more than 12k comments manually annotated as Hate, and Neutral. We also provide an in-depth explanation of the processes of data collection, annotation, and pre-processing. Moreover, we undertake a comprehensive evaluation of the dataset’s efficacy through various machine learning models, including Support Vector Machines (SVM), Random Forest, and XGBoost. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	author_keywords = {Arabic Letters; Hate Speech; Tunisian Dialect; Underrepresented},
	keywords = {Data assimilation; Large datasets; Linguistics; Speech recognition; Arabic letter; Daily lives; Freedom of speech; Hate speech; Social media platforms; Speech detection; Tunisia; Tunisian dialect; Underrepresented; Support vector machines},
	correspondence_address = {O. Kharrat; Software Engineering, Mediterranean Institute of Technology, Tunis, Lac 2, Tunisia; email: ons.kharrat@medtech.tn},
	editor = {Hdioud, B. and Aouragh, S.L.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
