@inproceedings{ WOS:001304560400032,
Author = {AlSukhni, Emad and AlAzzam, Iyad and Hanandeh, Sereen},
Book-Group-Author = {IEEE},
Title = {Offensive Language Detection of Arabic Tweets Using Deep Learning
   Algorithm},
