DOI = {10.1145/3670105.3670179},
ISBN = {979-8-4007-1675-1},
Keywords = {Chinese cyber-violent speech; BERT; Hanyu Pinyin; Emotion},
Research-Areas = {Computer Science; Telecommunications},
Web-of-Science-Categories  = {Computer Science, Interdisciplinary Applications; Telecommunications},
