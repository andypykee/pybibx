@CONFERENCE{Manzi2024,
	author = {Manzi, Federica and Weber-Genzel, Leon and Plank, Barbara},
	title = {Fine-grained Sexism Detection in Italian Newspapers},
	year = {2024},
	journal = {CEUR Workshop Proceedings},
	volume = {3878},
	pages = {},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85214363019&partnerID=40&md5=14c55b7254aa96d7fe092dff723cf246},
	affiliations = {Ludwig-Maximilians-Universität München, Munich, Bayern, Germany; IT-Universitetet i København, Copenhagen, Denmark},
	abstract = {In recent years, tasks revolving around hate speech detection have experienced a growing interest in the field of Natural Language Processing. Two main trends stand out in the context of sexism recognition: the focus on overt forms of sexism such as misogyny on social media and tackling the problem as a text classification task. The main objective of this work is to introduce a new approach to tackle sexism recognition as a sequence labelling task, operating on the token level rather than the document level. To achieve this goal, we introduce (i) the FGSDI (Fine-Grained Sexism Detection in Italian) corpus, containing Italian newspaper articles annotated with fine-grained linguistic markers of sexism, and (ii) a two-step pipeline that sequentially performs sexism detection on the sentence level and sexism classification on the token one. Our primary findings include that (i) tackling the task of sexism recognition as a sequence labelling task is possible, however, a large amount of labelled data is needed; (ii) leveraging few-shot learning for sexism detection proves to be an effective solution in scenarios where only a limited amount of data is available; (iii) the proposed pipeline approach allows for better results compared to the baseline by doubling the overall precision and achieving a better F1-score. © 2024 CEUR-WS. All rights reserved.},
	author_keywords = {Hate-speech detection; Natural Language Processing; Sexism recognition; Token classification; Transformers},
	keywords = {Labeled data; Linguistics; Metadata; Newsprint; Fine grained; Hate-speech detection; Language processing; Natural language processing; Natural languages; Sequence Labeling; Sexism recognition; Speech detection; Token classification; Transformer; Natural language processing systems},
	editor = {Dell'Orletta, F. and Lenci, A. and Montemagni, S. and Sprugnoli, R.},
