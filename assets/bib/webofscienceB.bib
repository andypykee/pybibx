Title = {Improving Covert Toxicity Detection by Retrieving and Generating
   References},
Booktitle = {PROCEEDINGS OF THE 8TH WORKSHOP ON ONLINE ABUSE AND HARMS, WOAH 2024},
Year = {2024},
Pages = {266-274},
