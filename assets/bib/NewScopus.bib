	year = {2023},
	journal = {Proceedings - 22nd IEEE International Conference on Machine Learning and Applications, ICMLA 2023},
	pages = {1487 - 1494},
	doi = {10.1109/ICMLA58977.2023.00224},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85190165640&doi=10.1109%2FICMLA58977.2023.00224&partnerID=40&md5=82ae9fd5ce44faceb9e97181f8a9a38c},
