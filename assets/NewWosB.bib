   NETWORK, DEC 12-13, 2020},
Organization = {ACL Special Interest Grp Lexicon},
Abstract = {This paper presents our hierarchical multi-task learning (HMTL) and
   multi-task learning (MTL) approaches for improving the text encoder in
   Sub-tasks A, B, and C of Multilingual Offensive Language Identification
   in Social Media (SemEval-2020 Task 12). We show that using the MTL
   approach can greatly improve the performance of complex problems, i.e.
   Sub-tasks B and C. Coupled with a hierarchical approach, the
   performances are further improved. Overall, our best model, HMTL
   outperforms the baseline model by 3\% and 2\% of Macro F-score in
   Sub-tasks B and C of OffensEval 2020, respectively.},
