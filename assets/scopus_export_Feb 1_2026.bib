@ARTICLE{Hoffmann20251171,
	author = {Hoffmann, Michael Peter and Fillies, Jan and John, Jophin and Maronikolakis, Antonis and Navilarekal, Ajay and Udupa, Sahana and Hammer, Nicolay J.},
	title = {Temporal Robustness in Hate Speech Detection: Updating German Classifiers with Advanced AI Infrastructures},
	year = {2025},
	journal = {Frontiers in Artificial Intelligence and Applications},
	volume = {413},
	pages = {1171 - 1178},
	doi = {10.3233/FAIA250929},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105024452654&doi=10.3233%2FFAIA250929&partnerID=40&md5=aa850f72723ecb2feb21b306bea0712d},
	affiliations = {Leibniz-Rechenzentrum München, Garching near Munich, Garching bei Munchen, Bayern, Germany; Freie Universität Berlin, Berlin, Berlin, Germany; Ludwig-Maximilians-Universität München, Munich, Bayern, Germany; Ludwig-Maximilians-Universität München, Institute of Social and Cultural Anthropology, Munich, Bayern, Germany},
	abstract = {Over the past two decades, hate speech on social media has surged, causing significant harm and threatening democracies. Initially, research focused on English hate speech, but recent years have seen the development of non-English datasets and corresponding classifiers. However, these datasets are often small in size, with a specific topic of interest, and temporally misaligned, causing classifiers to quickly become outdated. Consequently, there is a growing need to understand how to efficiently update these outdated classifiers. Motivated by the AI4Dignity project, this study addresses the issue of diachronicity in hate speech detection, specifically focusing on German. The study conducts a series of experiments to explore multiple fine-tuning strategies for updating and improving outdated hate speech classifiers. Additionally, it examines the impact of different AI infrastructures (state-of-the-art GPU systems, Intel's Gaudi 2 and a Cerebras CS-2 system) on training times. The findings provide insights into the temporal robustness of different classifiers and respective updating approaches, as well as which AI infrastructure works best with each update approach. These insights may not only help efficiently maintain hate speech detection systems for social media but can also be useful for other areas, such as continuously supporting the reliable detection of hate speech in online gaming environments. © 2025 The Authors.},
	keywords = {Classification (of information); Social networking (online); Speech analysis; Speech communication; Detection system; Fine tuning; Reliable detection; Significant harm; Social media; Speech detection; State of the art; Training time; Tuning strategy; Updating approaches; Online systems},
	correspondence_address = {M. Hoffmann; Leibniz Supercomputing Centre, Garching near Munich, Germany; email: Michael.Hoffmann@lrz.de; J. John; Leibniz Supercomputing Centre, Garching near Munich, Germany; email: Jophin.John@lrz.de},
