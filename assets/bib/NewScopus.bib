@CONFERENCE{Justen202240,
	author = {Justen, Lennart J. and Muller, Kilian and Niemann, Marco and Becker, Jörg},
	title = {No Time like the Present: Effects of Language Change on Automated Comment Moderation},
	year = {2022},
	journal = {Proceedings - 2022 IEEE 24th Conference on Business Informatics, CBI 2022},
	volume = {1},
	pages = {40 - 49},
	doi = {10.1109/CBI54897.2022.00012},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85142801407&doi=10.1109%2FCBI54897.2022.00012&partnerID=40&md5=e85f2c7b6f7822ea3b6809832f839785},
	affiliations = {University of Wisconsin-Madison, Madison, WI, United States; European Research Center for Information Systems (ERCIS), Munster, Munster, Germany},
	abstract = {The spread of online hate has become a significant problem for newspapers that host comment sections. As a result, there is growing interest in using machine learning (ML) and natural language processing (NLP) for (semi-) automated abusive language detection to avoid manual comment moderation costs or having to shut down comment sections altogether. However, much of the past work on abusive language detection assumes that classifiers operate in a static language environment, despite language and news being in a state of constant flux. In this paper, we show using a new German newspaper comments dataset that the classifiers trained with naive ML techniques like a random test-train split will underperform on future data, and that a time-stratified evaluation split is more appropriate. We also show that a classifier's performance rapidly degrades when evaluated on data from a different period than the training data. Our findings suggest that it is necessary to consider the temporal dynamics of language when developing an abusive language detection system or risk deploying a model that will quickly become defunct. © 2022 IEEE.},
	author_keywords = {abusive language detection; Auto-Ml; concept drift; Covid-19; natural language processing},
	keywords = {Automation; Classification (of information); Learning algorithms; Natural language processing systems; Statistical tests; Abusive language detection; Auto-ml; Concept drifts; Covid-19; Language detection; Language processing; Learning languages; Machine-learning; Natural language processing; Natural languages; Newsprint},
