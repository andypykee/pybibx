@inproceedings{ WOS:001327645500035,
Author = {Luu, Son T. and Kiet Van Nguyen and Ngan Luu-Thuy Nguyen},
Editor = {Fujita, H and Selamat, A and Lin, JC and Ali, M},
Title = {A Large-Scale Dataset for Hate Speech Detection on Vietnamese Social
   Media Texts},
Booktitle = {ADVANCES AND TRENDS IN ARTIFICIAL INTELLIGENCE. ARTIFICIAL INTELLIGENCE
   PRACTICES, IEA/AIE 2021, PT I},
