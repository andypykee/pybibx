	title = {KaustubhSharedTask@LT-EDI 2023: Homophobia-Transphobia Detection in Social Media Comments with NLPAUG-driven Data Augmentation},
	year = {2023},
	journal = {LTEDI 2023 - 3rd Workshop on Language Technology for Equality, Diversity and Inclusion, associated with the 14th International Conference on Recent Advances in Natural Language Processing, RANLP 2023 - Proceedings},
	pages = {71 - 77},
	doi = {10.26615/978-954-452-084-7_010},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85184996588&doi=10.26615%2F978-954-452-084-7_010&partnerID=40&md5=5d65fe6ab1b2ca268287b7fd3aa48899},
	affiliations = {Indian Institute of Technology Kharagpur, Kharagpur, WB, India; University of Galway, Galway, Connacht, Ireland; University of Galway, School of Computer Science, Galway, Connacht, Ireland},
	abstract = {Our research in Natural Language Processing (NLP) aims to detect hate speech comments specifically targeted at the LGBTQ+ community within the YouTube platform shared task conducted by the LT-EDI workshop<sup>1</sup>. The dataset provided by the organizers exhibited a high degree of class imbalance, and to mitigate this, we employed NLPAUG, a data augmentation library. We employed several classification methods and reported the results using recall, precision, and F1-score metrics. The classification models discussed in this paper include a Bidirectional Long Short-Term Memory (BiLSTM) model trained with Word2Vec embeddings, a BiLSTM model trained with Twitter GloVe embeddings, transformer models such as BERT, DistilBERT, RoBERTa, and XLM-RoBERTa, all of which were trained and fine-tuned. We achieved a weighted F1-score of 0.699 on the test data and secured fifth place in task B with 7 classes for the English language. © 2023 LTEDI 2023 - 3rd Workshop on Language Technology for Equality, Diversity and Inclusion, associated with the 14th International Conference on Recent Advances in Natural Language Processing, RANLP 2023 - Proceedings. All rights reserved.},
	keywords = {Natural language processing systems; Social networking (online); Speech recognition; Class imbalance; Classification methods; Data augmentation; Embeddings; F1 scores; Language processing; Memory modeling; Natural languages; Social media; YouTube},
