   Fallatah, Omaima, Umm Al Qura Univ, Coll Comp, Dept Data Sci, Mecca, Saudi Arabia.},
ISSN = {2158-107X},
EISSN = {2156-5570},
Keywords = {Arabic hate speech detection; large language models (LLMs); in-context
   learning; Arabic NLP},
Research-Areas = {Computer Science},
