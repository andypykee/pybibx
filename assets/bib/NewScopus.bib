@CONFERENCE{Acharya2025334,
	author = {Acharya, Darwin and Dawadi, Sundeep and Saud, Shivram and Regmi, Sunil},
	title = {Paramananda@NLU of Devanagari Script Languages 2025: Detection of Language, Hate Speech and Targets using FastText and BERT},
	year = {2025},
	journal = {Proceedings - International Conference on Computational Linguistics, COLING},
	pages = {334 - 338},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217801312&partnerID=40&md5=8809ea32643cfcaebf332baaa5953ff4},
	affiliations = {Kathmandu University, Dhulikhel, Nepal},
	abstract = {This paper presents a comparative analysis of FastText and BERT-based approaches for Natural Language Understanding (NLU) tasks in Devanagari script languages. We evaluate these models on three critical tasks: language identification, hate speech detection, and target identification across five languages: Nepali, Marathi, Sanskrit, Bhojpuri, and Hindi. Our experiments, although with a raw tweet dataset but extracting only the Devanagari script, demonstrate that while both models achieve exceptional performance in language identification (F1 scores > 0.99), they show varying effectiveness in hate speech detection and target identification tasks. FastText with augmented data outperforms BERT in hate speech detection (F1 score: 0.8552 vs. 0.5763), while BERT shows superior performance in target identification (F1 score: 0.5785 vs. 0.4898). These findings contribute to the growing body of research on NLU for low-resource languages and provide insights into model selection for specific tasks in Devanagari script processing. © 2025 International Committee on Computational Linguistics.},
	keywords = {Modeling languages; Speech recognition; Translation (languages); Comparative analyzes; Detection/identification; F1 scores; Language identification; Natural language understanding; Performance; Script Languages; Speech detection; Speech targets; Target's identifications; Computational linguistics},
