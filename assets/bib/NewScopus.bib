	doi = {10.18653/v1/2021.woah-1.20},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85132977035&doi=10.18653%2Fv1%2F2021.woah-1.20&partnerID=40&md5=3bfb42896841cbd07ae5c5da15537807},
	affiliations = {Universiteit Maastricht, Maastricht, Limburg, Netherlands; Universiteit Maastricht, Maastricht, Limburg, Netherlands; Studio Europa, Maastricht, Netherlands},
	abstract = {Abusive language is a growing phenomenon on social media platforms. Its effects can reach beyond the online context, contributing to mental or emotional stress on users. Automatic tools for detecting abuse can alleviate the issue. In practice, developing automated methods to detect abusive language relies on good quality data. However, there is currently a lack of standards for creating datasets in the field. These standards include definitions of what is considered abusive language, annotation guidelines and reporting on the process. This paper introduces an annotation framework inspired by legal concepts to define abusive language in the context of online harassment. The framework uses a 7-point Likert scale for labelling instead of class labels. We also present ALYT - a dataset of Abusive Language on YouTube. ALYT includes YouTube comments in English extracted from videos on different controversial topics and labelled by Law students. The comments were sampled from the actual collected data, without artificial methods for increasing the abusive content. The paper describes the annotation process thoroughly, including all its guidelines and training steps. © 2021 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Automated methods; Automatic tools; Emotional stress; Legal concepts; Likert scale; Mental stress; Quality data; Social media; Social media platforms; YouTube; Social networking (online)},
