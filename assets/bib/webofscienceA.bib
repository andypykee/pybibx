@inproceedings{ WOS:000889373500017,
Author = {Rahman, Afridi Ibn and Farhan and Akhand, Zebel-E-Noor and Noor, Md Asad
   Uzzaman and Islam, Jubayer and Mahtab, Md. Motahar and Mehedi, Md
   Humaion Kabir and Rasel, Annajiat Alim},
Editor = {Singh, M and Tyagi, V and Gupta, PK and Flusser, J and Oren, T},
Title = {Comparative Analysis on Joint Modeling of Emotion and Abuse Detection in
   Bangla Language},
Booktitle = {ADVANCES IN COMPUTING AND DATA SCIENCES (ICACDS 2022), PT II},
Series = {Communications in Computer and Information Science},
Year = {2022},
Volume = {1614},
