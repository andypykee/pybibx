@inproceedings{ WOS:001338048900022,
Author = {Muhammad, Iqbal Zulfikar and Nasrun, Muhammad and Setianingsih, Casi},
Book-Group-Author = {IEEE},
Title = {Hate Speech Detection using Global Vector and Deep Belief Network
   Algorithm},
