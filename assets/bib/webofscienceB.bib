@inproceedings{ WOS:001328573200015,
Author = {Komamizu, Takahiro},
Editor = {Strauss, C and Amagasa, T and Kotsis, G and Tjoa, AM and Khalil, I},
Title = {Towards Ensemble-Based Imbalanced Text Classification Using Metric
   Learning},
Booktitle = {DATABASE AND EXPERT SYSTEMS APPLICATIONS, DEXA 2023, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2023},
