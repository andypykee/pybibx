Affiliation = {Martins, R (Corresponding Author), Univ Minho, Dept Informat, Algoritmi Ctr, Braga, Portugal.
   Martins, Ricardo; Gomes, Marco; Almeida, Jose Joao; Novais, Paulo; Henriques, Pedro, Univ Minho, Dept Informat, Algoritmi Ctr, Braga, Portugal.},
DOI = {10.1109/BRACIS.2018.00019},
