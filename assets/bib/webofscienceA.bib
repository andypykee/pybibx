   da S. M. and Silva, V, Felix Leonel and Carvalho, Eduarda Abreu and
   Freitas, Larissa and Brisolara, Ulisses},
Book-Group-Author = {IEEE},
Title = {Sabia in Action: An Investigation of its Abilities in Aspect-Based
   Sentiment Analysis, Hate Speech Detection, Irony Detection, and
   Question-Answering},
Booktitle = {2024 INTERNATIONAL JOINT CONFERENCE ON NEURAL NETWORKS, IJCNN 2024},
