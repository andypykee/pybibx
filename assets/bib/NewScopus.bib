@CONFERENCE{Bautista2025363,
	author = {Bautista, Carlo Gabriel and Canicon, Jan Ambro and Saril, Dean Miguel and Edralin, John Rey and Chu, Shirley B.},
	title = {Detecting Abusive Tweets about the Presidential Election},
	year = {2025},
	journal = {NLPIR 2024 - 2024 8th International Conference on Natural Language Processing and Information Retrieval},
	pages = {363 - 368},
	doi = {10.1145/3711542.3711562},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105005025771&doi=10.1145%2F3711542.3711562&partnerID=40&md5=6e874ecb701067ca2a813d184cc4a1cb},
	affiliations = {De La Salle University, College of Computer Studies, Manila, Philippines},
	abstract = {Social media has become a place where people can interact with one another, even with strangers. This provides grounds for people to harass others, especially because of the anonymity that the internet offers. The 2022 Philippine Presidential Election was a trigger for a large amount of hostile interaction between Filipinos online because of their differing opinions. This may be a result of either a lack of automated regulation in online discourse or a lack of detection of abusive language in the Filipino language. This study attempts to resolve this by using intent-annotated utterances with SVM, BiLSTM, and RoBERTa models to detect the explicit and implicit abusive language in Filipino texts. Multiclass and hierarchical models are created for classification. The hierarchical models showed better performance. Within the context of content moderation, BiLSTM is more desirable due to its high F1 score of 88.18% in the Abusive class, and considerable precision scores of 68.49% and 64.62% for Explicit and Implicit classes. However, given that the study has a small corpus limited to the elections, there is still a possibility that RoBERTa will be the best model in terms of generalizability when pre-trained on a larger and more generic corpus. © 2024 Copyright held by the owner/author(s).},
	author_keywords = {abusive language; discourse; election candidates; explicit abuse detection; implicit abuse detection; Natural Language Processing},
	keywords = {Hierarchical systems; Abusive language; Discourse; Election candidate; Explicit abuse detection; Hierarchical model; Implicit abuse detection; Language processing; Natural language processing; Natural languages; Presidential election; Sentiment analysis},
