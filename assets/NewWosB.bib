@inproceedings{ WOS:000895685600046,
Author = {Wiegand, Michael and Ruppenhofer, Josef and Eder, Elisabeth},
Book-Group-Author = {Assoc Computat Linguist},
Title = {Implicitly Abusive Language - What does it actually look like and why
   are we not getting there?},
Booktitle = {2021 CONFERENCE OF THE NORTH AMERICAN CHAPTER OF THE ASSOCIATION FOR
   COMPUTATIONAL LINGUISTICS: HUMAN LANGUAGE TECHNOLOGIES (NAACL-HLT 2021)},
Year = {2021},
Pages = {576-587},
Note = {Conference of the North-American-Chapter of the
   Association-for-Computational-Linguistics - Human Language Technologies
   (NAACL-HLT), ELECTR NETWORK, JUN 06-11, 2021},
Organization = {Assoc Computat Linguist, N Amer Chapter; Google Res; Amazon Sci; Apple;
   Facebook AI; Megagon Labs; Microsoft; Bloomberg Engn; Grammarly; IBM;
   Vanguard; Duolingo; Babelscape; Human Language Technol; LegalForce},
Abstract = {Abusive language detection is an emerging field in natural language
   processing which has received a large amount of attention recently.
   Still the success of automatic detection is limited. Particularly, the
   detection of implicitly abusive language, i.e. abusive language that is
   not conveyed by abusive words (e.g. dumbass or scum), is not working
   well. In this position paper, we explain why existing datasets make
   learning implicit abuse difficult and what needs to be changed in the
   design of such datasets. Arguing for a divide-and-conquer strategy, we
   present a list of subtypes of implicitly abusive language and formulate
   research tasks and questions for future research.},
