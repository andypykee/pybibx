@ARTICLE{Ehsan2024211,
	author = {Ehsan, Tahereh Zarrat and Nahvi, Manoochehr and Mohtavipour, Seyed Mehdi},
	title = {Violence detection in videos: A review on hand-crafted and deep-learning techniques},
