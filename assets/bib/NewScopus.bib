@CONFERENCE{Garg2025,
	author = {Garg, Samarth and Kavuri, Vivek Hruday and Shroff, Gargi and Mishra, Rahul},
	title = {KTCR: Improving Implicit Hate Detection with Knowledge Transfer driven Concept Refinement},
	year = {2025},
	journal = {Proceedings of the International Joint Conference on Neural Networks},
	pages = {},
	doi = {10.1109/IJCNN64981.2025.11227639},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105023976844&doi=10.1109%2FIJCNN64981.2025.11227639&partnerID=40&md5=0a9d2cc8f0a30cb544cb6b9fe09f561b},
	affiliations = {ABV-Indian Institute of Information Technology and Management, Gwalior, MP, India; International Institute of Information Technology, Hyderabad, Hyderabad, TS, India},
	abstract = {The constant shifts in social and political contexts, driven by emerging social movements and political events, lead to new forms of hate content and previously unrecognized hate patterns that machine learning models may not have captured. Some recent literature proposes data augmentation-based techniques to enrich existing hate datasets by incorporating samples that reveal new implicit hate patterns. This approach aims to improve the model's performance on out-of-domain implicit hate instances. It is observed, that further addition of more samples for augmentation results in the decrease of the performance of the model. In this work, we propose a Knowledge Transfer-driven Concept Refinement method that distills and refines the concepts related to implicit hate samples through novel prototype alignment and concept losses, alongside data augmentation based on concept activation vectors. Experiments with several publicly available datasets show that incorporating additional implicit samples reflecting new hate patterns through concept refinement enhances the model's performance, surpassing baseline results while maintaining cross-dataset generalization capabilities. © 2025 IEEE.},
