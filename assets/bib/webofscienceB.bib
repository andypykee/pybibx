Title = {DrugTracker: A Community-focused Drug Abuse Monitoring and Supporting
   System using Social Media and Geospatial Data (Demo Paper)},
Booktitle = {27TH ACM SIGSPATIAL INTERNATIONAL CONFERENCE ON ADVANCES IN GEOGRAPHIC
   INFORMATION SYSTEMS (ACM SIGSPATIAL GIS 2019)},
Year = {2019},
