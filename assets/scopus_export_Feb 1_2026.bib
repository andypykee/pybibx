@ARTICLE{Ahmed2025303,
	author = {Ahmed, Zishan and Morol, Md Kishor and Sadat Shanto, Shakib and Reza, Ahmed Shakib and Jubair, Md Abdullah Al},
	title = {Explainable English Hate Speech Detection: A Custom BiLSTM Model with LIME for Multilabel Classification},
	year = {2025},
	pages = {303 - 310},
	doi = {10.1145/3723178.3723218},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105023635759&doi=10.1145%2F3723178.3723218&partnerID=40&md5=d8873dfe0f4b0cede98d4d5297778935},
