@inproceedings{ WOS:001656776900029,
Author = {Tofa, Farjana Alam and Zeba, Lorin Tasnim and Osama, Md and Dey, Ashim},
Editor = {Sarveswaran, K and Vaidya, A and Bal, BK and Shams, S and Thapa, S},
Title = {CUET\_INSights@NLU of Devanagari Script Languages: Leveraging
   Transformer-based Models for Target Identification in Hate Speech},
Booktitle = {PROCEEDINGS OF THE FIRST WORKSHOP ON CHALLENGES IN PROCESSING SOUTH
   ASIAN LANGUAGES, CHIPSAL 2025},
Year = {2025},
Pages = {267-272},
Note = {1st Workshop on Challenges in Processing South Asian Languages-CHiPSAL,
   Abu Dhabi, U ARAB EMIRATES, JAN 19, 2025},
Organization = {Association for Computational Linguistics},
Abstract = {Hate speech detection in multilingual content is a challenging problem
   especially when it comes to understanding the specific targets of
   hateful expressions. Identifying the targets of hate speech whether
   directed at individuals, organizations or communities is crucial for
   effective content moderation and understanding the context. A shared
   task on hate speech detection in Devanagari Script Languages organized
   by CHIPSAL@COLING 2025 allowed us to address the challenge of
   identifying the target of hate speech in the Devanagari Script Language.
   For this task, we experimented with various machine learning (ML) and
   deep learning (DL) models including Logistic Regression, Decision Trees,
   Random Forest, SVM, CNN, LSTM, BiLSTM, and transformer-based models like
   MiniLM, m-BERT, and Indic-BERT. Our experiments demonstrated that
   Indic-BERT achieved the highest F1-score of 0.69, ranked 3rd in the
   shared task. This research contributes to advancing the field of hate
   speech detection and natural language processing in low-resource
   languages.},
