}

@CONFERENCE{Alabdulrahman2024,
	author = {Alabdulrahman, Maria and Alotaibi, Lara and Latif, Ghazanfar and Alghazo, Jaafar M.},
	title = {Arabic Offense Text Detection in Social Networks using Collaborative Machine Learning},
	year = {2024},
	journal = {2024 6th International Symposium on Advanced Electrical and Communication Technologies, ISAECT 2024},
	pages = {},
	doi = {10.1109/ISAECT64333.2024.10799711},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215612841&doi=10.1109%2FISAECT64333.2024.10799711&partnerID=40&md5=f8e8990aaefa392cb17cad7523c369df},
	affiliations = {Prince Mohammad Bin Fahd University, Department of Software Engineering, Al-Khobar, Ash Sharqiyah, Saudi Arabia; Prince Mohammad Bin Fahd University, Department of Computer Science, Al-Khobar, Ash Sharqiyah, Saudi Arabia; University of Minnesota Twin Cities, Software Engineering and Information Technology Management Departments, Minneapolis, MN, United States},
	abstract = {In an era of abundant social media use and digital communication, the classification of Arabic social media content and user comments into relevant categories poses a significant challenge. The content in social network platforms often encompasses a wide range of topics, sentiments, and societal concerns, making it essential to develop effective methods for discerning and categorizing these expressions. In this research, a new dataset for Arabic offensive text is built along with the methodology proposed for classifying Arabic content into five categories collected from different social networking sites. Leveraging a diverse array of text representation techniques, including TF-IDF, Bag of Words (BoW), custom embeddings, and pre-trained embeddings from models such as Arabert and Mbert, a comprehensive evaluation is conducted based, shedding light on the optimal approach for tackling this complex problem. The findings reveal that the TF-IDF and BoW methods stand out with an impressive 89% accuracy, emphasizing their robustness in addressing the nuances of Arabic tweet classification across these sensitive topics. This study offers valuable insights into the challenges inherent in categorizing Arabic social media content, emphasizing the significance of the TF-IDF approach as an effective tool for this task. © 2024 IEEE.},
	author_keywords = {Arabic hate speech; Arabic Text Classification; Collaborative Machine Learning; Hate Speech Detection; Sentiment Analysis; Social Networks},
	keywords = {Arabic hate speech; Arabic text classification; Arabic texts; Collaborative machine learning; Hate speech detection; Machine-learning; Sentiment analysis; Social network; Speech detection; Text classification; Adversarial machine learning},
