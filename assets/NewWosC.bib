@inproceedings{ WOS:000788397000046,
Author = {Amali, H. M. A. Ishara and Jayalal, Shantha},
Book-Group-Author = {IEEE},
Title = {Classification of Cyberbullying Sinhala Language Comments on Social
   Media},
Booktitle = {MERCON 2020: 6TH INTERNATIONAL MULTIDISCIPLINARY MORATUWA ENGINEERING
   RESEARCH CONFERENCE (MERCON)},
Year = {2020},
Pages = {266-271},
Note = {6th International Multidisciplinary Moratuwa Engineering Research
   Conference (MERCon), Univ Moratuwa, Moratuwa, SRI LANKA, JUL 28-30, 2020},
Organization = {Univ Moratuwa, IEEE Student Branch; Univ Moratuwa, Engn Res Unit; IEEE;
   IEEE Sri Lanka Sect; IEEE Power \& Energy Soc Chapter, Sri Lanka Sect;
   IEEE Commun Soc Chapter, Sri Lanka Sect; IEEE Robot \& Automat Soc
   Chapter, Sri Lanka Sect; Univ Moratuwa, Fac Engn; Univ Moratuwa, Fac
   Grad Studies},
Abstract = {Due to technological revolution over the years, bullying which was
   confined to physical boundaries has now moved online. Denigration or
   insult is one form of cyberbullying. According to Sri Lanka Computer
   Emergency Readiness Team, social media cyberbullying incidents are
   escalating. Insulting words are dynamic, and same word can have several
   meanings according to the context. Simply because a comment contains
   such a word, it cannot be classified as bullying. Hence, when labeling
   comments, simple keyword spotting techniques are inadequate. Other
   languages have addressed this issue using lexical databases such as
   WordNet which provides synonyms and homonyms of words. Since there is no
   proper lexical database developed for Sinhala language, detecting a word
   as bullying is a challenge. Therefore, we used rules to overcome this
   issue. Twitter comments with profane words were collected, outliers were
   removed, and remaining tweets were pre-processed. To determine insult in
   the text, five rules were used for feature extraction. Afterward, we
   applied Support Vector Machine (SVM), K-nearest neighbor (KNN) and Naive
   Bayes algorithms. The results show that SVM with an RBF kernel performs
   better with an F1-score of 91\%. Novelty of this research is the focus
   on Sinhala language cyberbully detection which has not been addressed
   before.},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Amali, HMAI (Corresponding Author), Univ Kelaniya, Fac Sci, Dept Ind Management, Colombo, Sri Lanka.
   Amali, H. M. A. Ishara; Jayalal, Shantha, Univ Kelaniya, Fac Sci, Dept Ind Management, Colombo, Sri Lanka.},
DOI = {10.1109/mercon50084.2020.9185209},
ISBN = {978-1-7281-9059-4},
Keywords = {cyberbullying; social media; text mining; sentiment analysis; machine
