@article{ WOS:001388479700001,
Author = {Esmaelizadeh, Armin and Cotterill, Sunil and Hebert, Liam and Golab,
   Lukasz and Taghva, Kazem},
Title = {Infomod: information-theoretic machine learning model diagnostics},
Journal = {DISTRIBUTED AND PARALLEL DATABASES},
Year = {2024},
Volume = {43},
Number = {1},
Month = {DEC 30},
Abstract = {Validating and debugging machine learning models is done by testing them
   on unseen data. During this process, analyzing model performance on
   various subsets of the test dataset is critical for fairness, trust,
   bias detection and explainability. We describe a new way to do this. Our
   solution, InfoMoD, applies recent work in information-theoretic data
   summarization to model diagnostics. To improve performance, we
   implemented InfoMoD in a distributed fashion, using Apache Spark. Based
   on four use cases ranging from finance to computer vision and hate
   speech detection, we show that InfoMoD concisely describes how a model
   performs across different subsets of the data and produces expected
   performance indicators for individual test instances.},
