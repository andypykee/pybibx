}

@CONFERENCE{Chai2024329,
	author = {Chai, Yidong and Liu, Yi and Ebrahimi, Mohammadreza and Li, Weifeng and Padmanabhan, Balaji and Jiang, Yuanchun and Liu, Yezheng},
	title = {Enhancing Adversarial Robustness: A Novel Bayesian Uncertainty-Based Ensemble Learning Method},
	year = {2024},
	journal = {Proceeding - 2024 IEEE 9th International Conference on Data Science in Cyberspace, DSC 2024},
	pages = {329 - 336},
	doi = {10.1109/DSC63484.2024.00051},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218450646&doi=10.1109%2FDSC63484.2024.00051&partnerID=40&md5=481b77f7c9c56d61a6d72a8a8416d0ef},
	affiliations = {Hefei University of Technology, School of Management, Hefei, Anhui, China; University of South Florida, Tampa, Department of Management Information Systems, Tampa, FL, United States; University of Georgia, Department of Management Information Systems, Athens, GA, United States; Muma College of Business, Tampa, FL, United States},
	abstract = {Deep learning (DL) models are highly vulnerable to a specific type of threat: adversarial attacks. Adversarially retrained ensemble learning represents the state-of-the-art approach to enhance DL models' robustness against adversarial attack, yet still limited by the failure to dynamically assess base model's reliability, the failure to assign higher weights to more reliable base models, and the failure to enhance adversarial robustness of aggregation model. To address these limitations, this study proposes a novel Bayesian Uncertainty-Based Ensemble Learning (BUEL) method. First, we deduce the knowledge that a higher Bayesian uncertainty score indicates a lower reliability of the prediction. We then propose a novel knowledge-data based weight assignment mechanism to initially determine base models' weights based on Bayesian uncertainty scores and then update with observed data. Next, we present a novel adversarial training strategy to enhance adversarial robustness of the aggregation model. Through experiments on offensive language detection, we validate the deduced knowledge and demonstrate that BUEL can effectively enhance DL models' adversarial robustness with seamless compatibility. © 2024 IEEE.},
	author_keywords = {Adversarial Robustness; Bayesian Uncertainty; Deep Learning; Ensemble Learning; Predictive Analytics},
	keywords = {Contrastive Learning; Federated learning; Generative adversarial networks; Adversarial robustness; Aggregation model; Base models; Bayesian; Bayesian uncertainty; Deep learning; Ensemble learning; Learning methods; Learning models; Uncertainty; Adversarial machine learning},
