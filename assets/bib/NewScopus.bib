}

@ARTICLE{Ibrahim202453,
	author = {Ibrahim, Yasmine Mahmoud and Essameldin, Reem and Darwish, Saad Mohamed},
	title = {Cyberbullying-Related Hate Speech Fine-Grained Classification for Social Media Forensics Using Neutrosophic Neural Networks},
	year = {2024},
	journal = {Lecture Notes on Data Engineering and Communications Technologies},
	volume = {233},
	pages = {53 - 62},
	doi = {10.1007/978-3-031-77299-3_6},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215091595&doi=10.1007%2F978-3-031-77299-3_6&partnerID=40&md5=859e4d95d0d963688b4a321114d51231},
	affiliations = {Institute of Graduate Studies and Research, Department of Information Technology, Alexandria, Alexandria, Egypt; Faculty of Computers and Information Technology, Giza, Giza, Egypt; Faculty of Computers and Data Science, Alexandria, Alexandria, Egypt},
	abstract = {Detecting cyberbullying automatically in social media has emerged as a highly challenging task due to the complex nature of language used in such platforms. Currently, several methods exist for cyberbullying detection, but they still suffer from the ambiguity and vagueness when differentiating between different types of cyberbullying-related hate speech and they also lack in accuracy. This paper proposes a fine-grained cyberbullying classification approach by integrating Neutrosophic Logic (NL) within the Multi-Layer Perceptron (MLP) model. The proposed model enhances classification by mitigating the challenges posed by the ambiguity and overlapping boundaries between distinct categories of cyberbullying. The model, leveraging the one-against-one strategy in MLP classification, captures complex relationships between various types of cyberbullying, due to the overlaps and ambiguous instances within cyberbullying types. The results of the proposed model demonstrate the performance enhancement of incorporating Neutrosophic Logic for fine-grained cyberbullying classification tasks, with a 2% increase in accuracy, thereby improving the overall effectiveness of cyberbullying classification. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2024.},
	author_keywords = {Cyberbullying; Hate Speech Detection; Multiclass classification; Neutrosophic Sets; one-against-one; Social Media Forensics},
	keywords = {Classification (of information); Cyber bullying; Fine grained; Hate speech detection; Multi-class classification; Neutrosophic logic; Neutrosophic sets; One-against-one; Social media; Social medium forensic; Speech detection; Digital forensics},
	correspondence_address = {Y.M. Ibrahim; Department of Information Technology, Institute of Graduate Studies and Research, Alexandria University, Alexandria, 21526, Egypt; email: igsr.yasmine@alexu.edu.eg},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {23674512},
	language = {English},
	abbrev_source_title = {Lecture. Notes. Data Eng. Commun. Tech.},
	type = {Book chapter},
