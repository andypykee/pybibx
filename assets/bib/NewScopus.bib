	year = {2024},
	journal = {Proceedings - 2024 IEEE Smart World Congress, SWC 2024 - 2024 IEEE Ubiquitous Intelligence and Computing, Autonomous and Trusted Computing, Digital Twin, Metaverse, Privacy Computing and Data Security, Scalable Computing and Communications},
	pages = {1603 - 1608},
	doi = {10.1109/SWC62898.2024.00246},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002244485&doi=10.1109%2FSWC62898.2024.00246&partnerID=40&md5=246708af865acf494cd95a89d94d0a26},
	affiliations = {Xi'an Jiaotong-Liverpool University, School of AI and Advanced Computing, Suzhou, Jiangsu, China; Zhejiang University of Technology, College of Computer Science and Technology, Hangzhou, Zhejiang, China; University of Technology Sydney, Sydney, NSW, Australia; Xi'an Jiaotong-Liverpool University, School of Advanced Technology, Suzhou, Jiangsu, China},
	abstract = {Identifying offensive language is essential for maintaining safety and sustainability in the social media era. Though large language models (LLMs) have demonstrated encouraging potential in social media analytics, they lack thorough evaluation when in offensive language detection, particularly in multilingual environments. We for the first time evaluate multilingual offensive language detection of LLMs in three languages: English, Spanish, and German with three LLMs, GPT-3.5, Flan-T5, and Mistral, in both monolingual and multilingual settings. We further examine the impact of different prompt languages and augmented translation data for the task in non-English contexts. Furthermore, we discuss the impact of the inherent bias in LLMs and the datasets in the mispredictions related to sensitive topics. © 2024 IEEE.},
	author_keywords = {large language models; multilingual; Offensive language detection},
	keywords = {Translation (languages); Language detection; Language model; Large language model; Multilingual; Multilingual environments; Offensive language detection; Offensive languages; Social media; Social media analytics; Social networking (online)},
