	title = {HateBERT: Retraining BERT for Abusive Language Detection in English},
	year = {2021},
	journal = {WOAH 2021 - 5th Workshop on Online Abuse and Harms, Proceedings of the Workshop},
	pages = {17 - 25},
	doi = {10.18653/v1/2021.woah-1.3},
