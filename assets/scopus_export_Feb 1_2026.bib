	affiliations = {Indian Institute of Information Technology, Allahabad, Department of Electronics and Communication Engineering, Prayagraj, UP, India; University of Kerala, Thiruvananthapuram, KL, India; University of Galway, Data Science Institute, Galway, Connacht, Ireland; University of Galway, Data Science Institute, Galway, Connacht, Ireland; University of Galway, School of Computer Science, Galway, Connacht, Ireland},
	abstract = {Homophobia and transphobia are pervasive issues in online platforms, manifesting as hate speech directed towards LGBTQ+ individuals. Identifying and mitigating such toxic language is crucial for creating safer online spaces especially in low resource Indic languages. This work focuses on the task of detecting homophobia, transphobia, and non-anti-LGBT+ content in YouTube comments, which are annotated at the comment/post level in Marathi and Telugu languages. We employed pre-trained and fine-tuned versions of BERT models on Marathi and Telugu data. These models were further fine-tuned with contrastive learning objectives to enhance their discriminatory power. For Marathi data, the MahaBERT model, combined with Supervised Contrastive Learning (SupCon), achieved an accuracy of 70.53%, a precision of 52.48%, a recall of 59.21%, and an F1-score of 54.52%. For Telugu data, the TeluguBERT model with SupCon achieved superior performance, with an accuracy of 96.90%, a precision of 96.95%, a recall of 96.98%, and an F1-score of 96.96%. © 2024 Copyright held by the owner/author(s).},
