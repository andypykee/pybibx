@inproceedings{ WOS:001361895500255,
Author = {Pedersen, Ted},
Editor = {Herbelot, A and Zhu, X and Palmer, A and Schneider, N and May, J and Shutova, E},
Title = {Duluth at SemEval-2020 Task 12: Offensive Tweet Identification in
   English with Logistic Regression},
