Title = {A COMPUTATIONAL FRAMEWORK FOR DETECTING OFFENSIVE LANGUAGE WITH SUPPORT
   VECTOR MACHINE IN SOCIAL COMMUNITIES},
Booktitle = {2017 8TH INTERNATIONAL CONFERENCE ON COMPUTING, COMMUNICATION AND
   NETWORKING TECHNOLOGIES (ICCCNT)},
