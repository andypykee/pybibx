@inproceedings{ WOS:000668146200078,
Author = {Li, Jinfeng and Du, Tianyu and Ji, Shouling and Zhang, Rong and Lu, Quan
   and Yang, Min and Wang, Ting},
Book-Group-Author = {USENIX Assoc},
Title = {TEXTSHIELD: Robust Text Classification Based on Multimodal Embedding and
   Neural Machine Translation},
Booktitle = {PROCEEDINGS OF THE 29TH USENIX SECURITY SYMPOSIUM},
Year = {2020},
