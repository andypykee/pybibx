	keywords = {Classification (of information); Digital communication systems; Learning algorithms; Learning systems; Social networking (online); Speech communication; Speech recognition; Support vector machines; Syntactics; Text processing; Arabic scripts; Deep learning; Digital communications; Facebook; Learning models; Machine-learning; Multimodel systems; Social media; Speech detection; Support vectors machine},
