	year = {2024},
	journal = {Proceedings - IEEE 2024 1st International Conference on Advances in Computing, Communication and Networking, ICAC2N 2024},
	pages = {127 - 132},
	doi = {10.1109/ICAC2N63387.2024.10895919},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000703142&doi=10.1109%2FICAC2N63387.2024.10895919&partnerID=40&md5=6f620d0bd76b5757e765ebfacc89388b},
	affiliations = {Galgotias University, School of Computing Science and Engineering, Greater Noida, UP, India},
	abstract = {With the technological developments past decade, there is an increase seen in the usage of social media applications as more people have come over on such platforms to show their thoughts. We look for the problems faced by applications for processing hate speech in text on their platforms. A few of the difficulties faced are because of the reason of so many languages, the way of using the words making the sentence have different meanings, and the shortage of proper data for testing and training. We derive a way for making such task simpler by the use of support vector machine which is giving results better than a neural network model. At the end we also go through the technical issues which still persists till now. © 2024 IEEE.},
