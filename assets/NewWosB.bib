   Interdisciplinary Applications; Linguistics; Language \& Linguistics},
Author-Email = {anirmal1@asu.edu
   abhatt43@asu.edu
   psheth5@asu.edu
   huanliu@asu.edu},
Affiliations = {Arizona State University; Arizona State University-Tempe},
Funding-Acknowledgement = {DARPA SemaFor project {[}HR001120C0123]; Office of Naval Research
   {[}N00014-21-1-4002]},
