Title = {Towards a Safer Conversation Space: Detection of Toxic Content in Social
   Media (Student Consortium)},
Booktitle = {2020 IEEE SIXTH INTERNATIONAL CONFERENCE ON MULTIMEDIA BIG DATA (BIGMM
   2020)},
