@CONFERENCE{Zhang2024183,
	author = {Zhang, Yinghui and Chen, Tailin and Zhang, Yuchen and Fu, Zeyu},
	title = {Enhanced Multimodal Hate Video Detection via Channel-wise and Modality-wise Fusion},
	year = {2024},
	journal = {IEEE International Conference on Data Mining Workshops, ICDMW},
	pages = {183 - 190},
	doi = {10.1109/ICDMW65004.2024.00030},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001348242&doi=10.1109%2FICDMW65004.2024.00030&partnerID=40&md5=e8960a842c46e2637219063f992307f5},
	affiliations = {University of Exeter, Department of Computer Science, Exeter, Devon, United Kingdom; University of Essex, Institute for Analytics and Data Science, Colchester, Essex, United Kingdom},
	abstract = {The rapid rise of video content on platforms such as TikTok and YouTube has transformed information dissemination, but it has also facilitated the spread of harmful content, particularly hate videos. Despite significant efforts to combat hate speech, detecting these videos remains challenging due to their often implicit nature. Current detection methods primarily rely on unimodal approaches, which inadequately capture the complementary features across different modalities. While multimodal techniques offer a broader perspective, many fail to effectively integrate temporal dynamics and modality-wise interactions essential for identifying nuanced hate content. In this paper, we present CMFusion, an enhanced multimodal hate video detection model utilizing a novel Channel-wise and Modality-wise Fusion Mechanism. CMFusion first extracts features from text, audio, and video modalities using pre-trained models and then incorporates a temporal cross-attention mechanism to capture dependencies between video and audio streams. The learned features are then processed by channel-wise and modality-wise fusion modules to obtain informative representations of videos. Our extensive experiments on a real-world dataset demonstrate that CMFusion significantly outperforms five widely used baselines in terms of accuracy, precision, recall, and F1 score. Comprehensive ablation studies and parameter analyses further validate our design choices, highlighting the model's effectiveness in detecting hate videos. The source codes will be made publicly available at https://github.com/EvelynZ10/cmfusion. © 2024 IEEE.},
	author_keywords = {Hate Video Detection; Multimodal Fusion; Temporal Cross-Attention},
	keywords = {Audio streaming; Feature extraction; Image coding; Video recording; Video signal processing; Current detection; Detection methods; Hate video detection; Multi-modal; Multi-modal fusion; Temporal cross-attention; Unimodal; Video contents; Video detection; YouTube},
	correspondence_address = {Y. Zhang; University of Exeter, Department of Computer Science, United Kingdom; email: yz949@exeter.ac.uk},
