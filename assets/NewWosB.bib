Title = {On the Importance of Word Embedding in Automated Harmful Information
   Detection},
Booktitle = {TEXT, SPEECH, AND DIALOGUE (TSD 2022)},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2022},
