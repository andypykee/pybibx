@ARTICLE{Usman2025,
	author = {Usman, Muhammad and Ahmad, Muhammad Munawar and Sidorov, G. and Gelbukh, Irina and Téllez, R. Q.},
	title = {A Large Language Model-Based Approach for Multilingual Hate Speech Detection on Social Media},
	year = {2025},
	journal = {Computers},
	volume = {14},
	number = {7},
	pages = {},
	doi = {10.3390/computers14070279},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105011866882&doi=10.3390%2Fcomputers14070279&partnerID=40&md5=e2ba001ca4bd85d229f902c7a90755cf},
	affiliations = {Instituto Politécnico Nacional, Centro de Investigación en Computación, Mexico, DF, Mexico},
	abstract = {The proliferation of hate speech on social media platforms poses significant threats to digital safety, social cohesion, and freedom of expression. Detecting such content—especially across diverse languages—remains a challenging task due to linguistic complexity, cultural context, and resource limitations. To address these challenges, this study introduces a comprehensive approach for multilingual hate speech detection. To facilitate robust hate speech detection across diverse languages, this study makes several key contributions. First, we created a novel trilingual hate speech dataset consisting of 10,193 manually annotated tweets in English, Spanish, and Urdu. Second, we applied two innovative techniques—joint multilingual and translation-based approaches—for cross-lingual hate speech detection that have not been previously explored for these languages. Third, we developed detailed hate speech annotation guidelines tailored specifically to all three languages to ensure consistent and high-quality labeling. Finally, we conducted 41 experiments employing machine learning models with TF–IDF features, deep learning models utilizing FastText and GloVe embeddings, and transformer-based models leveraging advanced contextual embeddings to comprehensively evaluate our approach. Additionally, we employed a large language model with advanced contextual embeddings to identify the best solution for the hate speech detection task. The experimental results showed that our GPT-3.5-turbo model significantly outperforms strong baselines, achieving up to an 8% improvement over XLM-R in Urdu hate speech detection and an average gain of 4% across all three languages. This research not only contributes a high-quality multilingual dataset but also offers a scalable and inclusive framework for hate speech detection in underrepresented languages. © 2025 by the authors.},
	author_keywords = {BERT; data mining; deep learning; GPT; large language models; machine learning; multilingual hate speech detection; NLP; XLM-R},
	keywords = {Computational linguistics; Deep learning; Embeddings; Large datasets; Social networking (online); Speech analysis; Speech communication; Speech transmission; BERT; GPT; Language model; Large language model; Machine-learning; Multilingual hate speech detection; Speech detection; XLM-R; Data mining},
	correspondence_address = {R.Q. Tellez; Centro de Investigación en Computación, Instituto Politécnico Nacional (CIC-IPN), Mexico City, 07320, Mexico; email: quintero@cic.ipn.mx},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	language = {English},
	abbrev_source_title = {Comput.},
	type = {Article},
