	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@ARTICLE{Yao2025,
	author = {Yao, Tsungcheng and Binnewies, Sebastian and Foo, Ernest and Alavi, Masoumeh},
	title = {See the words through my eyes: The role of personal traits in abusive language detection},
	year = {2025},
	journal = {Expert Systems with Applications},
	volume = {276},
	pages = {},
	doi = {10.1016/j.eswa.2025.127188},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000042371&doi=10.1016%2Fj.eswa.2025.127188&partnerID=40&md5=a0e5ee7d029337c6875b16f395e2a863},
	affiliations = {Griffith University, School of Information and Communication Technology, Brisbane, QLD, Australia; Griffith University, School of Information and Communication Technology, Brisbane, QLD, Australia; Griffith University, School of Applied Psychology, Brisbane, QLD, Australia},
	abstract = {Abusive language detection systems play a significant role in addressing cyberbullying. However, conventional detection systems primarily focus on the textual pattern of messages for their prediction, overlooking the reality that the same message can usually provoke different consequences for different users. In other words, personalised predictions are essential but currently absent. To address this limitation, this paper considers the rationality of introducing a set of psychological features to personalise abusive language detection tasks. The foundation of our work lies in the Antecedents, Behaviours, Consequences model (ABC model), asserting that an individual's response to a trigger message is impacted not only by the trigger itself but also by their personal beliefs and attitudes. We develop a novel data preparation framework and construct a new abusive language dataset, incorporating psychological features from 505 online users. Logistic regression analysis illustrates that Irrationality and Self-down features positively correlate with the abusive class, while Rationality features exhibit a negative correlation. These results are supported by established psychological findings. Furthermore, a preliminary evaluation showed that our proposed psychological features improve a CNN-based detection system's Macro and Weighted F1 scores by 4%–5% points when making personalised predictions. These results collectively make for an empirical case that underscores the importance of considering users’ psychological features in abusive language detection. Crucially, these findings also pave the way for developing personalised prediction systems. © 2025 The Authors},
	author_keywords = {Abusive language dataset; Cyberbullying; Dataset preparation framework; Ellis’ ABC model; Personalised abusive language detection; Psychological features},
	keywords = {Abusive language dataset; Consequence models; Cyber bullying; Dataset preparation framework; Detection system; Ellis’ antecedent, behavior, consequence model; Language detection; Personal traits; Personalized abusive language detection; Psychological features},
	correspondence_address = {T. Yao; School of Information and Communication Technology, Griffith University Nathan Campus, Brisbane, 170 Kessels Rd Nathan, 4109 Qld, Australia; email: tsungcheng.yao@griffithuni.edu.au},
	publisher = {Elsevier Ltd},
	issn = {09574174},
	coden = {ESAPE},
	language = {English},
	abbrev_source_title = {Expert Sys Appl},
	type = {Article},
