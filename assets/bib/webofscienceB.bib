@inproceedings{ WOS:000770800600023,
Author = {Najar, Fatma and Bouguila, Nizar},
Editor = {Llados, J and Lopresti, D and Uchida, S},
Title = {Sparse Document Analysis Using Beta-Liouville Naive Bayes with
   Vocabulary Knowledge},
Booktitle = {DOCUMENT ANALYSIS AND RECOGNITION - ICDAR 2021, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2021},
Volume = {12822},
Pages = {351-363},
Note = {16th IAPR International Conference on Document Analysis and Recognition
   (ICDAR), Lausanne, SWITZERLAND, SEP 05-10, 2021},
Organization = {IAPR},
Abstract = {Smoothing the parameters of multinomial distributions is an important
   concern in statistical inference tasks. In this paper, we present a new
   smoothing prior for the Multinomial Naive Bayes classifier. Our approach
   takes advantage of the Beta-Liouville distribution for the estimation of
   the multinomial parameters. Dealing with sparse documents, we exploit
   vocabulary knowledge to define two distinct priors over the
   ``observed{''} and the ``unseen{''} words. We analyze the problem of
   largescale and sparse data by enhancing Multinomial Naive Bayes
   classifier through smoothing the estimation of words with a Beta-scale.
   Our approach is evaluated on two different challenging applications with
   sparse and large-scale documents namely: emotion intensity analysis and
   hate speech detection. Experiments on real-world datasets show the
   effectiveness of our proposed classifier compared to the related-work
   methods.},
