	keywords = {Decision trees; Learning systems; Logistic regression; Natural language processing systems; Network security; Random forests; Speech recognition; Support vector regression; Text processing; Hate speech detection; Language processing; Machine learning approaches; Natural language processing; Natural languages; Sinhalum text; Social media platforms; Speech detection; Support vectors machine; Telegram; Telegraph},
