   Alakrot, Azalden; Nikolov, Nikola S., Univ Limerick, Dept Comp Sci \& Informat Syst, Limerick, Ireland.
   Murray, Liam, Univ Limerick, Sch Languages, Limerick, Ireland.},
DOI = {10.1016/j.procs.2018.10.473},
ISSN = {1877-0509},
Keywords = {anti-social behaviour; offensive language; harassment detection; Arabic
   dataset; Arabic dialects; text mining; text classification},
Research-Areas = {Computer Science},
