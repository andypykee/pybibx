	affiliations = {Jadara University, Cybersecurity Department, Irbid, Irbid, Jordan; Amman Arab University, Cybersecurity Department, Amman, Amman, Jordan; Faculty of Engineering, Ain Shams University, Cairo, Cairo, Egypt; Faculty of Computer Science, Cairo, Cairo, Egypt; Applied Science Private University, Faculty of Information Technology, Amman, Jordan; Imam Mohammad Ibn Saud Islamic University, Department of Computer Science, Riyadh, Riyad, Saudi Arabia; Imam Abdulrahman bin Faisal University, College of Education, Department of Educational Technologies, Dammam, Ash Sharqiyah, Saudi Arabia; Imam Abdulrahman Bin Faisal University, Department of MIS, Dammam, Ash Sharqiyah, Saudi Arabia; Institute of Graduate Studies and Research, Alexandria, Alexandria, Egypt; Faculty of Computers and Data Science, Alexandria, Alexandria, Egypt},
