@CONFERENCE{Sahu2023,
	author = {Sahu, Yatendra and Gupta, Rajeev Kumar and Bharti, Santosh Kumar},
	title = {Combating Hate Speech on Q&A Forums with Machine Learning},
	year = {2023},
	journal = {2023 World Conference on Communication and Computing, WCONF 2023},
	pages = {},
	doi = {10.1109/WCONF58270.2023.10235146},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85173033523&doi=10.1109%2FWCONF58270.2023.10235146&partnerID=40&md5=64602fd6ebd1e0ec4feaf32fcc653ecc},
	affiliations = {Council of Indian Institutes of Information Technology, Computer Science and Engineering, Gwalior, MP, India; Pandit Deendayal Energy University, Computer Science and Engineering, Gandhinagar, GJ, India},
	abstract = {Online forums are becoming increasingly popular, increasing the demand for efficient ways to handle user-generated information. In order to identify hate speech in user-generated content, this project offers a question-and-answer forum that employs machine learning (ML) algorithms and Natural Language Processing (NLP) techniques. The forum is built with the MERN stack, which includes MongoDB, Express, React, and Node.js. Several NLP strategies were implemented in the project, including feature vectorization using count vectorizer, TF-IDF vectorizer, and word2vec. Logistic regression (LR), support vector machines (SVM), decision trees (DT), and naive Bayes (NB) are the ML methods used to detect hate speech. The classification report is used as an evaluation metric to assess the performance of these methods. For model training, the 'Hate Speech and Offensive Language Dataset' hosted on Kaggle and freely accessible to the public is used. The findings of the experiments show that the LR model with the count vectorizer performs better than the other model and provides a maximum accuracy of 90%. © 2023 IEEE.},
