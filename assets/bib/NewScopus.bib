@CONFERENCE{AbdelAty2024109,
	author = {AbdelAty, Maged and Lazem, Shaimaa Y.},
	title = {Investigating the Robustness of Arabic Offensive Language Transformer-Based Classifiers to Adversarial Attacks},
	year = {2024},
	journal = {2nd International Conference of Intelligent Methods, Systems and Applications, IMSA 2024},
	pages = {109 - 114},
	doi = {10.1109/IMSA61967.2024.10652668},
