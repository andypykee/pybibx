@inproceedings{ WOS:000995495200054,
Author = {Schuetz, Mina},
Editor = {Kamps, J and Goeuriot, L and Crestani, F and Maistro, M and Joho, H and Davis, B and Gurrin, C and Kruschwitz, U and Caputo, A},
Title = {Disinformation Detection: Knowledge Infusion with Transfer Learning and
   Visualizations},
