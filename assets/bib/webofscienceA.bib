Title = {Improving the Detection of Multilingual Online Attacks with Rich Social
   Media Data from Singapore},
Booktitle = {PROCEEDINGS OF THE 61ST ANNUAL MEETING OF THE ASSOCIATION FOR
   COMPUTATIONAL LINGUISTICS (ACL 2023): LONG PAPERS, VOL 1},
Year = {2023},
