	year = {2024},
	journal = {Text and Social Media Analytics for Fake News and Hate Speech Detection},
	pages = {262 - 279},
	doi = {10.1201/9781003409519-15},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85202138657&doi=10.1201%2F9781003409519-15&partnerID=40&md5=7eb43fdd4a415402939db1055e6ca279},
	affiliations = {Lakshmi Narain College of Technology Bhopal, Bhopal, MP, India; MATS University, Raipur, CG, India; Lakshmi Narain College of Technology Bhopal, Bhopal, MP, India; Madhav Institute of Technology & Science, Gwalior, Department of IT, Gwalior, MP, India},
	abstract = {False information and hate speech propagate prejudice against castes, religions, politics, race, disabilities, sexual orientations, and other groups in society. The brittleness of social media platforms and the explosive growth of mobile and web technologies, particularly among the younger population, have had negative offline effects. These platforms offer access to online communities as well as anonymity. The Internet's importance today is undeniable; it provides access to enormous amounts of information and makes it possible for members of any type of social group to participate in politics. However, the rapid advancement of digital and communication technologies has presented grave challenges to businesses, political organizations, governmental agencies, and all socio-economic bodies. With the rise of social media platforms and search engine algorithms, which filter and spread material based on user desire, these problems have grown more complex. The demand for fake news identification and intervention has escalated as a result of fake news’ explosive growth and the damage it does to democracy, justice, and public confidence. As a result, it is quite challenging to identify and counteract this kind of message. Although efforts have been made to apply automatic systems for detection and monitoring, their outcomes are still lacking, necessitating more research in the field. In this chapter, we go over a few NLP-based, result-oriented strategies for detecting hate speech as well as ways to avoid aggravating it. We cover numerous techniques that can identify fake news from a variety of angles, including the inaccurate information it contains, how it spreads, the reliability of its source, etc. We suggest conducting interdisciplinary research to support the joint efforts across the social sciences, political science, computer and information sciences, and journalism to investigate false news so that fake news detection is not only effective but also explicable. © 2024 CRC Press.},
	publisher = {CRC Press},
	isbn = {9781040100493; 9781032526621},
