@inproceedings{ WOS:001333582400010,
Author = {Thi-Ngoc-Diem Pham and Ba-Dai-Phuc Phan and Thanh-Dien Tran},
Editor = {Barolli, L},
Title = {Child Abuse Behaviors Identification from Surveillance Videos},
