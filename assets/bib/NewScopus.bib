	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85187483126&partnerID=40&md5=1d5e0abedc5c8bb5d63e1b38191661dc},
	affiliations = {Virginia Polytechnic Institute and State University, Blacksburg, VA, United States; Delhi Technological University, New Delhi, India; Jamia Millia Islamia, New Delhi, India; University of California, Los Angeles, Los Angeles, CA, United States; The University of Manchester, Manchester, Greater Manchester, United Kingdom; Thapar Institute of Engineering & Technology, Patiala, PB, India; Wageningen University & Research, Wageningen, Gelderland, Netherlands; Macquarie University, Sydney, NSW, Australia},
	abstract = {Social media plays a pivotal role in global discussions, including on climate change. The variety of opinions expressed range from supportive to oppositional, with some instances of hate speech. Recognizing the importance of understanding these varied perspectives, the 7th Workshop on Challenges and Applications of Automated Extraction of Socio-political Events from Text (CASE) at EACL 2024 hosted a shared task focused on detecting stances and hate speech in climate activism-related tweets. This task was divided into three subtasks: subtasks A and B concentrated on identifying hate speech and its targets, while subtask C focused on stance detection. Participants' performance was evaluated using the macro F1-score. With over 100 teams participating, the highest F1 scores achieved were 91.44% in subtask C, 78.58% in subtask B, and 74.83% in subtask A. This paper details the methodologies of 24 teams that submitted their results to the competition's leaderboard. © 2024 Association for Computational Linguistics.},
