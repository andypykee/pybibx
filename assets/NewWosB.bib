@inproceedings{ WOS:001453431700006,
Author = {Kharrat, Ons and Mohamed, Fatma Alzahra and Mtimet, Ikram and Benamor,
   Nour and Fourati, Chayma},
Editor = {Hdioud, B and Aouragh, SL},
Title = {HateTune: Tunisian Dialect Hate Speech Detection Dataset},
Booktitle = {ARABIC LANGUAGE PROCESSING: FROM THEORY TO PRACTICE, ICALP 2023, PT I},
Series = {Communications in Computer and Information Science},
Year = {2025},
