	journal = {2023 International Conference on Network, Multimedia and Information Technology, NMITCON 2023},
	pages = {},
	doi = {10.1109/NMITCON58196.2023.10275876},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85175401817&doi=10.1109%2FNMITCON58196.2023.10275876&partnerID=40&md5=fa0d9fb09af844969c49926ad1ba40b5},
	affiliations = {National Institute of Technology Meghalaya, Department of Computer Science and Engineering, Shillong, ML, India},
	abstract = {Hate speech in social media has become a significant concern in today's age, making detecting and analyzing hate speech accurately an area of high importance. Sentiment analysis can aid in automatically detecting hate speech and quantifying its severity, providing valuable insights to social media platforms and law enforcement agencies in taking appropriate action against hate speech. This study aimed to develop and evaluate a deep learning model for hate speech detection and scoring on social media platforms. LSTM and CNN deep learning classifiers were employed and evaluated using standard metrics such as Test Accuracy, Precision, Recall, and F1 Score. The LSTM model performed the best, with 82.67% test accuracy. For regression, seven machine learning models and three deep learning models were tested, with a 3-layer deep learning regressor achieving the best score of 91.28%. The results suggest that deep learning models can effectively detect and categorize hate speech on social media platforms. © 2023 IEEE.},
