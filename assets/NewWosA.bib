@inproceedings{ WOS:000653090700043,
Author = {Rini and Utami, Ema and Hartanto, Anggit Dwi},
Book-Group-Author = {IEEE},
Title = {Systematic Literature Review Of Hate Speech Detection With Text Mining},
Booktitle = {PROCEEDINGS OF ICORIS 2020: 2020 THE 2ND INTERNATIONAL CONFERENCE ON
   CYBERNETICS AND INTELLIGENT SYSTEM (ICORIS)},
Year = {2020},
Pages = {228-233},
