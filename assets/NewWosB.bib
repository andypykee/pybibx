@inproceedings{ WOS:000649734800077,
Author = {Alsafari, Safa and Sadaoui, Samira and Mouhoub, Malek},
Editor = {Alamaniotis, M and Pan, S},
Title = {Deep Learning Ensembles for Hate Speech Detection},
Booktitle = {2020 IEEE 32ND INTERNATIONAL CONFERENCE ON TOOLS WITH ARTIFICIAL
   INTELLIGENCE (ICTAI)},
Series = {Proceedings-International Conference on Tools With Artificial
   Intelligence},
Year = {2020},
Pages = {526-531},
Note = {32nd IEEE International Conference on Tools with Artificial Intelligence
   (ICTAI), ELECTR NETWORK, NOV 09-11, 2020},
Organization = {IEEE; IEEE Comp Soc; Biol \& Artificial Intelligence Fdn},
Abstract = {Our study explores offensive and hate speech detection for the Arabic
   language, as previous studies are minimal. Based on two-class,
   three-class, and six-class Arabic-Twitter datasets, we develop single
   and ensemble CNN and BiLSTM classifiers that we train with
   non-contextual (Fasttext-SkipGram) and contextual (Multilingual Bert and
   AraBert) word-embedding models. For each hate/offensive classification
   task, we conduct a battery of experiments to evaluate the performance of
   single and ensemble classifiers on testing datasets. The average-based
   ensemble approach was found to be the best performing, as it returned
   F-scores of 91\%, 84\%, and 80\% for two-class, three-class and
   six-class prediction tasks, respectively. We also perform an error
   analysis of the best ensemble model for each task.},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
