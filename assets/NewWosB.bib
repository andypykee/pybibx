@inproceedings{ WOS:000491264200011,
Author = {Mondal, Mainack and Silva, Leandro Araujo and Benevenuto, Fabricio},
Book-Group-Author = {ACM},
Title = {A Measurement Study of Hate Speech in Social Media},
Booktitle = {PROCEEDINGS OF THE 28TH ACM CONFERENCE ON HYPERTEXT AND SOCIAL MEDIA
   (HT'17)},
Year = {2017},
Pages = {85-94},
Note = {28th ACM International Conference on Hypertext and Social Media (HT),
   Prague, CZECH REPUBLIC, JUL 04-07, 2017},
Organization = {Assoc Comp Machinery; ACM SIGWEB; ACM SIGCHI},
Abstract = {Social media platforms provide an inexpensive communication medium that
   allows anyone to quickly reach millions of users. Consequently, in these
   platforms anyone can publish content and anyone interested in the
   content can obtain it, representing a transformative revolution in our
   society. However, this same potential of social media systems brings
   together an important challenge-these systems provide space for
   discourses that are harmful to certain groups of people. This challenge
   manifests itself with a number of variations, including bullying,
   offensive content, and hate speech. Specifically, authorities of many
   countries today are rapidly recognizing hate speech as a serious
   problem, specially because it is hard to create barriers on the Internet
   to prevent the dissemination of hate across countries or minorities. In
   this paper, we provide the first of a kind systematic large scale
   measurement and analysis study of hate speech in online social media. We
   aim to understand the abundance of hate speech in online social media,
   the most common hate expressions, the effect of anonymity on hate speech
   and the most hated groups across regions. In order to achieve our
   objectives, we gather traces from two social media systems: Whisper and
   Twitter. We then develop and validate a methodology to identify hate
   speech on both of these systems. Our results identify hate speech forms
   and unveil a set of important patterns, providing not only a broader
   understanding of online hate speech, but also offering directions for
   detection and prevention approaches.},
