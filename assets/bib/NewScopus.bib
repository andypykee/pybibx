	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

@CONFERENCE{Zufall202253,
	author = {Zufall, Frederike and Hamacher, Marius and Kloppenborg, Katharina and Zesch, Torsten},
	title = {A Legal Approach to Hate Speech - Operationalizing the EU's Legal Framework against the Expression of Hatred as an NLP Task},
	year = {2022},
	journal = {NLLP 2022 - Natural Legal Language Processing Workshop 2022, Proceedings of the Workshop},
	pages = {53 - 64},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85154585284&partnerID=40&md5=3c29b0317bad5cbb2517b4845295a999},
	affiliations = {Max Planck Institute for Research On Collective Goods, Bonn, Nordrhein-Westfalen, Germany; Waseda Institute for Advanced Study, Tokyo, Japan; FernUniversität in Hagen, Computational Linguistics, Hagen, Nordrhein-Westfalen, Germany; Université Paris Cité, Paris, Ile-de-France, France},
	abstract = {We propose a 'legal approach' to hate speech detection by operationalization of the decision as to whether a post is subject to criminal law into an NLP task. Comparing existing regulatory regimes for hate speech, we base our investigation on the European Union's framework as it provides a widely applicable legal minimum standard. Accurately deciding whether a post is punishable or not usually requires legal education. We show that, by breaking the legal assessment down into a series of simpler sub-decisions, even laypersons can annotate consistently. Based on a newly annotated dataset, our experiments show that directly learning an automated model of punishable content is challenging. However, learning the two sub-tasks of 'target group' and 'targeting conduct' instead of a holistic, end-to-end approach to the legal assessment yields better results. Overall, our method also provides decisions that are more transparent than those of end-to-end models, which is a crucial point in legal decision-making. © 2022 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Decision making; Laws and legislation; Learning systems; Annotated datasets; Automated modelling; Breakings; Criminal laws; European union; Legal educations; Legal frameworks; Regulatory regime; Simple++; Speech detection; Natural language processing systems},
	publisher = {Association for Computational Linguistics (ACL)},
	isbn = {9781959429180},
	language = {English},
	abbrev_source_title = {NLLP - Nat. Legal Lang. Process. Workshop, Proc. Workshop},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9}
}

@CONFERENCE{Vanetik202268,
	author = {Vanetik, Natalia and Talker, Sagiv and Machlouf, Or and Litvak, Marina},
