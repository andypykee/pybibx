@inproceedings{ WOS:001569143300010,
Author = {Wu, Zheng and Li, Xiang and Zhang, Xiaoming and Wang, Tianbo},
Editor = {Huang, DS and Zhang, C and Zhang, Q and Pan, Y},
Title = {Explaining Implicit Offensive Language in Dialogues},
Booktitle = {ADVANCED INTELLIGENT COMPUTING TECHNOLOGY AND APPLICATIONS, ICIC 2025,
   PT IX},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Volume = {15850},
