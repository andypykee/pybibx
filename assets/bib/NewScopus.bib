@CONFERENCE{Vishak Anand2024,
	author = {Vishak Anand, S. and Prathap, Ishwar and Gupta, Deepa and Nair, Aarathi Rajagopalan},
	title = {Enhancing Hate Speech Detection in Tamil Code-Mix Content: A Deep Learning Approach with Multilingual Embeddings},
	year = {2024},
	journal = {2024 5th IEEE Global Conference for Advancement in Technology, GCAT 2024},
	pages = {},
	doi = {10.1109/GCAT62922.2024.10923906},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002250780&doi=10.1109%2FGCAT62922.2024.10923906&partnerID=40&md5=b78140ca4e6c6e4042f188735c606f7d},
	affiliations = {Amrita Vishwa Vidyapeetham University, Bangalore, Bengaluru, KA, India},
	abstract = {The increasing amount of hate speech and language which are inappropriate on platforms of social media has emerged as a serious issue, prompting measures to counter it. This study examines hate speech and languages that are objectionable in a Tamil Code-Mix dataset, where Tamil content is provided in English. It assesses the performance of various deep learning classifiers that use different multilingual transformer embedding models, which includes many models such as DistilBERT, IndicBERT, XLM-RoBERTa, LASER, MuRIL, and BERT, in this domain. Among the models tested, an ensemble stacked model integrating Long Short-Term Memory and Gated Recurrent Units with XLM-RoBERTa embeddings had the greatest accuracy (0.76) and weighted F1-score (0.72). This exceptional performance underscores the potential of advanced ensemble models for distinguishing hate speech in code-mixed languages. The study's findings are notable for several reasons. They enhance understanding of hate speech in Tamil, particularly in its code-mixed variant, and offer insights into the application of advanced deep learning methods and multilingual embeddings for detecting harmful content. By improving accuracy and reliability in hate speech detection, this research contributes to fostering safer and more inclusive online environments for Tamil-speaking communities. In summary, the research advances the domain of hate speech identification and emphasizes the importance of technological solutions in creating more safer and very inclusive online spaces. © 2024 IEEE.},
	author_keywords = {Deep learning models; Hate speech; Natural Language Processing; Tamil codemix text; Transformer model word embedding},
	keywords = {Adversarial machine learning; Long short-term memory; Natural language processing systems; Speech enhancement; Speech recognition; Deep learning model; Embeddings; Hate speech; Language processing; Learning models; Natural language processing; Natural languages; Tamil codemix text; Transformer model word embedding; Transformer modeling; Contrastive Learning},
	correspondence_address = {S. Vishak Anand; Amrita Vishwa Vidyapeetham, Amrita School of Computing, Department of Computer Science and Engineering, Bengaluru, India; email: vishakanand25@outlook.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798350376685},
	language = {English},
	abbrev_source_title = {IEEE Glob. Conf. Adv. Technol., GCAT},
	type = {Conference paper},
	publication_stage = {Final},
