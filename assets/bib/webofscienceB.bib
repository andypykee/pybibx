@article{ WOS:001274219800001,
Author = {Najafi, Ali and Varol, Onur},
Title = {TurkishBERTweet: Fast and reliable large language model for social media
   analysis},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2024},
Volume = {255},
Number = {C},
Month = {DEC 1},
Abstract = {Turkish is one of the most spoken languages in the world; however, it is
   still among the low-resource languages. Wide us of this language on
   social media platforms such as Twitter, Instagram, or Tiktok and
   strategic position of the country in the world politics makes it
   appealing for the social network researchers and industry. To address
   this need, we introduce TurkishBERTweet, the first large scale
   pre-trained language model for Turkish social media built using over 894
   million Turkish tweets. The model shares the same architecture as
   RoBERTa-base model with smaller input length, making TurkishBERTweet
   lighter than the most used model, called BERTurk, and can have
   significantly lower inference time. We trained our model using the same
   approach for RoBERTa model and evaluated on two tasks: Sentiment
   Classification and Hate Speech Detection. We demonstrate that
   TurkishBERTweet outperforms the other available alternatives on
   generalizability and its lower inference time gives significant
   advantage to process large-scale datasets. We also show custom
   preprocessors for social media can acquire information from platform
   specific entities. We also conduct comparison with the commercial
   solutions like OpenAI and Gemini, and other available Turkish LLMs in
   terms of cost and performance to demonstrate TurkishBERTweet is scalable
   and cost-effective.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Varol, O (Corresponding Author), Sabanci Univ, Fac Engn \& Nat Sci, Istanbul, Turkiye.
   Najafi, Ali; Varol, Onur, Sabanci Univ, Fac Engn \& Nat Sci, Istanbul, Turkiye.
   Varol, Onur, Sabanci Univ, Ctr Excellence Data Analyt, Istanbul, Turkiye.},
DOI = {10.1016/j.eswa.2024.124737},
EarlyAccessDate = {JUL 2024},
Article-Number = {124737},
