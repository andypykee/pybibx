	keywords = {Electronic crime countermeasures; Forensic engineering; Image retrieval; k-nearest neighbors; Online searching; Self-supervised learning; Support vector regression; Crime investigation; Cybe crime investigation; Cyber-crimes; Machine learning algorithms; Machine learning techniques; Machine-learning; Offensive languages; Social media; Social media platforms; Social medium investigation; Computer forensics},
