	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85191532323&doi=10.1109%2FIIAI-AAI-Winter61682.2023.00066&partnerID=40&md5=4b09c558f4b9962a58950ece75dbb129},
	affiliations = {The University of Electro-Communications, Department of Informatics, Chofu, Tokyo, Japan},
	abstract = {On social media, misinformation can spread quickly, posing severe problems. Because of the content and sensitive nature of fake information, it is critical to prevent the damage caused by them. The objectives of this study are to analyze the characteristics of human expression and based on the results, to successfully detect fake news by implementing different machine learning models in a low-resource language. A transformer-based hybrid ensemble model was employed on datasets in a resource-constrained language, Bangla. Using various text-classification tasks, such as sentiment analysis, emotion analysis, hate speech detection, irony detection, and grammatical analysis, we initially attempted to comprehend news from numerous perspectives. In the first part of this study, several pretrained BERT models were used to successfully calculate prediction scores. Scores were effectively generated from all the pretrained text-classification models. In the second part, the voting regressor and boosting algorithm were implemented. The voting regressor was implemented on the prediction scores achieved from all the text-classification tasks, and the boosting algorithm was subsequently implemented. The proposed model exhibited excellent performance. The accuracy (0.98), precision (0.98), recall (0.99), f1-score (0.99), and AUC score (0.92) indicated excellent performance. This study proposes an accurate model on Bangla. © 2023 IEEE.},
