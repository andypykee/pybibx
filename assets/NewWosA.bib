Title = {Generation-Based Data Augmentation for Offensive Language Detection: Is
   It Worth It?},
Booktitle = {17TH CONFERENCE OF THE EUROPEAN CHAPTER OF THE ASSOCIATION FOR
   COMPUTATIONAL LINGUISTICS, EACL 2023},
Year = {2023},
Pages = {3359-3377},
