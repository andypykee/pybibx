Title = {Prototype Design of a Multi-modal AI-Based Web Application for Hateful
   Content Detection in Social Media Posts},
Booktitle = {SENSE, FEEL, DESIGN, INTERACT 2021},
Series = {Lecture Notes in Computer Science},
Year = {2022},
Volume = {13198},
