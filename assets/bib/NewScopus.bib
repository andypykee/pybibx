@CONFERENCE{Cuccarini2024,
	author = {Cuccarini, Marco and Draetta, Lia and Ferrando, Chiara and James, Liam and Patti, Viviana},
	title = {ReCLAIM Project: Exploring Italian Slurs Reappropriation with Large Language Models},
	year = {2024},
	journal = {CEUR Workshop Proceedings},
	volume = {3878},
	pages = {},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85214433530&partnerID=40&md5=93ea6a511dc6c69572697b1cbc657773},
	affiliations = {Università degli Studi di Napoli Federico II, Department of Biology, Naples, NA, Italy; Università degli Studi di Perugia, Department of Mathematics and Computer Science, Perugia, PG, Italy; Università degli Studi di Torino, Department of Computer Science, Turin, TO, Italy; Alma Mater Studiorum Università di Bologna, Bologna, BO, Italy},
	abstract = {Recently, social networks have become the primary means of communication for many people, leading computational linguistics researchers to focus on the language used on these platforms. As online interactions grow, recognizing and preventing offensive messages targeting various groups has become urgent. However, finding a balance between detecting hate speech and preserving free expression while promoting inclusive language is challenging. Previous studies have highlighted the risks of automated analysis misinterpreting context, which can lead to the censorship of marginalized groups. Our study is the first to explore the reappropriative use of slurs in Italian by leveraging Large Language Models (LLMs) with a zero-shot approach. We revised annotations of an existing Italian homotransphobic dataset, developed new guidelines, and designed various prompts to address the LLMs task. Our findings illustrate the difficulty of this challenge and provide preliminary results on using LLMs for such a language specific task. © 2024 CEUR-WS. All rights reserved.},
	author_keywords = {Homostransphobia detection; Large Language Models; Natural Language Processing; Semantic requalification process; Slurs},
	keywords = {Computational linguistics; Context free languages; Economic and social effects; Natural language processing systems; Risk analysis; Risk assessment; Slurries; Social networking (online); Translation (languages); Homostransphobia detection; Language model; Language processing; Large language model; Natural language processing; Natural languages; Online interaction; Re-qualification; Semantic requalification process; Slur; Semantics},
	editor = {Dell'Orletta, F. and Lenci, A. and Montemagni, S. and Sprugnoli, R.},
	publisher = {CEUR-WS},
	issn = {16130073},
