Title = {A Novel HybridModel of Word Embedding and Deep Learning to Identify Hate
   and Abusive Content on Social Media Platform},
Booktitle = {FRONTIERS OF ARTIFICIAL INTELLIGENCE, ETHICS, AND MULTIDISCIPLINARY
