	doi = {10.1109/ICIMIA67127.2025.11200817},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021928255&doi=10.1109%2FICIMIA67127.2025.11200817&partnerID=40&md5=57a5c96df57699ae002a6e216fffab2f},
