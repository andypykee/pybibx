@CONFERENCE{Darchuk202468,
	author = {Darchuk, Nataliia P. and Zuban, Oksana and Robeiko, Valentyna and Tsyhvintseva, Yuliia and Sazhok, Mykola M.},
	title = {Toxicity Detection for Ukrainian-Language Texts in the TextAttributor System},
	year = {2024},
	journal = {CEUR Workshop Proceedings},
	volume = {3909},
	pages = {68 - 83},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85217275413&partnerID=40&md5=8a5ee2ac411ba6a8ebbe07b6f27885c3},
	affiliations = {Taras Shevchenko National University of Kyiv, Kyiv, Ukraine; National Academy of Sciences of Ukraine, International Centre for Information Technologies and Systems, Kyiv, Ukraine; Institute of the Ukrainian Language of the National Academy of Sciences of Ukraine, Kyiv, Ukraine},
	abstract = {This paper presents the development and results of two distinct modules designed to detect toxic language in Ukrainian texts, primarily implemented within the "TextAttributor 1.0" expert system. The first module utilizes a rule-based approach, analyzing text through predefined linguistic rules and lexicon-based methods, while the second employs machine learning techniques, specifically leveraging the fastText and LLAMA-3 models, to automatically detect toxic content. The rule-based module outputs a detailed linguistic analysis, mapping toxic vocabulary using a precompiled lexicographic database, while the machine learning module calculates toxicity based on statistical models. The performance of both methods was evaluated by comparing their results on a corpus of Ukrainian texts, with the Pearson correlation coefficient employed to assess their alignment. The results demonstrate the system's capacity to effectively identify toxic content, contributing to ongoing efforts to mitigate the spread of harmful information. This paper contains rude texts that only serve as illustrative examples. © 2024 Copyright for this paper by its authors.},
	author_keywords = {deep learning; lexicon-based method; sentiment analysis; text classification; toxic text detection; Ukrainian language},
	keywords = {Adversarial machine learning; Deep learning; Linguistics; Lexicon-based; Lexicon-based method; Rule based; Sentiment analysis; Text classification; Text detection; Toxic text detection; Toxicity detection; Ukrainian language; Expert systems},
	correspondence_address = {O. Zuban; Taras Shevchenko National University ofKyiv, Kyiv, 60 Volodymyrska Street, 01033, Ukraine; email: oxana.zuban@knu.ua; M. Sazhok; Institute for Information Technologies and Systems, the National Academy of Sciences of Ukraine, Kyiv, 40 prospekt Akademika Hlushkova, 03187, Ukraine; email: sazhok@gmail.com},
	editor = {Anisimov, A. and Snytyuk, V. and Chris, A. and Pester, A. and Mallet, F. and Krak, I. and Cogan, N. and Chertov, O. and Marchenko, O. and Bozoki, S. and Needham, T. and Tsyganok, V. and Vovk, V.},
