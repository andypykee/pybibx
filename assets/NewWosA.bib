@inproceedings{ WOS:001598869300027,
Author = {Haturusinghe, Shanilka and Weerasooriya, Tharindu Cyril and Zampieria,
   Marcos and Homan, Christopher M. and Liyanage, S. R.},
Editor = {Haider, S and Liu, E and Ebrahimi, A and Haider, S and Pacheco, ML and Wein, S},
Title = {Subasa - Adapting Language Models for Low-resourced Offensive Language
   Detection in Sinhala},
Booktitle = {PROCEEDINGS OF THE 2025 CONFERENCE OF THE NATIONS OF THE AMERICAS
   CHAPTER OF THE ASSOCIATION FOR COMPUTATIONAL LINGUISTICS: HUMAN LANGUAGE
   TECHNOLOGIES, VOL 4: STUDENT RESEARCH WORKSHOP},
