@CONFERENCE{Tang20201045,
	author = {Tang, Xiangru and Shen, Xianjun and Wang, Yujie and Yang, Yujuan},
	title = {Categorizing Offensive Language in Social Networks: A Chinese Corpus, Systems and an Explanation Tool},
	year = {2020},
	journal = {19th Chinese National Conference on Computational Linguistic, CCL 2020},
	pages = {1045 - 1056},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85123919370&partnerID=40&md5=86899e66873a71f570d86840ecef7e02},
	affiliations = {Central China Normal University, School of Computer, Wuhan, Hubei, China},
	abstract = {Recently, more and more data have been generated in the online world, filled with offensive language such as threats, swear words or straightforward insults. It is disgraceful for a progressive society, and then the question arises on how language resources and technologies can cope with this challenge. However, previous work only analyzes the problem as a whole but fails to detect particular types of offensive content in a more fine-grained way, mainly because of the lack of annotated data. In this work, we present a densely annotated data-set COLA (Categorizing Offensive LAnguage), consists of fine-grained insulting language, antisocial language and illegal language. We study different strategies for automatically identifying offensive language on COLA data. Further, we design a capsule system with hierarchical attention to aggregate and fully utilize information, which obtains a state-of-the-art result. Results from experiments prove that our hierarchical attention capsule network (HACN) performs significantly better than existing methods in offensive classification with the precision of 94.37% and recall of 95.28%. We also explain what our model has learned with an explanation tool called Integrated Gradients. Meanwhile, our system's processing speed can handle each sentence in 10msec, suggesting the potential for efficient deployment in real situations. © 2020 China National Conference on Computational Linguistics},
	keywords = {Classification (of information); Computational linguistics; Capsule system; Chinese corpus; Data set; Fine grained; Language resources; Language technology; Offensive languages; Processing speed; Real situation; State of the art; Social networking (online)},
	correspondence_address = {X. Shen; School of Computer, Central China Normal University, China National Language Resources Monitoring and Research Center for Network Media, China Hubei Provincial Key Laboratory of Artificial Intelligence and Smart Learning, China; email: xjshen@mail.ccnu.edu},
	editor = {Sun, M. and Li, S. and Zhang, Y. and Liu, Y.},
	publisher = {Chinese National Conference on Computational Linguistic},
	language = {English},
	abbrev_source_title = {Chin. Nat. Conf. Comput. Linguist., CCL},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

