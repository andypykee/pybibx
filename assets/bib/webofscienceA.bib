@inproceedings{ WOS:001281001900227,
Author = {Younes, Mutaz and Kharabsheh, Ali and Younes, Mohammad Bani},
Editor = {Ojha, AK and Dogruoz, AS and Madabushi, HT and Kumar, R and Sartori, E and DaSanMartino, G},
Title = {Alexa at SemEval-2023 Task 10: Ensemble Modeling of DeBERTa and BERT
   Variations for Identifying Sexist Text},
Booktitle = {17TH INTERNATIONAL WORKSHOP ON SEMANTIC EVALUATION, SEMEVAL-2023},
Series = {International Workshops on Semantic Evaluation},
Year = {2023},
Pages = {1644-1649},
Note = {17th International Workshop on Semantic Evaluation (SemEval), Toronto,
   CANADA, JUL 13-14, 2023},
Organization = {ACL Special Interest Grp Lexicon},
Abstract = {This study presents an ensemble approach for detecting sexist text in
   the context of the Semeval-2023 task 10. Our approach leverages 18
   models, including DeBERTa-v3-base models with different input sequence
   lengths, a BERT-based model trained on identifying hate speech, and
   three more models pre-trained on the task's unlabeled data with varying
   input lengths. The results of our framework on the development set show
   an f1-score of 84.92\% and on the testing set 84.55\%, effectively
   demonstrating the strength of the ensemble approach in getting accurate
   results.},
Publisher = {ASSOC COMPUTATIONAL LINGUISTICS-ACL},
Address = {209 N EIGHTH STREET, STROUDSBURG, PA 18360 USA},
Type = {Proceedings Paper},
Language = {English},
