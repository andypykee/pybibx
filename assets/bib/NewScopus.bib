@ARTICLE{Wojatzki2018110,
	author = {Wojatzki, Michael and Horsmann, Tobias and Gold, Darina and Zesch, Torsten},
	title = {Do women perceive hate differently: Examining the relationship between hate speech, gender, and agreement judgments},
	year = {2018},
	journal = {KONVENS 2018 - Conference on Natural Language Processing / Die Konferenz zur Verarbeitung Naturlicher Sprache},
	pages = {110 - 120},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85064209796&partnerID=40&md5=c9d249a3ca673486546109c256950504},
	affiliations = {Universität Duisburg-Essen, Language Technology Lab, Duisburg, Nordrhein-Westfalen, Germany},
	abstract = {Understanding hate speech remains a significant challenge for both creating reliable datasets and automated hate speech detection. We hypothesize that being part of the targeted group or personally agreeing with an assertion substantially effects hate speech perception. To test these hypotheses, we create FEMHATE - a dataset containing 400 assertions that target women. These assertion are judged by female and male subjects for (i) how hateful these assertions are and (ii) for whether they agree with the assertions. We find that women and men consistently evaluate extreme cases of hate speech. We also find a strong relationship between hate speech and agreement judgments, showing that a low agreement score is a prerequisite for hate speech. We show how this relationship can be used for automatic hate speech detection. Our best system based on agreement judgments outperforms a baseline SVM classifier (equipped with ngrams) by a wide margin. © KONVENS 2018 - Conference on Natural Language Processing / Die Konferenz zur Verarbeitung Naturlicher Sprache.All right reserved.},
	keywords = {Natural language processing systems; Speech; Statistical tests; N-grams; Speech detection; Speech perception; SVM classifiers; Speech recognition},
	publisher = {Austrian Academy of Sciences webmaster@oeaw.ac.at},
	language = {English},
	abbrev_source_title = {KONVENS - Conf. Nat. Lang. Process. / Konf. Verarb. Naturlicher Sprache},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 15}
}

