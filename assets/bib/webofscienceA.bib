@inproceedings{ WOS:001481696900053,
Author = {Wang, Yuzhang and Yu, Peizhou and He, Guoxiu},
Editor = {Wu, J and Hu, X and Nurmikko-Fuller, T and Chu, S and Yang, R and Downie, JS},
Title = {Silent LLMs: Using LoRA to Enable LLMs to Identify Hate Speech},
Booktitle = {PROCEEDINGS OF THE 24TH ACM/IEEE JOINT CONFERENCE ON DIGITAL LIBRARIES,
   JCDL 2024},
Series = {ACM-IEEE Joint Conference on Digital Libraries JCDL},
Year = {2024},
Note = {24th ACM/IEEE Joint Conference on Digital Libraries-JCDL, University of
   Hong Kong, Hong Kong, PEOPLES R CHINA, DEC 16-20, 2024},
Organization = {Acm; ACM Special Interest Group on Information Retrieval; Institute of
   Electrical and Electronics Engineers Inc; Clarivate; IEEE Computer
   Society; The Institution of Engineering and Technology; National Science
   Foundation; Nanjing University School of Information Management;
   University of Colorado Boulder University Libraries; University of North
   Texas Willis Library},
Abstract = {The detection of hate speech on social networks presents significant
   challenges due to its increasingly subtle nature. The advent of large
   language models (LLMs) has revolutionized text understanding and
   generation, presenting novel avenues for hate speech detection. This
   study evaluates the performance of the ChatGLM model in detecting hate
   speech through a small sample prompt method. Our analysis uncovers three
   key limitations when employing the LLMs to directly generate answers:
   inconsistency in output format, the illusion of comprehensiveness
   inherent in LLMs, and the inability to respond due to security concerns.
   To mitigate these limitations, we investigate four LLMs: LLaMA, Llama-2,
   Llama-3, and ChatGLM-3. These models are equipped with Multi-Layer
   Perception (MLP) and Low-Rank Adaptation (LoRA), which specifically
   tailored for hate speech detection. Extensive comparisons with baseline
   models are conducted across three hate speech datasets with six
