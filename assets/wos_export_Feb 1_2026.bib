Title = {Low-Resource Dataset Synthetic Generation for Hate Speech Detection},
Booktitle = {WEB INFORMATION SYSTEMS ENGINEERING-WISE 2024 PHD SYMPOSIUM, DEMOS AND
   WORKSHOPS, WEB-FOR-GOOD 2024, AIWDA 2024, SWIFT-AG 2024, AND DEMOS},
