@inproceedings{ WOS:000458168000040,
Author = {Pelle, Rogers and Alcantara, Cleber and Moreira, Viviane P.},
Book-Group-Author = {Assoc Comp Machinery},
Title = {A Classifier Ensemble for Offensive Text Detection},
Booktitle = {WEBMEDIA'18: PROCEEDINGS OF THE 24TH BRAZILIAN SYMPOSIUM ON MULTIMEDIA
   AND THE WEB},
Year = {2018},
Pages = {237-243},
