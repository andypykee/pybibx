@article{ WOS:000677600400001,
Author = {Perifanos, Konstantinos and Goutsos, Dionysis},
Title = {Multimodal Hate Speech Detection in Greek Social Media},
Journal = {MULTIMODAL TECHNOLOGIES AND INTERACTION},
