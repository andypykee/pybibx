   Paulo and Marana, Aparecido Nilceu},
Editor = {Hernandez-Garcia, R and Barrientos, RJ and Velastin, SA},
Title = {Hate Speech Detection in Portuguese Using BERTimbau},
Booktitle = {PROGRESS IN PATTERN RECOGNITION, IMAGE ANALYSIS, COMPUTER VISION, AND
