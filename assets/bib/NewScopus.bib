	title = {IndoBERT-Based Ensemble Learning for Multi-Level Multi-Label Hate Speech Detection in Indonesian Social Media},
	year = {2024},
	journal = {2024 Beyond Technology Summit on Informatics International Conference, BTS-I2C 2024},
	pages = {456 - 461},
	doi = {10.1109/BTS-I2C63534.2024.10942204},
