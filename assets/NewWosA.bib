Title = {Graph-Based Methods to Detect Hate Speech Diffusion on Twitter},
Booktitle = {2020 IEEE/ACM INTERNATIONAL CONFERENCE ON ADVANCES IN SOCIAL NETWORKS
   ANALYSIS AND MINING (ASONAM)},
Series = {Proceedings of the IEEE-ACM International Conference on Advances in
