	title = {LOD-connected offensive language ontology and tagset enrichment},
	year = {2021},
	journal = {CEUR Workshop Proceedings},
	volume = {3064},
	pages = {},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85126015890&partnerID=40&md5=de525ee6718b01bdae7d283e248ba10d},
	affiliations = {State University of Applied Sciences, Department of Language and Communication, Konin, Poland; Univerza v Ljubljani, Faculty of Computer and Information Science, Ljubljana, Slovenia; Uniwersytet Gdański, Department of Glottodidactics and Natural Language Processing, Gdansk, Pomeranian, Poland; Jerusalem College of Technology, Department of Computer Science, Jerusalem, Israel; Universität Passau, Passau, Bayern, Germany; The Institute for Artificial Intelligence Research and Development of Serbia, Novi Sad, Serbia; Mykolas Romeris University, Institute of Humanities, Vilnius, Vilnius, Lithuania},
	abstract = {The main focus of the paper is the definitional revision and enrichment of offensive language typology, making reference to publicly available offensive language datasets and testing them on available pre-trained lexical embedding systems. We review over 60 available corpora and compare tagging schemas applied there while making an attempt to explain semantic differences between particular concepts of the category OFFENSIVE in English. A finite set of classes that cover aspects of offensive language representation along with linguistically sound explanations is presented, based on the categories originally proposed by Zampieri et al. [1, 2] in terms of offensive language categorization schemata and tested by means of Sketch Engine tools on a large web-based corpus. The schemata are juxtaposed and discussed with reference to non-contextual word embeddings FastText, Word2Vec, and Glove. The methodology for mapping from existing corpora to a unified ontology as presented in this paper is provided. The proposed schema will enable further comparable research and effective use of corpora of languages other than English. It will also be applied in building an enriched tagset to be trained and used on new data, with the application of recently developed LLOD techniques [3]. © 2021 Copyright for this paper by its authors},
	author_keywords = {Automatic offensive language detection; Offensive language; Ontological modelling; Ontologies; Sketch engine; Tagset enrichment; Tagsets; Word embeddings},
	keywords = {Engines; Modeling languages; Ontology; Semantics; Automatic offensive language detection; Embeddings; Language detection; Offensive languages; Ontological modeling; Ontology's; Sketch engine; Tagset; Tagset enrichment; Word embedding},
