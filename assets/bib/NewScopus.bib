@CONFERENCE{Debnath2025,
	author = {Debnath, Pranti and Debnath, Anik Kumar},
	title = {Multi-Class Cyberbullying Analysis in Bengali: A Comparative Study of BERT-Based Deep Learning Models},
	year = {2025},
	journal = {2025 2nd International Conference on Next-Generation Computing, IoT and Machine Learning, NCIM 2025},
	pages = {},
	doi = {10.1109/NCIM65934.2025.11159869},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105017970841&doi=10.1109%2FNCIM65934.2025.11159869&partnerID=40&md5=8117c7a588f938d569465d7bb71b3e65},
	affiliations = {Chittagong University of Engineering and Technology, Department of Electronics and Telecommunication Engineering, Chittagong, Bangladesh; Chittagong University of Engineering and Technology, Department of Mechatronics and Industrial Engineering, Chittagong, Bangladesh},
	abstract = {The rise of social media has increased online harassment and bullying, which is a big challenge for individuals and society. Their detection and addressing require advanced tools, especially for under-resourced languages like Bengali, which lack datasets and processing tools. Cyberbullying analysis, generally used to understand opinions and emotions, can also be applied to detect social media bullying. This paper investigates transformer based models for the detection of Cyberbullying related content in Bengali and puts special focus on the BanglaBERT model. In this regard, a dataset consisting of 42,036 Bengali social media comments is used, which was created by combining two publicly available datasets: "Multi-class Bangla social media comments"and "Bangla online comments dataset". The dataset consists of four classes: Political, Religious, Sexual, and Not Bully. The results show that the BanglaBERT model performs best, achieving 90% accuracy, and 91% F1-score, outperforming all other BERT models. This research has given importance to the pre-trained models designed for a low resource language and set a new benchmark for detecting social media bullying in the Bengali language. Overall, it highlights the potential of advanced NLP models to address the pressing issue of online harassment efficiently. © 2025 IEEE.},
	author_keywords = {BanglaBERT; Cyberbullying; Deep Learning; Multi-class; NLP},
