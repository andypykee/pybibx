DOI = {10.1145/3580494},
Article-Number = {264},
ISSN = {0360-0300},
EISSN = {1557-7341},
Keywords = {Toxic speech; hate speech; social networks; unintended bias; bias
   mitigation; bias shift},
Keywords-Plus = {COGNITION},
Research-Areas = {Computer Science},
