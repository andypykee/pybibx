@ARTICLE{Pokkuluri202545,
	author = {Pokkuluri, Kiran Sree and Sivakoti, Ramadevi and Raja Rao, P. B.V. and Murthy, Poppoppula T.Satyanarayana and Nagaraju, P. and Phaneendra Varma, Ch Varma and Ramesh Babu, Gurujukota and Usha Devi, S. S.S.N.},
	title = {Hate Speech Detection Using Recurrent Neural Networks (RNN)},
	year = {2025},
	journal = {Lecture Notes of the Institute for Computer Sciences, Social-Informatics and Telecommunications Engineering, LNICST},
	volume = {599 LNICST},
	pages = {45 - 51},
	doi = {10.1007/978-3-031-77081-4_5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85219165508&doi=10.1007%2F978-3-031-77081-4_5&partnerID=40&md5=ccad8b403ddea87840ce4c54f8368f9c},
	affiliations = {Shri Vishnu Engineering College For Women, Department of Computer Science and Engineering, Bhimavaram, AP, India; JNTUK University College of Engineering Kakinada, Department of Computer Science and Engineering, Kakinada, AP, India},
	abstract = {Hate speech detection is a vital task in the context of content moderation, aiming to identify and mitigate harmful language in online platforms. This abstract presents a methodology utilizing Recurrent Neural Networks (RNNs) for hate speech detection. We have processed a heterogeneous dataset containing occurrences of hate speech and non-hate speech & preprocessed the text data, and represent words as vectors using pre-trained word embedding’s. Our chosen RNN architecture, adept at capturing sequential dependencies, processes the contextual information within the text. During training, the model optimizes using a binary cross-entropy loss function and undergoes validation for hyper parameter tuning. The effectiveness of the RNN-based hate speech detection model is evaluated using accuracy, F1 score, precision and recall. This methodology provides a robust framework for combating hate speech in digital spaces, contributing to a safer and more inclusive online. We have compared our work with various base line methods with several parameters and achieved an accuracy of 96.89%. © ICST Institute for Computer Sciences, Social Informatics and Telecommunications Engineering 2025.},
	author_keywords = {Machine learning; RNN; Speech Recognition},
	keywords = {Speech recognition; Contextual information; Embeddings; Heterogeneous datasets; Machine-learning; Neural-networks; Online platforms; Recurrent neural network architectures; Sequential dependencies; Speech detection; Text data; Recurrent neural networks},
