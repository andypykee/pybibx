Title = {A Deep Multi-modal Neural Network for the Identification of Hate Speech
   from Social Media},
Booktitle = {RESPONSIBLE AI AND ANALYTICS FOR AN ETHICAL AND INCLUSIVE DIGITIZED
   SOCIETY, I3E 2021},
Series = {Lecture Notes in Computer Science},
Year = {2021},
Volume = {12896},
Pages = {670-680},
Note = {20th IFIP WG 6.11 Conference on e-Business, e-Services, and e-Society
   (I3E), Galway, IRELAND, SEP 01-03, 2021},
Organization = {Int Federat Automat Control},
Abstract = {Hate speech can be particularized as an intentional and chronic act to
   harm a single person or a group of individuals. This act can be
   performed via social networking websites such as Twitter, YouTube,
   Facebook, and more. Most of the existing approaches for finding hate
   speech are concentrated on either textual or visual information of the
   posted social media contents. In this work, a multimodal system is
   proposed that uses textual as well as the visual contents of the social
   media post to classify it into Racist, Sexist, Homophobic,
   Religion-based hate, Other hate and No hate classes. The proposed
   multi-modal system uses a convolutional neural network-based model to
   process text and a pre-trained VGG-16 network to process imagery
   contents. The performance of the proposed model is tested with the
   benchmark dataset and it achieved significant performance in classifying
   social media posts into six different hate classes.},
