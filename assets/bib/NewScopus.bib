}

@CONFERENCE{Sahin202371,
	author = {Sahin, Umitcan and Kucukkaya, Izzet Emre and Ozcelik, Oguzhan and Toraman, Cagri},
	title = {ARC-NLP at Multimodal Hate Speech Event Detection 2023: Multimodal Methods Boosted by Ensemble Learning, Syntactical and Entity Features},
	year = {2023},
	journal = {CASE 2023 - Proceedings of the 6th Workshop on Challenges and Applications of Automated Extraction of Socio-Political Events from Text, associated with 14th International Conference on Recent Advances in Natural Language Processing, RANLP 2023},
