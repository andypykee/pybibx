@article{ WOS:001640019900001,
Author = {Aggarwal, Sajal and Chhabra, Anusha and Vishwakarma, Dinesh Kumar},
Title = {Multimodal hateful meme detection using knowledge distillation and
   hierarchical vision transformer framework},
Journal = {ENGINEERING APPLICATIONS OF ARTIFICIAL INTELLIGENCE},
Year = {2026},
Volume = {165},
Number = {B},
Month = {FEB 1},
Abstract = {Social media platforms must incorporate automated hate content detection
   since the propagation of such material can unnerve users and incite
   significant societal backlash. Memes, a form of multimedia content, are
   gaining considerable popularity online. Although the primary purpose of
   most memes is to entertain, some of them pose serious concerns by
   employing dark humour to spread hateful content. Motivated by the
   criticality of this problem and the scope for further exploration in
   multimodal hateful content detection, we propose a novel framework for
   identifying hateful content in memes consisting of both textual and
   visual content. The major contributions of this study are: (1) an
   attentional knowledge distillation-based textual feature extraction
   pipeline to acquire the vital information from the linguistic component
   of the meme samples; (2) a potent visual feature extractor based on a
   hierarchical vision transformer to help encapsulate the visual
   information from memes; (3) extensive experimental investigations
   conducted using three benchmark datasets, including Multi Modal Hate
   Speech Dataset, Multimodal Meme Dataset for Offensive Content, and
   Facebook's Hateful Memes Challenge; (4) superior outcomes (accuracy of
   80.70 \%, 62.85 \%, and 87.80 \% respectively on the three datasets)
   compared to cutting-edge methods when evaluated using various metrics;
   and (5) cross-dataset generalization study that establishes the ability
   of the proposed framework to detect hateful content in out-of-dataset
   samples. The efficacy of the proposed framework is further reinforced by
   additional experiments, such as ablation trials and qualitative
   visualization using class activation maps.},
