	doi = {10.1109/ICISCT64202.2024.10956568},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003909987&doi=10.1109%2FICISCT64202.2024.10956568&partnerID=40&md5=362ae668b2bc5f2586a36cdce958e4ed},
