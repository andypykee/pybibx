   Bin},
Editor = {Fazio, M and Panda, DK and Prodan, R and Cardellini, V and Kantarci, B and Rana, O and Villari, M},
Title = {A Generalized Model for Crowd Violence Detection Focusing on Human
   Contour and Dynamic Features},
Booktitle = {2022 22ND IEEE/ACM INTERNATIONAL SYMPOSIUM ON CLUSTER, CLOUD AND
   INTERNET COMPUTING (CCGRID 2022)},
