@inproceedings{ WOS:001593512300491,
Author = {Lobo, Paula Reyero and Daga, Enrico and Alani, Harith and Fernandez,
   Miriam},
Editor = {Endriss, u and Melo, FS and Bach, K and Bugarin-Diz, A and Alonso-Moral, JM and Barro, S and Heintz, F},
Title = {Enhancing Hate Speech Annotations with Background Semantics},
Booktitle = {ECAI 2024},
Series = {Frontiers in Artificial Intelligence and Applications},
Year = {2024},
Volume = {392},
Pages = {3923-3930},
Note = {27th European Conference on Artificial Intelligence-ECAI-Biennial,
   Santiago de Compostela, SPAIN, OCT 19-24, 2024},
Organization = {Universidade de Santiago de Compostela},
Abstract = {Most automated hate speech detection models rely on human annotations
   for training and evaluation. Logic and research indicate that people who
   belong to groups targeted by hate speech are better at identifying it,
   often due to their increased familiarity with the topic and associated
   hate speech terminology. However, most hate speech annotation practices
   overlook this issue, and hence the labels produced tend to have a
   reduced accuracy. In this paper, we describe an approach where the text
   to be annotated is supplemented with background semantics, to expose the
   meaning of hate speech terminology that is less likely to be known to
   general annotators. We test the impact of this approach by measuring
   change in inter-annotator agreement, before and after introducing
   semantics, between two groups of annotators; those who belong to the
   target group of hate speech, and those who are not. Our experiments show
   that infusing text with semantic background increases inter-annotator
   agreement by up to 11.3\% on average, aligning the annotations from
   annotators who do not belong to the target groups with those from the
   target groups.},
Publisher = {IOS PRESS},
Address = {NIEUWE HEMWEG 6B, 1013 BG AMSTERDAM, NETHERLANDS},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Lobo, PR (Corresponding Author), Open Univ, Knowledge Media Inst, Milton Keynes, Bucks, England.
   Lobo, Paula Reyero; Daga, Enrico; Alani, Harith; Fernandez, Miriam, Open Univ, Knowledge Media Inst, Milton Keynes, Bucks, England.},
DOI = {10.3233/FAIA240957},
ISSN = {0922-6389},
EISSN = {1879-8314},
ISBN = {978-1-64368-548-9},
