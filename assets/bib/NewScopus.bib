	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105017725183&doi=10.18653%2Fv1%2F2024.sigdial-1.65&partnerID=40&md5=77ae4a84b85423bdb19bf72479e11d4b},
	affiliations = {Technische Universität Braunschweig, Institute for Information Systems, Braunschweig, Niedersachsen, Germany},
	abstract = {The rise of social media has amplified the visibility and impact of hate speech, prompting the development of NLP solutions to identify both explicit and implicit forms of hate speech. These approaches assess toxicity in isolation, neglecting context and limiting models to sentence-level understanding. Therefore we study, how contextual factors influence perceived toxicity, thereby anchoring assessments in a more nuanced semantic framework. We introduce a novel synthetic data generation pipeline designed to create context-utterance pairs at scale with controlled polarity. This pipeline can enhance existing hate speech datasets by adding contextual information to utterances, either preserving or altering their polarity, and also generate completely new pairs from seed statements. We utilised both features to create Toximatics, a dataset that includes context-dependent utterances and it's toxicity score. To address biases in state-of-the-art hate datasets, which often skew towards specific sensitive topics such as politics, race, and gender, we propose a method to generate neutral utterances typical of various social settings. These are then contextualized to show how neutrality can shift to toxicity or benignity depending on the surrounding context. Toximatics' approach to hate speech detection extends beyond the sentence level, rendering it suitable for discourse analysis and also revealing that current models underperform on this dataset. © 2024 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Natural language processing systems; Semantics; Speech communication; Speech recognition; Anchorings; Context dependent; Contextual factors; Contextual information; Explicit form; Implicit form; Semantics framework; Sentence level; Social media; Synthetic data generations; Toxicity},
	editor = {Kawahara, T. and Demberg, V. and Ultes, S. and Inoue, K. and Mehri, S. and Howcroft, D. and Komatani, K.},
