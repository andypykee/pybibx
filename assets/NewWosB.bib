@article{ WOS:001620293600004,
Author = {Hawa, Marah and Kmail, Thani and Hasasneh, Ahmad},
Title = {ADVANCED DEEP-LEARNING TECHNIQUES FOR IMPROVED CYBERBULLYING DETECTION
   IN ARABIC TWEETS},
Journal = {JORDANIAN JOURNAL OF COMPUTERS AND INFORMATION TECHNOLOGY},
Year = {2025},
Volume = {11},
Number = {3},
Pages = {336-350},
Month = {SEP},
Abstract = {Cyberbullying has emerged as a pressing issue in the digital era,
   particularly within Arabic-speaking communities, where research remains
   limited. This study investigates the detection of Arabic cyberbullying
   on social media using both traditional machine learning (ML) and deep
   learning (DL) techniques. A publicly available dataset of Arabic tweets
   was used to train and evaluate several ML models (SVM, NB, LR and
   XGBoost), alongside a recurrent neural network (RNN). The results
   demonstrate that the RNN significantly outperforms classical ML models,
   highlighting the efficacy of DL in accurately identifying abusive
   content in Arabic text. These results emphasize the necessity of
   incorporating linguistically rich data and advanced neural architectures
   to improve cyberbullying-detection systems in low-resource languages
   such as Arabic.},
