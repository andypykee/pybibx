Title = {Oddballs and Misfits: Detecting Implicit Abuse in Which Identity Groups
   are Depicted as Deviating from the Norm},
Booktitle = {2024 CONFERENCE ON EMPIRICAL METHODS IN NATURAL LANGUAGE PROCESSING,
   EMNLP 2024},
