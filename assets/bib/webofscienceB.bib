Title = {Exploring Neural Embeddings and Transformers for Isolation of Offensive
   and Hate Speech in South African Social Media Space},
Booktitle = {COMPUTATIONAL SCIENCE AND ITS APPLICATIONS, ICCSA 2022, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2022},
Volume = {13375},
Pages = {649-661},
