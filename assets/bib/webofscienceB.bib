@inproceedings{ WOS:001534841000007,
Author = {Kaddoura, Sanaa and Nassar, Reem},
Editor = {Barhamgi, M and Wang, H and Wang, X},
Title = {Language Model-Based Approach for Multiclass Cyberbullying Detection},
Booktitle = {WEB INFORMATION SYSTEMS ENGINEERING-WISE 2024, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Volume = {15437},
Pages = {78-89},
Note = {25th International Conference on Web Information Systems
   Engineering-WISE-Annual, Doha, QATAR, DEC 02-05, 2024},
Abstract = {Cyberbullying, characterized by digital abuse such as harassment and
   doxing, has become prevalent on social media platforms, mainly targeting
   despised groups. Victims often endure severe psychological effects,
   including anxiety and strained interpersonal relationships, sometimes
   ending in tragic outcomes like suicide. To mitigate these issues,
   automated systems for detecting cyberbullying text are crucial. While
   recent methods have employed classical, deep learning, and
   transformer-based language models like BERT, there remains a gap in the
   literature regarding the comparative effective-ness of large language
   models in this domain. This study addresses this gap by evaluating the
   efficacy of large language models, specifically Mistral 7B and Llama3,
   against the transformer-based model BERT. The comparison encompasses
   binary and multiclass classification scenarios, assessing their
   performance in identifying cyberbullying content. The multiclass BERT
   model has outperformed the literature's large language and other
   benchmark models, achieving an F1 score of 83.67\%. The BERT model was
   capable of classifying multiple classes effectively without being
   biased.},
