   Hathnapitiya, Sandunika},
Editor = {Coman, A and Vasilache, S},
Title = {Predicting Twitter Hate User Behavior Using Big Five Personality Traits
   and Ensemble Machine Learning},
Booktitle = {SOCIAL COMPUTING AND SOCIAL MEDIA, SCSM 2023, PT I},
Series = {Lecture Notes in Computer Science},
