@inproceedings{ WOS:000865723403080,
Author = {Qian, Jing and ElSherief, Mai and Belding, Elizabeth and Wang, William
   Yang},
Book-Group-Author = {Assoc Computat Linguist},
Title = {Hierarchical CVAE for Fine-Grained Hate Speech Classification},
Booktitle = {2018 CONFERENCE ON EMPIRICAL METHODS IN NATURAL LANGUAGE PROCESSING
   (EMNLP 2018)},
Year = {2018},
Pages = {3550-3559},
Note = {Conference on Empirical Methods in Natural Language Processing (EMNLP),
   Brussels, BELGIUM, OCT 31-NOV 04, 2018},
Organization = {Google; Facebook; Bloomberg; Salesforce; Apple; Amazon; Baidu;
   Grammarly; Naver Labs Europe; FWO; KU Leuven, Dept Comp Sci; CVTE; Ebay;
   Microsoft; Naver Line; Oracle; Polya; Huawei; Duolingo; Figure Eight;
   Nuance},
Abstract = {Existing work on automated hate speech detection typically focuses on
   binary classification or on differentiating among a small set of
   categories. In this paper, we propose a novel method on a fine-grained
   hate speech classification task, which focuses on differentiating among
   40 hate groups of 13 different hate group categories. We first explore
   the Conditional Variational Autoencoder (CVAE) (Larsen et al., 2016;
   Sohn et al., 2015) as a discriminative model and then extend it to a
   hierarchical architecture to utilize the additional hate category
   information for more accurate prediction. Experimentally, we show that
   incorporating the hate category information for training can
   significantly improve the classification performance and our proposed
   model outperforms commonly-used discriminative models.},
