	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85174488622&partnerID=40&md5=ae3475c56c3008a3c74d7d040067f8b9},
	affiliations = {Carnegie Mellon University, Software and Societal Systems Department, Pittsburgh, PA, United States; University of Michigan, Ann Arbor, Department of American Culture, Ann Arbor, MI, United States; Carnegie Mellon University, Department of English, Pittsburgh, PA, United States; Kennesaw State University, School of Communication and Media, Kennesaw, GA, United States},
	abstract = {Online communities of involuntary celibates (incels) are a prominent source of misogynist hate speech. In this paper, we use quantitative text and network analysis approaches to examine how identity groups are discussed on incels.is, the largest black-pilled incels forum. We find that this community produces a wide range of novel identity terms and, while terms for women are most common, mentions of other minoritized identities are increasing. An analysis of the associations made with identity groups suggests an essentialist ideology where physical appearance, as well as gender and racial hierarchies, determine human value. We discuss implications for research into automated misogynist hate speech detection. © 2023 Association for Computational Linguistics.},
