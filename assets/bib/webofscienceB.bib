@inproceedings{ WOS:001447818200044,
Author = {Chai, Yidong and Liu, Yi and Ebrahimi, Mohammadreza and Li, Weifeng and
   Padmanabhan, Balaji and Jiang, Yuanchun and Liu, Yezheng},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Enhancing Adversarial Robustness: A Novel Bayesian Uncertainty-Based
   Ensemble Learning Method<bold> </bold>},
Booktitle = {2024 IEEE 9TH INTERNATIONAL CONFERENCE ON DATA SCIENCE IN CYBERSPACE,
   DSC},
Year = {2024},
Pages = {329-336},
Note = {9th International Conference on Data Science in Cyberspace, Jinan,
   PEOPLES R CHINA, AUG 23-26, 2024},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {Deep learning (DL) models are highly vulnerable to a specific type of
   threat: adversarial attacks. Adversarially retrained ensemble learning
   represents the state-of-the-art approach to enhance DL models'
   robustness against adversarial attack, yet still limited by the failure
   to dynamically assess base model's reliability, the failure to assign
   higher weights to more reliable base models, and the failure to enhance
   adversarial robustness of aggregation model. To address these
   limitations, this study proposes a novel Bayesian Uncertainty-Based
   Ensemble Learning (BUEL) method. First, we deduce the knowledge that a
   higher Bayesian uncertainty score indicates a lower reliability of the
   prediction. We then propose a novel knowledge-data based weight
   assignment mechanism to initially determine base models' weights based
   on Bayesian uncertainty scores and then update with observed data. Next,
   we present a novel adversarial training strategy to enhance adversarial
   robustness of the aggregation model. Through experiments on offensive
   language detection, we validate the deduced knowledge and demonstrate
   that BUEL can effectively enhance DL models' adversarial robustness with
   seamless compatibility.<bold> </bold>},
