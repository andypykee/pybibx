@inproceedings{ WOS:001611618300201,
Author = {Rehman, Mohammad Zia Ur and Bhatnagar, Anukriti and Kabde, Omkar and
   Bansal, Shubhi and Kumar, Nagendra},
Editor = {Che, W and Nabende, J and Shutova, E and Pilehvar, MT},
Title = {ImpliHateVid: A Benchmark Dataset and Two-stage Contrastive Learning
   Framework for Implicit Hate Speech Detection in Videos},
Booktitle = {PROCEEDINGS OF THE 63RD ANNUAL MEETING OF THE ASSOCIATION FOR
   COMPUTATIONAL LINGUISTICS, VOL 1: LONG PAPERS},
Year = {2025},
Pages = {17209-17221},
Note = {63rd Association for Computational Linguistics Meeting-ACL-Annual,
   Vienna, AUSTRIA, JUL 27-AUG 01, 2025},
Abstract = {The existing research has primarily focused on text and image-based hate
   speech detection; video-based approaches remain underexplored. In this
   work, we introduce a novel dataset, ImpliHateVid, specifically curated
   for implicit hate speech detection in videos. ImpliHateVid consists of
   2,009 videos comprising 509 implicit hate videos, 500 explicit hate
   videos, and 1,000 non-hate videos, making it one of the first
   large-scale video datasets dedicated to implicit hate detection. We also
   propose a novel two-stage contrastive learning framework for hate speech
   detection in videos. In the first stage, we train modality-specific
   encoders for audio, text, and image using contrastive loss by
   concatenating features from the three encoders. In the second stage, we
   train cross-encoders using contrastive learning to refine multimodal
   representations. Additionally, we incorporate sentiment, emotion, and
   caption-based features to enhance implicit hate detection. We evaluate
   our method on two datasets, ImpliHateVid for implicit hate speech
   detection and another dataset for general hate speech detection in
   videos, the HateMM dataset, demonstrating the effectiveness of the
   proposed multimodal contrastive learning for hateful content detection
   in videos and the significance of our dataset. The code and dataset will
   be made available on the GitHub repository(1).},
Publisher = {ASSOC COMPUTATIONAL LINGUISTICS-ACL},
Address = {209 N EIGHTH STREET, STROUDSBURG, PA 18360 USA},
Type = {Proceedings Paper},
