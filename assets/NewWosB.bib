@inproceedings{ WOS:001547183700006,
Author = {Giron, Adrian and Collell, Guillem and Hassan, Fadi and Huertas-TatoiD,
   Javier and Camachol, David},
Editor = {Barhamgi, M and Wang, H and Wang, X and Aimeur, E and Mrissa, M and Chikhaoui, B and Boukadi, K and Grati, R and Maamar, Z},
Title = {Low-Resource Dataset Synthetic Generation for Hate Speech Detection},
Booktitle = {WEB INFORMATION SYSTEMS ENGINEERING-WISE 2024 PHD SYMPOSIUM, DEMOS AND
   WORKSHOPS, WEB-FOR-GOOD 2024, AIWDA 2024, SWIFT-AG 2024, AND DEMOS},
