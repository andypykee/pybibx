	author = {Niño, Daniel Ayala and Gómez, Manuel Montes Y. and Velasco-Cruz, Ciro},
	title = {ColPos at HOMO-MEX 2024: Weighted Naive Bayes for LGBTQ+Phobia Detection in Spanish Text},
	year = {2024},
	journal = {CEUR Workshop Proceedings},
	volume = {3756},
	pages = {},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204377286&partnerID=40&md5=c95510c666a0a85a1d4bfa9bee8e7ceb},
	affiliations = {Colegio De Postgraduados Campus Montecillo, Estadística e Informática, Texcoco, MEX, Mexico; Instituto Nacional de Astrofisica Optica y Electronica, Optics and Electronics, Puebla, PUE, Mexico},
	abstract = {This paper presents the research conducted by ColPos team on the HOMO-Mex 2024 shared task, focusing on the detection of LGBTQ+ phobic messages in online content. We leveraged a weighted Naive Bayes model, enhancing the traditional algorithm by incorporating weights for words and documents. Our work targeted both Track 1 (hate speech identification) and Track 3 (homophobic lyric detection) of the competition. In Track 1, our model achieved an F1-score of 0.791, placing us 11th out of 17 teams. For Track 3, we obtained an F1-score of 0.489, securing 7th place out of 13. Our results demonstrate the effectiveness of our weighted approach in outperforming the baseline Multinomial Naive Bayes model. This research emphasizes the critical need for timely identification of LGBTQ+phobic content to improve moderation efforts on social media and music platforms, fostering safer online environments. © 2024 Copyright for this paper by its authors.},
