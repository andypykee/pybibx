@CONFERENCE{Chinchole2024628,
	author = {Chinchole, Disha and Daberao, Aditi and Pendharkar, Mihika and Choubey, Sumit},
	title = {Review and Implementation on Hate Speech Detection Using Neural Networks},
	year = {2024},
	journal = {ISML 2024 - Intelligent Systems and Machine Learning Conference},
	pages = {628 - 635},
	doi = {10.1109/ISML60050.2024.11007397},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010203594&doi=10.1109%2FISML60050.2024.11007397&partnerID=40&md5=58f5265ffc130c8b1009462f6d957454},
	affiliations = {Pune Institute of Computer Technology, Department of Electronics and Telecommunication, Pune, MH, India},
	abstract = {This literature survey delves into the domain of hate speech detection through the lens of deep learning methodologies. Hate speech has emerged as a critical issue in the realm of online communication, necessitating robust and efficient detection mechanisms. Deep learning, renowned for its capacity to model intricate patterns within data, presents a promising avenue for addressing this societal concern. This survey comprehensively explores a wide array of approaches utilizing deep neural networks, notably convolutional neural networks (CNNs) and recurrent neural networks (RNNs), to detect hate speech effectively.The investigation encompasses a thorough examination of preprocessing techniques, encompassing methods such as tokenization, embedding, and linguistic considerations specific to various languages and domains. Moreover, the survey scrutinizes diverse neural network architectures tailored to the hate speech detection task, taking into account the unique linguistic features and contextual intricacies associated with different languages and cultures.In addition to model architectures, the study covers training methodologies, optimization techniques, and evaluation metrics employed in training deep learning models for hate speech detection. The role of transfer learning and fine-tuning in adapting models to specific domains, dialects, or social contexts is also a focal point of this survey.Furthermore, the survey provides an insight into the challenges faced in hate speech detection using deep learning, such as data imbalance, evolving forms of hate speech, and interpretability of models. Additionally, it highlights the advancements made in understanding and addressing these challenges. Lastly, the survey discusses potential future directions, emphasizing the need for interdisciplinary collaborations, ethical considerations, and advancements in multilingual and multimodal hate speech detection to build safer digital spaces. © 2024 IEEE.},
	author_keywords = {Algorithmic Biases; Convolutional Neural Network; Support vector machine; User Behaviour Metrics; Word Frequency Vectorization},
