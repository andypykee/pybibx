Author = {Hussein, Omar and Sfar, Hachem and Mitrovic, Jelena and Granitzer,
   Michael},
Editor = {Herbelot, A and Zhu, X and Palmer, A and Schneider, N and May, J and Shutova, E},
Title = {NLP\_Passau at SemEval-2020 Task 12: Multilingual Neural Network for
   Offensive Language Detection in English, Danish and Turkish},
Booktitle = {PROCEEDINGS OF THE FOURTEENTH WORKSHOP ON SEMANTIC EVALUATION},
Year = {2020},
Pages = {2090-2097},
Note = {14th International Workshops on Semantic Evaluation (SemEval), ELECTR
   NETWORK, DEC 12-13, 2020},
Organization = {ACL Special Interest Grp Lexicon},
Abstract = {This paper describes a neural network (NN) model that was used for
   participating in the OffensEval, Task 12 of the SemEval 2020 workshop.
   The aim of this task is to identify offensive speech in social media,
   specifically in tweets. The model we used, C-BiGRU, is composed of a
   Convolutional Neural Network (CNN) along with a bidirectional Recurrent
   Neural Network (RNN). A multi-dimensional numerical representation
   (embedding) for each of the words in the tweets, that were used by the
   model, was determined using fastText. This was utilized with a dataset
   of labeled tweets to train the model on detecting combinations of words
   that may convey an offensive meaning. The model was then used in the
   sub-task A of the English, Turkish and Danish competitions of the
   workshop, achieving F1 scores of 90.88\%, 76.76\% and 76.70\%,
   respectively.},
