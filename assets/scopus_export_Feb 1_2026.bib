	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105025000107&doi=10.1109%2FIDAP68205.2025.11222265&partnerID=40&md5=88af1dad9ec0804f8e1855ddeed81508},
	affiliations = {Caraga State University, College of Computing and Information Sciences, Butuan, Agusan Del Norte, Philippines},
	abstract = {Hate speech is really a big problem in the Philippines, especially on social media, since it comes with the challenges of a very full of nuances language - Tagalog - and limited detection resources. This research work does all the above-mentioned tasks by designing and developing innovative ways for hate speech detection in Tagalog for accuracy, efficiency improvement, and contribution to the development of low-resource language models. An XGBoost model was developed, and a pre-trained RoBERTa model fine-tuned from the pre-trained version was adapted for Tagalog. An XGBoost-RoBERTa ensemble model using stacking with Logistic Regression as metalearner was constructed. The individual models (XGBoost-TagHS and RoBERTa-TagHS) and the ensemble model (XRoBERTa-SLR) were tested thoroughly using standard metrics like accuracy, precision, recall, and F1-score measures. With 87.52% accuracy, the ensemble model XRoBERTa-SLR bagged the highest score, outperforming both the individual models and the other already available models in the same domain. Statistical analysis including McNemar's test supported this conclusion and showed that a significant improvement of performance has been achieved by the ensemble model. The results find that the combination of XGBoost and RoBERTa through ensemble learning is proved to be especially effective for the task of hate speech detection in Tagalog and hence advancement in the field for low-resource languages. © 2025 IEEE.},
