	title = {Bert-Based Transformer Model for Hate Speech Detection},
	year = {2024},
	journal = {2024 5th IEEE Global Conference for Advancement in Technology, GCAT 2024},
	pages = {},
	doi = {10.1109/GCAT62922.2024.10923943},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002254427&doi=10.1109%2FGCAT62922.2024.10923943&partnerID=40&md5=5b40c74f1fb0be02497c274c5edd37d1},
	affiliations = {Amrita Vishwa Vidyapeetham University, Bangalore, Bengaluru, KA, India},
	abstract = {Hate speech recognition has emerged as a key problem in social media and should be addressed using multiple models. Machine learning models like CNN and LSTM have been used recently in creating successful hate-speech detection models that have been developed in the recent past but they have not proved to be highly discriminative. The use of BERT or any other transformer model will give increased performance owing to the ability of these models to grasp context. Other potential improvements include using new feature engineering techniques and ensemble methods in conjunction with these models. The datasetused for experimentation in the proposed work is annotated considering three categories hate, offensive, or normal. The proposed methodology has incorporated a data-balancing mechanism and experimented with a range of classifier models that belong to ML and DL models and the best results were reported for Bert based transformer model which is F1-score of 0.76. © 2024 IEEE.},
	author_keywords = {3-class classification; BERT; CNN; contextual understanding; data pre-processing; ensemble techniques; feature engineering; feature extraction; Hate speech detection; LSTM; rationales; social media; targeted community; text categorization; transformer models},
	keywords = {Adversarial machine learning; 3-class classification; BERT; Contextual understanding; Data preprocessing; Ensemble techniques; Feature engineerings; Features extraction; Hate speech detection; LSTM; Rationale; Social media; Speech detection; Targeted community; Text categorization; Transformer modeling; Speech recognition},
	correspondence_address = {P.H. Vardhan; Amrita Vishwa Vidyapeetham, Amrita School of Computing, Department of Computer Science and Engineering, Bengaluru, India; email: puvvadivardhan@gmail.com},
