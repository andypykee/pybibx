@article{ WOS:000646583800015,
Author = {Almutairi, Amjad Rasmi and Al-Hagery, Muhammad Abdullah},
Title = {Cyberbullying Detection by Sentiment Analysis of Tweets' Contents
   Written in Arabic in Saudi Arabia Society},
Journal = {INTERNATIONAL JOURNAL OF COMPUTER SCIENCE AND NETWORK SECURITY},
Year = {2021},
Volume = {21},
Number = {3},
Pages = {112-119},
Month = {MAR 30},
Abstract = {Social media has become a global means of communication in people's
   lives. Most people are using Twitter for communication purposes and its
   inappropriate use, which has negative effects on people's lives. One of
   the widely common misuses of Twitter is cyberbullying. As the resources
   of dialectal Arabic are rare, so for cyberbullying most people are using
   dialectal Arabic. For this reason, the ultimate goal of this study is to
   detect and classify cyberbullying on Twitter in the Arabic context in
   Saudi Arabia. To help in the detection and classification of tweets,
   Pointwise Mutual Information (PMI) to generate a lexicon, and Support
   Vector Machine (SVM) algorithms are used. The evaluation is performed on
   both methods in terms of the F1-score. However, the F1-score after
   applying the PMI is 50\%, while after the SVM application on the
   resampling data it is 82\%. The analysis of the results shows that the
   SVM algorithm outperforms better.},
