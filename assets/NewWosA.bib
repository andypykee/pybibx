Title = {pin\_cod\_at SemEval-2020 Task 12: Injecting Lexicons into Bidirectional
   Long Short-Term Memory Networks to Detect Turkish Offensive Tweets},
Booktitle = {PROCEEDINGS OF THE FOURTEENTH WORKSHOP ON SEMANTIC EVALUATION},
