@CONFERENCE{Mahaveerakannan R2024,
	author = {Mahaveerakannan R, null and Anitha, Cuddapah L. and Murali Dhar, M. S.},
	title = {Abuse Detection of Cyberbullying in Tweets Data using Ensemble DL Model with Advanced Voting Mechanisms},
	year = {2024},
	journal = {2024 2nd World Conference on Communication and Computing, WCONF 2024},
	pages = {},
	doi = {10.1109/WCONF61366.2024.10692193},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85207466575&doi=10.1109%2FWCONF61366.2024.10692193&partnerID=40&md5=5557c37e7927099447e35c4b26b50ce5},
	affiliations = {Saveetha School of Engineering, Department of Computer Science and Engineering, Chennai, TN, India; Mohan Babu University, Department of Computer Science and Engineering, Tirupati, AP, India; Vel Tech Rangarajan Dr.Sagunthala R&D Institute of Science and Technology, Chennai, TN, India},
	abstract = {In social media, automatic identification of abusive online content- speech, profanity, threats, etc.-has become commonplace. Several initiatives have been devoted to identifying this issue in English. Nonetheless, it is not an easy task to identify hate speech and abuse in languages with limited resources. Transformer-based multilingual pre-trained language models for typologically varied languages are not always efficient due to insufficient labelled data in low-resource languages besides variable generalisation capacity. In order to tackle these problems, the research project compares a dynamic voting classifier in several languages with classic machine learning and deep learning classifiers as part of a hybrid ensemble method for cyberbullying detection. The modified seagull optimisation algorithm (MSOA) selects the most relevant features in the best possible way. The dataset underwent exploratory data analysis prior to implementation in order to obtain more insightful information. The study examines the offensive language detection of several publicly accessible datasets, including 6 datasets in 6 languages, in order to our approach. The studies demonstrate that in most circumstances, suggested deep learning-based representations perform better than transfer learning-based representations. © 2024 IEEE.},
	author_keywords = {Abusive Words detection; Cyberbullying detection; Dynamic Voting; Hybrid Deep Learning; Modified seagull optimization algorithm},
	keywords = {Contrastive Learning; Deep learning; Abusive word detection; Automatic identification; Cyber bullying; Cyberbullying detection; Dynamic voting; Hybrid deep learning; Modified seagull optimization algorithm; Optimization algorithms; Social media; Voting mechanism; Adversarial machine learning},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
