@ARTICLE{Liang2025275,
	author = {Liang, Haoyu and He, Junheng and Lin, Jianghao and Lin, Nankai and Zhou, Dong and Yang, Aimin},
	title = {DMCP: A Novel Debiasing Method Based on Contrastive Learning and Prompt Learning},
	year = {2025},
	journal = {2025 10th International Conference on Big Data Analytics, ICBDA 2025},
	pages = {275 - 280},
	doi = {10.1109/ICBDA65366.2025.11211018},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105023824116&doi=10.1109%2FICBDA65366.2025.11211018&partnerID=40&md5=47b9f34ffc5efb7ff58244c93c995711},
	affiliations = {Guangdong University of Technology, School of Computer Science and Technology, Guangzhou, Guangdong, China; Guangdong University of Foreign Studies, School of Information Science and Technology, Guangzhou, Guangdong, China},
	abstract = {Pre-Trained Language Models (PLMs) often reflect societal biases, which can negatively impact vulnerable groups, particularly through sensitive attributes like authorship. While some existing debiasing methods use contrastive learning to make models treat sentences with different sensitive information similarly, this approach can be ineffective when applied to inherently different sentences. To overcome this limitation, we propose DMCP, a Debiasing Method combining Contrastive and Prompt learning. DMCP reduces the disparity between semantically dissimilar sentences by introducing information from one to the other through prompt learning, ensuring they contain identical information. To balance the original and introduced information, a distribution alignment loss is employed to minimize discrepancies. Subsequently, contrastive learning is applied to enhance similarity, yielding improved debiasing outcomes. Applying DMCP to BERT and RoBERTa, we successfully reduce biases related to gender, age, country, and ethnicity while preserving accuracy in hate speech detection. Our experiments confirm that DMCP effectively mitigates various biases while maintaining performance in hate speech detection, providing valuable insights into the interactions between different types of bias. © 2025 IEEE.},
	author_keywords = {Contrastive Learning; Debiasing; Fairness; Hate Speech Identification; Prompt Learning},
	keywords = {Learning systems; Signal processing; Speech communication; De-biasing; Fairness; Hate speech identification; Language model; Prompt learning; Sensitive attribute; Sensitive informations; Speech detection; Speech identification; Vulnerable groups; Contrastive Learning},
	correspondence_address = {N. Lin; School of Computer Science and Technology, Guangdong University of Technology, Guangzhou, China; email: neakail@outlook.com; D. Zhou; School of Information Science and Technology, Guangdong University of Foreign Studies, Guangzhou, China; email: dongzhou@gdufs.edu.cn},
