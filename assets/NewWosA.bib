@inproceedings{ WOS:000894285000014,
Author = {Muzakir, Ari and Adi, Kusworo and Kusumaningrum, Retno},
Editor = {BenAhmed, M and Abdelhakim, BA and Ane, BK and Rosiyadi, D},
Title = {Classification of Hate Speech Language Detection on Social Media:
   Preliminary Study for Improvement},
Booktitle = {EMERGING TRENDS IN INTELLIGENT SYSTEMS \& NETWORK SECURITY},
Series = {Lecture Notes on Data Engineering and Communications Technologies},
Year = {2023},
Volume = {147},
Pages = {146-156},
Note = {5th International Conference on Networks, Intelligent Systems and
   Security (NISS), Bandung, INDONESIA, MAR 30-31, 2022},
Abstract = {This study aims to improve performance in the detection of hate speech
   on social media in Indonesia, particularly Twitter. Until now,
   themachine learning approach is still very suitable for overcoming
   problems in text classification and improving accuracy for hate speech
   detection. However, the quality of the varying datasets caused the
   identification and classification process to remain a problem.
   Classification is one solution for hate speech detection, divided into
   three labels: Hate Speech (HS), Non-HS, and Abusive. The dataset was
   obtained by crawling Twitter to collect data from communities and public
   figures in Indonesia. The optimization process of the classification
   algorithm is carried out by comparing the SVM algorithm, eXtreme
   Gradient Boosting (XGBoost), and RandomSearchCV. The experiment was
   carried out through two stages of activity: the classification algorithm
   using SMOTE and without SMOTE with Stratified K-Fold CV algorithm. The
   highest performance accuracy with SMOTE is obtained at 90.7\% with the
   SVM model. Whereas without SMOTE, the highest performance accuracy uses
   the SVM with a value of 87.8\%. Furthermore, with the addition of the
   Stratified K-Fold CV algorithm for non-SMOTE, the train\_score is
   97.4\%, and the test\_score is 95.2\%. The results show that SMOTE
   oversampling can increase the accuracy value in detecting hate speech.},
