Note = {14th International Workshops on Semantic Evaluation (SemEval), ELECTR
   NETWORK, DEC 12-13, 2020},
Organization = {ACL Special Interest Grp Lexicon},
Abstract = {This paper describes a system (pin cod) built for SemEval 2020 Task 12:
   OffensEval: Multi-lingual Offensive Language Identification in Social
   Media (Zampieri et al., 2020). I present the system based on the
   architecture of bidirectional long short-term memory networks (BiLSTM)
   concatenated with lexicon-based features and a social-network specific
   feature and then followed by two fully connected dense layers for
   detecting Turkish offensive tweets. The pin\_cod\_'s system achieved a
   macro F1-score of 0.7496 for Sub-task A - Offensive language
   identification in Turkish.},
