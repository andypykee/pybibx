	keywords = {Classification (of information); Convolutional neural networks; Deep neural networks; Image processing; Intelligent systems; Learning systems; Linguistics; Natural language processing systems; Social networking (online); Speech analysis; Speech communication; Text processing; World Wide Web; Convolutional neural network; Deep learning; Explainable AI; Hate speech detection; Language processing; Machine-learning; Natural language processing; Natural languages; Speech detection; Convolution},
