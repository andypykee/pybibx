@CONFERENCE{Khurana20254341,
	author = {Khurana, Urja and Nalisnick, Eric T. and Fokkens, Antske},
	title = {DEFVERIFY: Do Hate Speech Models Reflect Their Dataset's Definition?},
	year = {2025},
	journal = {Proceedings - International Conference on Computational Linguistics, COLING},
	pages = {4341 - 4358},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218487916&partnerID=40&md5=fadf0553aff2431fa494556c86e85c7b},
	affiliations = {Vrije Universiteit Amsterdam, Computational Linguistics and Text Mining Lab, Amsterdam, Noord-Holland, Netherlands; Whiting School of Engineering, Baltimore, MD, United States},
	abstract = {When building a predictive model, it is often difficult to ensure that application-specific requirements are encoded by the model that will eventually be deployed. Consider researchers working on hate speech detection. They will have an idea of what is considered hate speech, but building a model that reflects their view accurately requires preserving those ideals throughout the workflow of data set construction and model training. Complications such as sampling bias, annotation bias, and model misspecification almost always arise, possibly resulting in a gap between the application specification and the model's actual behavior upon deployment. To address this issue for hate speech detection, we propose DEFVERIFY: a 3-step procedure that (i) encodes a user-specified definition of hate speech, (ii) quantifies to what extent the model reflects the intended definition, and (iii) tries to identify the point of failure in the workflow. We use DEFVERIFY to find gaps between definition and model behavior when applied to six popular hate speech benchmark datasets. © 2025 Association for Computational Linguistics.},
	keywords = {Speech recognition; Application specific requirements; Construction training; Data set; Model misspecification; Model training; Predictive models; Sampling bias; Speech detection; Speech models; Work-flows; Computational linguistics},
	editor = {Rambow, O. and Wanner, L. and Apidianaki, M. and Al-Khalifa, H. and Di Eugenio, B. and Schockaert, S.},
	publisher = {Association for Computational Linguistics (ACL)},
