	volume = {1},
	pages = {17209 - 17221},
	doi = {10.18653/v1/2025.acl-long.842},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021047973&doi=10.18653%2Fv1%2F2025.acl-long.842&partnerID=40&md5=78abcf4f7a924fab1efef7c3bcd70820},
	affiliations = {Indian Institute of Technology Indore, Indore, MP, India; Chaitanya Bharathi Institute of Technology, Hyderabad, India},
	abstract = {The existing research has primarily focused on text and image-based hate speech detection; video-based approaches remain underexplored. In this work, we introduce a novel dataset, ImpliHateVid, specifically curated for implicit hate speech detection in videos. ImpliHateVid consists of 2,009 videos comprising 509 implicit hate videos, 500 explicit hate videos, and 1,000 non-hate videos, making it one of the first large-scale video datasets dedicated to implicit hate detection. We also propose a novel two-stage contrastive learning framework for hate speech detection in videos. In the first stage, we train modality-specific encoders for audio, text, and image using contrastive loss by concatenating features from the three encoders. In the second stage, we train cross-encoders using contrastive learning to refine multimodal representations. Additionally, we incorporate sentiment, emotion, and caption-based features to enhance implicit hate detection. We evaluate our method on two datasets, ImpliHateVid for implicit hate speech detection and another dataset for general hate speech detection in videos, the HateMM dataset, demonstrating the effectiveness of the proposed multimodal contrastive learning for hateful content detection in videos and the significance of our dataset. The code and dataset will be made available on the GitHub repository. © 2025 Association for Computational Linguistics.},
	editor = {Che, W. and Nabende, J. and Shutova, E. and Pilehvar, M.T.},
