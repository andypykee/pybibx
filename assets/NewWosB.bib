@inproceedings{ WOS:000716884800005,
Author = {Fajri, Ricky Maulana and Khoshrou, Samaneh and Peharz, Robert and
   Pechenizkiy, Mykola},
Editor = {Dong, Y and Ifrim, G and Mladenic, D and Saunders, C and VanHoecke, S},
Title = {PS3: Partition-Based Skew-Specialized Sampling for Batch Mode Active
   Learning in Imbalanced Text Data},
Booktitle = {MACHINE LEARNING AND KNOWLEDGE DISCOVERY IN DATABASES: APPLIED DATA
   SCIENCE AND DEMO TRACK, ECML PKDD 2020, PT V},
Series = {Lecture Notes in Artificial Intelligence},
