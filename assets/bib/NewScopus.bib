	journal = {Proceeding - 2024 IEEE 9th International Conference on Data Science in Cyberspace, DSC 2024},
	pages = {247 - 254},
	doi = {10.1109/DSC63484.2024.00040},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218456440&doi=10.1109%2FDSC63484.2024.00040&partnerID=40&md5=3c134d35a48b675e1266baf416876266},
	affiliations = {National University of Defense Technology China, College of Computing, Changsha, Hunan, China},
	abstract = {Hate speech is one type of harmful online content that attacks or promotes hate towards a group or individual based on their actual or perceived identity aspects, such as ethnicity, religion, and sexual orientation. It may trigger social disharmony, threaten social stability, and even lead to violent conflicts. Various detection methods, especially those based on pre-trained language models, have achieved outstanding results in hate speech detection tasks. Despite these advances, challenges remain, including the need to fine-tune models on specialized hate speech datasets to enhance their performance. Additionally, conversations on social media platforms like Telegram often occur in scenarios where network perception is constrained. For example, users often use pronouns or cite specific events to express slander towards certain groups, while pre-trained models often lack prior knowledge about these pronouns or events.In recent years, the powerful capabilities of large language models led by ChatGPT have been continuously demonstrated, especially in multiple tasks such as text generation and dialogue understanding. These large models are usually pre-trained on a large corpus, during which a large amount of background knowledge is stored in the model weights. Based on this, to address the problem of pre-trained language models in network perception constrained scenarios, we plan to utilize a large language model equipped with a comprehensive knowledge base for detecting hate speech. We design a zero-shot prompt and a CoT prompt to detect hate speech. We propose a Chinese hate speech dataset comprising about 200,000 data points. Our methods prove to be effective across two datasets. © 2024 IEEE.},
	author_keywords = {deep learning; hate speech detection; large language model; network perception constrained scenarios},
	keywords = {Speech recognition; Deep learning; Group-based; Hate speech detection; In networks; Individual-based; Language model; Large language model; Network perception constrained scenario; Online content; Speech detection},
