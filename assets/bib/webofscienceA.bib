@inproceedings{ WOS:001480997700097,
Author = {Duric, Ana and Koprivica, Sara and Nikolic, Danilo and Stefanovic, Darko},
Book-Group-Author = {IEEE},
Title = {Assessing Reproducibility and Accessibility in Hate Speech and Fake News
   Detection Datasets: A Literature Review (2023-2024)},
Booktitle = {2025 24TH INTERNATIONAL SYMPOSIUM INFOTEH-JAHORINA, INFOTEH},
Series = {International Symposium on INFOTEH-JAHORINA},
Year = {2025},
Note = {24th International Symposium INFOTEH JAHORINA-INFOTEH-Annual, BOSNIA \&
   HERCEG, MAR 19-21, 2025},
Organization = {University of East Sarajevo Faculty of Electrical Engineering; Institute
   of Electrical and Electronics Engineers Industry Applications Society;
   IEEE Bosnia and Herzegovina Section; IEEE Serbia and Montenegro Section;
   Univerziteta u Beogradu Fakultet Elektrotehnicki; Univerzitet u Novom
   Sadu Fakultet tehnickih nauka; Univerzitet u Kragujevcu Fakultet
   tehnickih nauka u Cacku; Sveuciliste u Splitu Fakultet elektrotehnike
   strojarstva i brodogradnje; Ss Cyril and Methodius University in Skopje
   (UKiM); Alumni Association of Electrical Engineers of East Sarajevo},
Abstract = {This paper presents a systematic review of datasets for hate speech and
   fake news detection, published between 2023 and 2024. Using Kitchenham's
   methodology, we analyzed reproducible studies that provide comprehensive
   documentation and accessibility. These challenges compromise research
   validity, making it difficult to build effective and universally
   applicable detection models. Despite advancements in machine learning,
   the development of effective detection models has been hindered by
   inconsistencies in data quality and annotation standards. This study
   highlights the need for highquality, diverse datasets that adhere to
   reproducibility standards and emphasizes the importance of incorporating
   multimodal data to improve model performance.},
Publisher = {IEEE},
