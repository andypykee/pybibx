	author = {Sawant, Madhuri and Qureshi, Muhammad Atif and Younus, Arjumand and Caton, Simon J.},
	title = {Using Explainable AI (XAI) for Identification of Subjectivity in Hate Speech Annotations for Low-Resource Languages},
	year = {2024},
	journal = {OASIS 2024 - Proceedings of the 2024 Workshop on Open Challenges in Online Social Media, Held in conjunction with the 35th ACM Conference on Hypertext and Social Media, HT 2024},
