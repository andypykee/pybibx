@inproceedings{ WOS:000561045500022,
Author = {Merayo-Alba, Sergio and Fidalgo, Eduardo and Gonzalez-Castro, Victor and
   Alaiz-Rodriguez, Rocio and Velasco-Mata, Javier},
Editor = {Garcia, HP and Gonzalez, LS and Limas, MC and Pardo, HQ and Rodriguez, EC},
Title = {Use of Natural Language Processing to Identify Inappropriate Content in
   Text},
Booktitle = {HYBRID ARTIFICIAL INTELLIGENT SYSTEMS, HAIS 2019},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2019},
Volume = {11734},
