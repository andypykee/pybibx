@article{ WOS:001409646600001,
Author = {Roy, Pradeep Kumar and Kumar, Abhinav},
Title = {Ensuring safety in digital spaces: Detecting code-mixed hate speech in
   social media posts},
Journal = {DATA \& KNOWLEDGE ENGINEERING},
