@ARTICLE{Akhtar2019588,
	author = {Akhtar, Sohail and Basile, Valerio and Patti, Viviana},
	title = {A New Measure of Polarization in the Annotation of Hate Speech},
	year = {2019},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {11946 LNAI},
	pages = {588 - 603},
	doi = {10.1007/978-3-030-35166-3_41},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85076742898&doi=10.1007%2F978-3-030-35166-3_41&partnerID=40&md5=719b2c4531595b2f6ea1e689192412c1},
	affiliations = {Università degli Studi di Torino, Department of Computer Science, Turin, TO, Italy},
	abstract = {The number of social media users is ever-increasing. Unfortunately, this has also resulted in the massive rise of uncensored online hate against vulnerable communities such as immigrants, LGBT and women. Current work on the automatic detection of various forms of hate speech (HS) typically employs supervised learning, requiring manually annotated data. The highly polarizing nature of the topics involved raises concerns about the quality of annotations these systems rely on, because not all the annotators are equally sensitive to different kinds of hate speech. We propose an approach to leverage the fine-grained knowledge expressed by individual annotators, before their subjectivity is averaged out by the gold standard creation process. This helps us to refine the quality of training sets for hate speech detection. We introduce a measure of polarization at the level of single instances in the data to manipulate the training set and reduce the impact of most polarizing text on the learning process. We test our approach on three datasets, in English and Italian, annotated by experts and workers hired on a crowdsourcing platform. We classify instances of sexist, racist, and homophobic hate speech in tweets and show how our approach improves the prediction performance of a supervised classifier. Moreover, the proposed polarization measure helps towards the manual exploration of the individual instances of tweets in our datasets. © 2019, Springer Nature Switzerland AG.},
	author_keywords = {Data augmentation; Hate speech detection; Inter-rater agreement; Linguistic annotation},
	keywords = {Artificial intelligence; Knowledge management; Learning systems; Polarization; Speech; Crowdsourcing platforms; Data augmentation; Inter-rater agreements; Linguistic annotations; Prediction performance; Speech detection; Supervised classifiers; Vulnerable communities; Speech recognition},
	correspondence_address = {V. Basile; Dipartimento di Informatica, University of Turin, Turin, Italy; email: basile@di.unito.it},
	editor = {Alviano, M. and Greco, G. and Scarcello, F.},
	publisher = {Springer},
	issn = {03029743},
	isbn = {9789819698936; 9789819698042; 9789819698110; 9789819698905; 9783032004949; 9789819512324; 9783032026019; 9783032008909; 9783031915802; 9789819698141},
	language = {English},
	abbrev_source_title = {Lect. Notes Comput. Sci.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 39}
}

