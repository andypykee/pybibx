   (EIT)},
Series = {International Conference on Electro Information Technology},
Year = {2015},
Pages = {611-616},
Note = {IEEE INTERNATIONAL CONFERENCE ON ELECTRO/INFORMATION TECHNOLOGY (EIT),
   Dekalb, IL, MAY 21-23, 2015},
Organization = {IEEE},
Abstract = {As the size of Twitter c data is increasing, so are undesirable
   behaviors of its users. One of such undesirable behavior is
   cyberbullying, which may even lead to catastrophic consequences. Hence,
   it is critical to efficiently detect cyberbullying behavior by analyzing
   tweets, if possible in real-time. Prevalent approaches to identify
   cyberbullying are mainly stand-alone and thus, are time-consuming. This
   research improves detection task using the principles of collaborative
   computing. Different collaborative paradigms are suggested and discussed
   in this paper. Preliminary results indicate an improvement in time and
   accuracy of the detection mechanism over the stand-alone paradigm.},
