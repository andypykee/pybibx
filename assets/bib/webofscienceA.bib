@inproceedings{ WOS:001588094200046,
Author = {Wu, Shih-Hung and Tsai, Tsung Hsun},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Fine-tuned Models for Hate Speech Detection: Assessing Generalization on
   Social Media},
Booktitle = {2025 IEEE INTERNATIONAL CONFERENCE ON INFORMATION REUSE AND INTEGRATION
   AND DATA SCIENCE, IRI},
Series = {IEEE International Conference on Information Reuse and Integration},
Year = {2025},
Pages = {250-255},
Note = {2025 International Conference on Information Reuse and Integration for
   Data Science-IRI, San Jose, CA, AUG 06-08, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {With the rapid development of social media, the automatic detection of
   offensive language has become a crucial research topic in the field of
   Natural Language Processing (NLP). To address the challenges posed by
   diverse corpora and contextual variations in real-world data, this study
   proposes a classification system that integrates RoBERTa and Large
   Language Models (LLMs) for detecting offensive language on social media,
   with a particular focus on evaluating model performance and
   transferability in cross-dataset settings. Three social media corpora
   with distinct sources and annotation styles-Jigsaw Toxic Comment
   Classification Challenge, hate-speech-dataset-master, and Hate Speech
   and Offensive Language Dataset-are used for cross-training and
   evaluation. RoBERTa is fine-tuned using supervised learning on each
   dataset and tested on the other two to assess generalization across
   domains. Additionally, zero-shot classification is conducted using LLMs
   with prompt engineering to simulate inference without labeled data. To
   support large-scale experimentation, the system is equipped with
   high-stability mechanisms including auto-saving, resume-on-interruption,
   and timeout handling. The experimental results show that RoBERTa
   performs best when training and testing data are aligned, but
   experiences degradation in accuracy and F1-score in cross-dataset
   evaluations. In contrast, LLMs, despite no fine-tuning, maintain stable
   recall across datasets and achieve the highest F1-score of 0.9328 on
   dataset C, indicating strong contextual transferability and corpus
   adaptability. This research systematically examines model adaptability
   to varying linguistic environments through multi-corpus experiments,
   offering analytical insights that inform the design of offensive content
   detection systems and dataset selection in real-world applications.},
