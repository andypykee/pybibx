Title = {CNN-BiLSTM Model for Arabic Dialect Identification},
Booktitle = {ADVANCES IN COMPUTATIONAL COLLECTIVE INTELLIGENCE, ICCCI 2023},
Series = {Communications in Computer and Information Science},
