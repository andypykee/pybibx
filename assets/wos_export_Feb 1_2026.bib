@inproceedings{ WOS:001517245000078,
Author = {Wicaksana, Arya and Sorensen, Kevin and Dinarta, Farrel},
Book-Group-Author = {IEEE},
Title = {Enhancing Hate Speech Detection in Mixed-Language Texts: A Comparative
   Study of BLOOM and XLM-RoBERTa Models},
Booktitle = {2025 17TH INTERNATIONAL CONFERENCE ON COMPUTER AND AUTOMATION
   ENGINEERING, ICCAE},
