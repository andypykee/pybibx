	pages = {18395 - 18415},
	doi = {10.1007/s00521-023-08657-z},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85162977097&doi=10.1007%2Fs00521-023-08657-z&partnerID=40&md5=50b8a39846fbbaec07a856559e6ed091},
	affiliations = {SRM Institute of Science and Technology, Department of Computer Science and Engineering, Kattankulathur, TN, India},
	abstract = {The evolution of social media and online platforms created more opportunities to express one’s thoughts without any burden. This emergence paved the way to construct more intelligent systems but by taking advantage of these platforms some people display their vengeance by harassing or abusing comments. The attackers leak sensitive information about an individual or an organization through the internet using abusive words, hate comments, threatening information, fake news, etc. So, online shaming detection with an optimum classification mechanism becomes necessary to avoid such negative consequences. In this paper, a novel online shaming detection mechanism using a Convolutional Neural Network Bidirectional Gated Recurrent Unit-based Hybrid Archimedes Tasmanian Devil (CNNBiGRU-HATD) approach is proposed to detect and classify the offensive comments and non-offensive comments. If the comment seems offensive, it is further classified into six categories according to shaming types such as abusive, doxing, Passing Judgment, Ethnic/Religious, Joke/Sarcasm, and Whataboutery. The utilized four Twitter-based datasets are initially preprocessed and feature extracted to improve the classification performance of the CNNBiGRU-HATD approach. After accurate classification, the information from the classified shaming types is collected and authenticated. The proposed approach is simulated using the Python platform. To validate the potential capability of the proposed CNNBiGRU-HATD approach, it is related to the existing methods by various parameters. The experimental result reveals that the proposed CNNBiGRU-HATD method achieves higher accuracy of 96.5% for the labeled hate speech detection dataset. © 2023, The Author(s), under exclusive licence to Springer-Verlag London Ltd., part of Springer Nature.},
	author_keywords = {Bidirectional gated recurrent unit; Convolutional neural network; Hybrid Archimedes Tasmanian devil; Offensive and non-offensive comments; Shaming},
	keywords = {Convolution; Convolutional neural networks; Fake detection; Intelligent systems; Recurrent neural networks; Social networking (online); Bidirectional gated recurrent unit; Classifieds; Convolutional neural network; Hybrid archimede tasmanian devil; Offensive and non-offensive comment; Online platforms; Optimisations; Shaming; Social media platforms; Unit-based; Classification (of information)},
