@inproceedings{ WOS:000463352600039,
Author = {Meng, Zihan and Yuan, Jiabin and Li, Zhen},
Editor = {Liu, M and Chen, H and Vincze, M},
Title = {Trajectory-Pooled Deep Convolutional Networks for Violence Detection in
   Videos},
