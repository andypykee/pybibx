	doi = {10.1109/IDAP68205.2025.11222136},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105025046835&doi=10.1109%2FIDAP68205.2025.11222136&partnerID=40&md5=435b10f88b04f00090290d5a64302467},
	affiliations = {Muğla Sıtkı Koçman Üniversitesi, Bilişim Sistemleri Mühendisliǧi Bölümü, Mugla, Mugla, Turkey},
	abstract = {The widespread use of social media platforms has profoundly transformed public discourse during global health crises. The 2022 monkeypox (Mpox) outbreak, declared a Public Health Emergency of International Concern by the World Health Organization (WHO), generated intense discussions on Instagram, where emotional expressions, misinformation, and hate speech often coexisted. This study aims to analyze hate speech dynamics within Instagram posts related to the Mpox outbreak using advanced transformer-based language models. Utilizing a multilingual dataset of 60,127 posts published between July 2022 and September 2024, we conducted three classification tasks: sentiment analysis, stress/anxiety detection, and hate speech identification. Four transformer models (BERT-Base, DistilBERT, RoBERTa, and DeBERTa-v3-small) were fine-tuned and evaluated using macro F1, weighted F1, ROC AUC, and accuracy metrics. The results showed that RoBERTa achieved the highest performance in sentiment (macro F1: 0.7075, weighted F1: 0.8230) and stress/anxiety (macro F1: 0.8867, weighted F1: 0.9093) classification, whereas DistilBERT, despite its smaller model size, yielded the most balanced and accurate results in hate speech detection (macro F1: 0.8927, weighted F1: 0.9827). This research fills a significant gap in the literature by addressing hate speech on Instagram during a viral health emergency, offering valuable insights for public health communication, content moderation, and digital crisis management. © 2025 IEEE.},
