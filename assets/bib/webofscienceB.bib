@inproceedings{ WOS:000342631000025,
Author = {Dadvar, Maral and Trieschnigg, Dolf and de Jong, Franciska},
Editor = {Sokolova, M and VanBeek, P},
Title = {Experts and Machines against Bullies: A Hybrid Approach to Detect
   Cyberbullies},
