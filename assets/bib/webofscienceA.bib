@inproceedings{ WOS:001279595704004,
Author = {Ranasinghe, Tharindu and Zampieri, Marcos},
Editor = {Boyd-Graber, J and Okazaki, N and Rogers, A},
Title = {Teacher and Student Models of Offensive Language in Social Media},
Booktitle = {FINDINGS OF THE ASSOCIATION FOR COMPUTATIONAL LINGUISTICS, ACL 2023},
Year = {2023},
Pages = {3910-3922},
Note = {61st Annual Meeting of the the Association-for-Computational-Linguistics
   (ACL), Toronto, CANADA, JUL 09-14, 2023},
Organization = {Assoc Computat Linguist; Cohere; Microsoft; Bloomberg; Google Res;
   Liveperson; Meta; Apple; IBM; Amazon Sci; Baidu; ByteDance; Google
   DeepMind; Flitto; Grammarly; Huawei; Kaust Artificial Intelligence
   Initiat; Megagon Labs; Dataocean AI; Ant Grp; Comcast; J P Morgan; NEC;
   Tencent; Aixplain; Alibaba Grp; Bosch; Duolingo; Translated; Adobe;
   Babelscape; Servicenow},
Abstract = {State-of-the-art approaches to identifying offensive language online
   make use of large pre-trained transformer models. However, the inference
   time, disk, and memory requirements of these transformer models present
   challenges for their wide usage in the real world. Even the distilled
   transformer models remain prohibitively large for many usage scenarios.
   To cope with these challenges, in this paper, we propose transferring
   knowledge from transformer models to much smaller neural models to make
   predictions at the token- and at the post-level. We show that this
   approach leads to lightweight offensive language identification models
   that perform on par with large transformers but with 100 times fewer
   parameters and much less memory usage.},
Publisher = {ASSOC COMPUTATIONAL LINGUISTICS-ACL},
Address = {209 N EIGHTH STREET, STROUDSBURG, PA 18360 USA},
