@inproceedings{ WOS:001447188600018,
Author = {Vecchi, Lorenzo Puppi and Barbon, Sylvio Junior and Paraiso, Emerson
   Cabrera},
Editor = {Paes, A and Verri, FAN},
Title = {Tuning Hypothesis Creation: Combining Discrete and Continuous Spaces for
   Zero-Shot Hate Speech Detection},
Booktitle = {INTELLIGENT SYSTEMS, BRACIS 2024, PT IV},
