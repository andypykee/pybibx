@CONFERENCE{Piedras202215,
	author = {Piedras, Lorena and Rosenblatt, Lucas and Wilkins, Julia},
	title = {Critical Perspectives: A Benchmark Revealing Pitfalls in PerspectiveAPI},
	year = {2022},
	journal = {NLP4PI 2022 - 2nd Workshop on NLP for Positive Impact, Proceedings of the Workshop},
	pages = {15 - 24},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85154592710&partnerID=40&md5=1d73054a009480e50f6fd0eb9f79bab6},
	affiliations = {New York University, New York, NY, United States},
	abstract = {Detecting “toxic” language in internet content is a pressing social and technical challenge. In this work, we focus on PERSPECTIVE from Jigsaw, a state-of-the-art tool that promises to score the “toxicity” of text, with a recent model update that claims impressive results (Lees et al., 2022). We seek to challenge certain normative claims about toxic language by proposing a new benchmark, Selected Adversarial SemanticS, or SASS. We evaluate PERSPECTIVE on SASS, and compare to low-effort alternatives, like zero-shot and few-shot GPT-3 prompt models, in binary classification settings. We find that PERSPECTIVE exhibits troubling shortcomings across a number of our toxicity categories. SASS provides a new tool for evaluating performance on previously undetected toxic language that avoids common normative pitfalls. Our work leads us to emphasize the importance of questioning assumptions made by tools already in deployment for toxicity detection in order to anticipate and prevent disparate harms. © 2022 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Toxicity; Zero-shot learning; Binary classification; Critical perspectives; Internet content; Model updates; Performance; Pressung; Social challenges; State of the art; Technical challenges; Toxicity detection; Semantics},
	publisher = {Association for Computational Linguistics (ACL)},
	isbn = {9781959429197},
