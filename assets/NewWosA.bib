Organization = {ACL Special Interest Grp Lexicon},
Abstract = {This paper describes the participation of SINAI team at Task 12:
   OffensEval 2: Multilingual Offensive Language Identification in Social
   Media. In particular, the participation in Sub-task A in English which
   consists of identifying tweets as offensive or not offensive. We
   preprocess the dataset according to the language characteristics used on
   social media. Then, we select a small set from the training set provided
   by the organizers and fine-tune different Transformer-based models in
   order to test their effectiveness. Our team ranks 20th out of 85
   participants in Subtask-A using the XLNet model.},
