@CONFERENCE{Meenu2025,
	author = {Meenu, B. and Deekshitha, V. and Likhitha, Gaddam Sai and Patil, Aishwarya Vilas and Alamelu Mangai, J.},
	title = {AI-based Content Moderator for Devanagari Scripts},
	year = {2025},
	journal = {6th International Conference on Control Communication and Computing, ICCC 2025},
	pages = {},
	doi = {10.1109/ICCC64910.2025.11077323},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105012719271&doi=10.1109%2FICCC64910.2025.11077323&partnerID=40&md5=86e235ebc90cd8229e28697c79c77f60},
	affiliations = {Presidency University Bangalore, Department of Computer Science and Engineering, Bengaluru, KA, India},
	abstract = {Social media platforms have transformed international communication, but they have also turned into havens for hate speech and other offensive material, endangering public safety, social cohesiveness, and mental health. In addition to failing to effectively manage the complexities of many linguistic and cultural settings, traditional content moderation techniques frequently find it difficult to keep up with tremendous online interactions. A fundamental user interface framework specifically designed for texts written in Devanagari-scripted languages, such as Hindi, Marathi, Nepali, and Sanskrit, is the aim of this research. It centralizes on three crucial subtasks: Language Detection, Hate Speech Detection, Target Identification. The models used to inculcate language detection is fastText. The model for hate speech detection is Hate-Speech-CNERG (fine-tuned). The model used for target identification is mBERT. The Precision-Recall Area Under Curve (PR-AUC) is utilized to assess the performance of the models in predicting the number of correct positive predictions made by the models. The PR-AUC score for fastText is 0.92, while Hate-Speech-CNERG has a score of 0.39 and mBERT stands at 0.78. The research proposes a method to combat online toxicity by moderating multilingual content, particularly in Devanagari-scripted languages, using advanced moderation techniques for inclusive communication and diverse voices. © 2025 IEEE.},
	author_keywords = {Bias mitigation; Devanagari script; Multilingual content; Online toxicity},
	keywords = {Artificial intelligence; Linguistics; Social networking (online); Speech analysis; Bias mitigation; Devanagari script; International communication; Language detection; Multilingual content; Online toxicity; Public safety; Social media platforms; Speech detection; Target's identifications; Speech communication; User interfaces},
