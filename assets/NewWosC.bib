Title = {Hate Speech and Stereotypes with Artificial Neural Networks},
Booktitle = {COMPUTATIONAL SCIENCE AND ITS APPLICATIONS - ICCSA 2022 WORKSHOPS, PART
   III},
Series = {Lecture Notes in Computer Science},
