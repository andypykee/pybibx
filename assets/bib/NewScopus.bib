@CONFERENCE{Abusaqer2025203,
	author = {Abusaqer, Muhammad and Saquer, Jamil M. and Shatnawi, Hazim},
	title = {Efficient Hate Speech Detection: Evaluating 38 Models from Traditional Methods to Transformers},
	year = {2025},
