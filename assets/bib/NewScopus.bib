	keywords = {Deep learning; E-learning; Face recognition; Social networking (online); Speech; Speech recognition; Facial expression recognition; Facial Expressions; Hate speech; Human rights; Machine-learning; Residual network; Social stability; Speech detection; Tiktok; Decision trees},
