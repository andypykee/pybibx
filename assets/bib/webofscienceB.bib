@article{ WOS:001627137700001,
Author = {Zhu, Kenan and Yang, Aohan and Li, Zhihong and Zhang, Zan and Wang,
   Honghong and Yu, Yong},
Title = {CHARM: Cross-modal hierarchical attention for recognizing malicious
   memes},
Journal = {NEUROCOMPUTING},
Year = {2026},
Volume = {664},
Month = {FEB 1},
Abstract = {Malicious memes have emerged as a critical threat to online safety,
   exploiting internet virality to propagate harmful content while evading
   traditional content moderation through sophisticated visual-textual
   interactions. Current multimodal approaches struggle to detect implicit
   harmful meanings that emerge when seemingly benign components
   deliberately combine through irony, cultural references, and semantic
   inversions. We propose CHARM (Cross-modal Hierarchical Attention for
   Recognizing Malicious Memes), a novel framework that introduces
   hierarchical attention mechanisms specifically designed for multimodal
   meme understanding. Our Hierarchical Channel-Spatial Attention (HCSA)
   performs progressive feature refinement through interconnected
   stages-from Local Channel Interaction capturing fine-grained
   dependencies, through Global Channel Recalibration for adaptive feature
   weighting, to Energy-based Spatial Refinement highlighting
   discriminative patterns-creating a comprehensive visual analysis
   pipeline from local details to global semantic structures. Complementing
   this, our Cross-Modal Guidance (CMG) mechanism enables dynamic
   bidirectional information exchange between modalities, effectively
   detecting subtle semantic inversions where visual elements fundamentally
   alter textual meanings. CHARM achieves state-of-the-art (SOTA) AUC
   scores of 84.24 \% on PrideMM, 91.17 \% on HarMeme, and 85.84 \% on MAMI
   while maintaining exceptional efficiency with only 6.4 M trainable
   parameters. The framework proves particularly effective in identifying
   implicit harmful content that conventional approaches miss, providing a
   practical solution for real-world content moderation systems.},
