Title = {4WHContext: A Context Based Hate Speech Detection Framework from Social
   Media Posts},
Booktitle = {ADVANCES IN SOCIAL NETWORKS ANALYSIS AND MINING, ASONAM 2024 VOL 1},
Series = {Lecture Notes in Social Networks},
