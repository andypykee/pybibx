	author = {Zeng, Jingjie and Yang, Liang and Wang, Zekun and Sun, Yuanyuan and Lin, Hongfei},
	title = {Sheep's Skin, Wolf's Deeds: Are LLMs Ready for Metaphorical Implicit Hate Speech?},
