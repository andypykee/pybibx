   Usman, Muhammad; Ahmad, Muhammad; Sidorov, Grigori; Gelbukh, Irina; Tellez, Rolando Quintero, Inst Politecn Nacl CIC IPN, Ctr Invest Comp, Mexico City 07320, Mexico.},
DOI = {10.3390/computers14070279},
