@ARTICLE{Najar2021351,
	author = {Najar, Fatma and Bouguila, Nizar},
	title = {Sparse Document Analysis Using Beta-Liouville Naive Bayes with Vocabulary Knowledge},
	year = {2021},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {12822 LNCS},
	pages = {351 - 363},
	doi = {10.1007/978-3-030-86331-9_23},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85115312503&doi=10.1007%2F978-3-030-86331-9_23&partnerID=40&md5=0de54187f9ae8ae8d9a0adfa214973f2},
	affiliations = {Concordia Institute for Information Systems Engineering, Montreal, QC, Canada},
	abstract = {Smoothing the parameters of multinomial distributions is an important concern in statistical inference tasks. In this paper, we present a new smoothing prior for the Multinomial Naive Bayes classifier. Our approach takes advantage of the Beta-Liouville distribution for the estimation of the multinomial parameters. Dealing with sparse documents, we exploit vocabulary knowledge to define two distinct priors over the “observed” and the “unseen” words. We analyze the problem of large-scale and sparse data by enhancing Multinomial Naive Bayes classifier through smoothing the estimation of words with a Beta-scale. Our approach is evaluated on two different challenging applications with sparse and large-scale documents namely: emotion intensity analysis and hate speech detection. Experiments on real-world datasets show the effectiveness of our proposed classifier compared to the related-work methods. © 2021, Springer Nature Switzerland AG.},
	author_keywords = {Beta-Liouville distribution; Document analysis; Multinomial Naive Bayes; Sparse data; Text recognition},
	keywords = {Character recognition; Classifiers; Beta-liouville distribution; Documents analysis; Liouville; Multinomial distributions; Multinomial naive bayes; Multinomials; Naive bayes; Sparse data; Statistical inference; Text recognition; Classification (of information)},
	correspondence_address = {F. Najar; Concordia Institute for Information and Systems Engineering (CIISE), Concordia University, Montreal, Canada; email: fatma.najar@concordia.ca},
	editor = {Lladós, J. and Lopresti, D. and Uchida, S.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {03029743},
	isbn = {9789819698936; 9789819698042; 9789819698110; 9789819698905; 9783032004949; 9789819512324; 9783032026019; 9783032008909; 9783031915802; 9789819698141},
	language = {English},
