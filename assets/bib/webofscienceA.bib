Language = {English},
Affiliation = {Xu, H (Corresponding Author), Jilin Univ, Coll Comp Sci \& Technol, Changchun 130012, Peoples R China.
   Song, Rui; Giunchiglia, Fausto; Xu, Hao, Jilin Univ, Sch Artificial Intelligence, Changchun 130012, Peoples R China.
