@article{ WOS:001626465900041,
Author = {Ren, Guoxiang and Chandra, Rohitash},
Title = {Analysis of IMDb Movie Reviews and Ratings Using a Language Model
   Framework},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {192655-192673},
Abstract = {Over the past few decades, IMDb (Internet Movie Database) has become
   prominent internationally for rating and user-generated reviews of
   movies. However, there has not been much research that evaluates the
   quality of user-generated reviews and their associated ratings. In this
   study, we present a comprehensive deep learning-based framework that
   integrates movie rating prediction, abuse detection, sentiment analysis,
   and aspect extraction to analyse IMDb movie reviews across different
   rating tiers. We extracted and curated 137,886 reviews from 8,582 movies
   and employed pre-trained GloVe embeddings to obtain word vectors for
   high-frequency vocabulary, facilitating an in-depth examination of how
   linguistic features vary across ratings. Our findings indicate that
   higher-rated reviews predominantly express positive sentiment, whereas
   lower-rated reviews exhibit a higher prevalence of abusive language. We
   further examine cross-cultural differences among reviewers of different
   nationalities writing in English, revealing variations in sentiment
   intensity and expression. Using a language model framework, we offer
   insights into how cultural context shapes English-language movie
   reviews. Our results show that even high-rated reviews can exhibit
   strong abusive language, while low-rated reviews can contain positive
   sentiments. Across all rating levels, re-watchability consistently
   emerges as a central theme, highlighting the nuanced and complex nature
   of user-generated movie reviews.},
