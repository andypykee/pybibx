@inproceedings{ WOS:000519076200031,
Author = {Parmentier, Alexandre and Cohen, Robin},
Editor = {Barnaghi, P and Gottlob, G and Manolopoulos, Y and Tzouramanis, T and Vakali, A},
Title = {Learning User Reputation on Reddit},
