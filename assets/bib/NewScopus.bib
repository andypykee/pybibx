	title = {HausaHate: An Expert Annotated Corpus for Hausa Hate Speech Detection},
	year = {2024},
	journal = {NAACL 2024 - 8th Workshop on Online Abuse and Harms, WOAH 2024, Proceedings of the Workshop},
	pages = {52 - 58},
	doi = {10.18653/v1/2024.woah-1.5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001855966&doi=10.18653%2Fv1%2F2024.woah-1.5&partnerID=40&md5=4f1ccd5e9ca4a170c80ab91e65b29ba4},
	affiliations = {Universidade de São Paulo, Sao Paulo, SP, Brazil; Universidade Federal de Minas Gerais, Belo Horizonte, MG, Brazil; Imperial College London, London, United Kingdom; Universität des Saarlandes, Saarbrucken, Saarland, Germany; Northeastern University, Boston, MA, United States; University of Pretoria, Pretoria, Gauteng, South Africa; University of Saint Thomas Aquinas, Saint Thomas, Burkina Faso},
	abstract = {We introduce the first expert annotated corpus of Facebook comments for Hausa hate speech detection. The corpus titled HausaHate<sup>1</sup> comprises 2,000 comments extracted from Western African Facebook pages and manually annotated by three Hausa native speakers, who are also NLP experts. Our corpus was annotated using two different layers. We first labeled each comment according to a binary classification: offensive versus non-offensive. Then, offensive comments were also labeled according to hate speech targets: race, gender and none. Lastly, a baseline model using fine-tuned LLM for Hausa hate speech detection is presented, highlighting the challenges of hate speech detection tasks for indigenous languages in Africa, as well as future advances. © 2024 Association for Computational Linguistics.},
