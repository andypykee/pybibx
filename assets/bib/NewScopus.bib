	pages = {},
	doi = {10.1109/AICCSA47632.2019.9035228},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85082727526&doi=10.1109%2FAICCSA47632.2019.9035228&partnerID=40&md5=3aa0bdfaea693ca20ef23b72361c66ec},
