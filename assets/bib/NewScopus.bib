	language = {English},
	abbrev_source_title = {ACL-IJCNLP - Annu. Meet. Assoc. Comput. Linguist. Int. Jt. Conf. Nat. Lang. Process., Proc. Conf.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 187; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access}
}

