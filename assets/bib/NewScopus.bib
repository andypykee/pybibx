@CONFERENCE{Bulla20238256,
	author = {Bulla, Luana and Gangemi, Aldo and Mongiovì, Misael},
	title = {Towards Distribution-shift Robust Text Classification of Emotional Content},
	year = {2023},
	journal = {Proceedings of the Annual Meeting of the Association for Computational Linguistics},
	pages = {8256 - 8268},
	doi = {10.18653/v1/2023.findings-acl.524},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85175449056&doi=10.18653%2Fv1%2F2023.findings-acl.524&partnerID=40&md5=d15c86690c557acac43bcb6baadefafe},
	affiliations = {Consiglio Nazionale delle Ricerche, Institute of Cognitive Science and Technology, Rome, RM, Italy; Alma Mater Studiorum Università di Bologna, Bologna, BO, Italy},
	abstract = {Supervised models based on Transformers have been shown to achieve impressive performances in many natural language processing tasks. However, besides requiring a large amount of costly manually annotated data, supervised models tend to adapt to the characteristics of the training dataset, which are usually created ad-hoc and whose data distribution often differs from the one in real applications, showing significant performance degradation in real-world scenarios. We perform an extensive assessment of the out-of-distribution performances of supervised models for classification in the emotion and hate-speech detection tasks and show that NLI-based zero-shot models often outperform them, making task-specific annotation useless when the characteristics of final-user data are not known in advance. To benefit from both supervised and zero-shot approaches, we propose to fine-tune an NLI-based model on the task-specific dataset. The resulting model often outperforms all available supervised models both in distribution and out of distribution, with only a few thousand training samples. © 2023 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Large dataset; Natural language processing systems; Text processing; Zero-shot learning; Data distribution; Language processing; Large amounts; Model-based OPC; Natural languages; Performance; Performance degradation; Real applications; Text classification; Training dataset; Classification (of information)},
	publisher = {Association for Computational Linguistics (ACL)},
