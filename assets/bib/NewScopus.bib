@CONFERENCE{Ghosh2021249,
	author = {Ghosh, Sreyan and Kumar, Sonal},
	title = {Cisco at SemEval-2021 Task 5: What’s Toxic?: Leveraging Transformers for Multiple Toxic Span Extraction from Online Comments},
	year = {2021},
	journal = {SemEval 2021 - 15th International Workshop on Semantic Evaluation, Proceedings of the Workshop},
	pages = {249 - 257},
	doi = {10.18653/v1/2021.semeval-1.29},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85138984784&doi=10.18653%2Fv1%2F2021.semeval-1.29&partnerID=40&md5=e173132fe315bb1fbdd54170abe11e1c},
	affiliations = {Cisco Systems, San Jose, CA, United States; Indraprastha Institute of Information Technology, Delhi, MIDAS Lab, New Delhi, India},
	abstract = {Social network platforms are generally used to share positive, constructive, and insightful content. However, in recent times, people often get exposed to objectionable content like threat, identity attacks, hate speech, insults, obscene texts, offensive remarks or bullying. Existing work on toxic speech detection focuses on binary classification or on differentiating toxic speech among a small set of categories. This paper describes the system proposed by team Cisco for SemEval-2021 Task 5: Toxic Spans Detection, the first shared task focusing on detecting the spans in the text that attribute to its toxicity, in English language. We approach this problem primarily in two ways: a sequence tagging approach and a dependency parsing approach. In our sequence tagging approach we tag each token in a sentence under a particular tagging scheme. Our best performing architecture in this approach also proved to be our best performing architecture overall with an F<inf>1</inf> score of 0.6922, thereby placing us 7<sup>th</sup> on the final evaluation phase leader-board. We also explore a dependency parsing approach where we extract spans from the input sentence under the supervision of target span boundaries and rank our spans using a biaffine model. Finally, we also provide a detailed analysis of our results and model performance in our paper. © 2021 Association for Computational Linguistics.},
	keywords = {Network architecture; Speech recognition; Binary classification; Dependency parsing; English languages; Evaluation phase; Exposed to; Modeling performance; Network platforms; Speech detection; Two ways; Syntactics},
	editor = {Palmer, A. and Schneider, N. and Schluter, N. and Emerson, G. and Herbelot, A. and Zhu, X.},
	publisher = {Association for Computational Linguistics (ACL)},
	isbn = {9781954085701},
	language = {English},
	abbrev_source_title = {SemEval - Int. Workshop Semant. Eval., Proc. Workshop},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access}
}

