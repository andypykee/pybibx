	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85206071049&doi=10.1109%2FICISC62624.2024.00042&partnerID=40&md5=17e5ab5a8232beaea99daeb2eb1c2250},
	affiliations = {Vignans Foundation for Science Technology and Research University, Department of Computer Science and Engineering, Guntur, AP, India},
	abstract = {The internet has led to a significant increase in the amount of information available, which has resulted in the rise of online communication among users. Unfortunately, this has also resulted in the proliferation of toxic online texts, which can lead to bullying, harassment, and personal attacks. While there have been attempts to develop efficient models for predicting toxic comments online, the field is still in its nascent stage, hence new frameworks and strategies are needed to address this issue. Convolutional Neural Networks (CNNs) are a promising solution for text classification due to recent advancements in hardware and big data management. Additionally, the increasing amount of data available necessitates the development of novel machine learning tools for managing this information. This study compares CNNs with the traditional bag-of-words approach as well as more efficient methods for text classification. The results demonstrate that CNNs outperform the conventional method in classifying harmful comments, indicating the approach's potential for further research in this field. This work highlights the importance of developing innovative strategies to combat online toxicity and provides insight into how deep learning techniques can be used for text classification. © 2024 IEEE.},
	author_keywords = {CNN; Deep Learning; Text Mining; Toxic Text Classification; Toxicity Detection},
	keywords = {Contrastive Learning; Convolutional neural networks; Deep learning; Information management; Amount of information; Convolutional neural network; Machine learning approaches; Offensive languages; Text classification; Text-mining; Toxic text classification; Toxicity detection; Word languages; Adversarial machine learning},
	correspondence_address = {K. Sugandhi; Vignan University, Vignan Foundation for Science, Technology and Research (VFSTR), Department of Computer Science&Engineering, Guntur, Andhra Pradesh, India; email: sugandhikgs@gmail.com},
